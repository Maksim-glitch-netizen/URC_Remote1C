
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбновитьНастройкиНаСервере();
КонецПроцедуры

// 2026.10.11 - Начальные значения режима и таймаута нового соединения.
&НаКлиенте
Процедура УзлыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если Не НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	СтрокаСоединения = Элемент.ТекущиеДанные;
	Если СтрокаСоединения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не Копирование Или ПустаяСтрока(СтрокаСоединения.РежимСериализации) Тогда
		СтрокаСоединения.РежимСериализации = "portable";
	КонецЕсли;
	Если Не Копирование Или СтрокаСоединения.ТаймаутHTTP <= 0 Тогда
		СтрокаСоединения.ТаймаутHTTP = 60;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьНастройкиОбработка(Команда)
	Результат = СохранитьНастройкиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНастройкиОбработка(Команда)
	ОбновитьНастройкиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСоединениеОбработка(Команда)
	ТекущиеДанные = Элементы.Узлы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Результат = НСтр("ru = 'Выберите соединение'; en = 'Select a connection'");
		Возврат;
	КонецЕсли;
	Результат = ПроверитьСоединениеНаСервере(ТекущиеДанные.ConnectionCode);
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьВозможностиОбработка(Команда)
	ТекущиеДанные = Элементы.Узлы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Результат = НСтр("ru = 'Выберите соединение'; en = 'Select a connection'");
		Возврат;
	КонецЕсли;
	Результат = ПолучитьВозможностиНаСервере(ТекущиеДанные.ConnectionCode);
КонецПроцедуры

&НаКлиенте
Процедура ЭкспортироватьНастройкиОбработка(Команда)
	ТекстИмпортаЭкспорта = ЭкспортироватьНастройкиНаСервере();
	Результат = НСтр("ru = 'Настройки экспортированы без секретов'; en = 'Settings were exported without secrets'");
КонецПроцедуры

&НаКлиенте
Процедура ИмпортироватьНастройкиОбработка(Команда)
	РезультатИмпорта = ИмпортироватьНастройкиНаСервере(ТекстИмпортаЭкспорта);
	ОбновитьНастройкиНаСервере();
	Результат = РезультатИмпорта;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьУзелОбработка(Команда)
	ТекущиеДанные = Элементы.Узлы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Результат = НСтр("ru = 'Выберите соединение'; en = 'Select a connection'");
		Возврат;
	КонецЕсли;
	УдалитьУзелНаСервере(ТекущиеДанные.ConnectionCode);
	ОбновитьНастройкиНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьНастройкиНаСервере()
	ТаблицаУзлов = НоваяТаблицаУзлов();
	Для Каждого ЭлементУзла Из URC_Настройки.ПолучитьВсеСоединения() Цикл
		Узел = ЭлементУзла.Значение;
		СтрокаУзла = ТаблицаУзлов.Добавить();
		СтрокаУзла.ConnectionCode = ЭлементУзла.Ключ;
		ЗаполнитьЗначенияСвойств(СтрокаУзла, Узел);
	КонецЦикла;
	ЗначениеВДанныеФормы(ТаблицаУзлов, Узлы);
	ЛокальныеНастройки = URC_Настройки.ПолучитьЛокальныеНастройки();
	ЛокальныеНастройки.Свойство("КодУзла", КодЛокальногоУзла);
	НастройкиБезопасности = URC_Настройки.ПолучитьНастройкиБезопасности();
	НастройкиБезопасности.Свойство("РазрешитьRemote1C", РазрешитьRemote1C);
	// Именованные удалённые процедуры по ТЗ v2.
	НастройкиБезопасности.Свойство("AllowProcedureExecute", РазрешитьВыполнениеПроцедур);
	ЗначениеВДанныеФормы(URC_Настройки.ПолучитьХранимыеПроцедуры(), ИменованныеПроцедуры);
	НастройкиБезопасности.Свойство("AllowObjectWrite", РазрешитьЗаписьОбъектов);
	НастройкиБезопасности.Свойство("ObjectWriteStrictMode", СтрогийРежимЗаписи);
	НастройкаРазрешенныхМетаданных = Неопределено;
	НастройкиБезопасности.Свойство(
		"ObjectWriteAllowedMetadata", НастройкаРазрешенныхМетаданных);
	РазрешенныеМетаданныеЗаписи = ПредставлениеСпискаМетаданных(
		НастройкаРазрешенныхМетаданных);
	Результат = НСтр("ru = 'Настройки загружены'; en = 'Settings loaded'");
КонецПроцедуры

&НаСервере
Функция СохранитьНастройкиНаСервере()
	// Именованные удалённые процедуры по ТЗ v2.
	ТаблицаПроцедур = ДанныеФормыВЗначение(ИменованныеПроцедуры, Тип("ТаблицаЗначений"));
	URC_УдаленныеПроцедуры.ПроверитьРеестр(ТаблицаПроцедур);
	ТаблицаУзлов = ДанныеФормыВЗначение(Узлы, Тип("ТаблицаЗначений"));
	СоответствиеУзлов = Новый Соответствие;
	Для Каждого СтрокаУзла Из ТаблицаУзлов Цикл
		Если ПустаяСтрока(СокрЛП(СтрокаУзла.ConnectionCode)) Тогда
			Продолжить;
		КонецЕсли;
		Узел = URC_Настройки.НоваяНастройкаСоединения();
		ЗаполнитьЗначенияСвойств(Узел, СтрокаУзла);
		СоответствиеУзлов.Вставить(СокрЛП(СтрокаУзла.ConnectionCode), Узел);
	КонецЦикла;
	URC_Настройки.СохранитьВсеСоединения(СоответствиеУзлов);
	URC_Настройки.СохранитьЛокальныеНастройки(
		Новый Структура("КодУзла", КодЛокальногоУзла));
	URC_Настройки.СохранитьНастройкиБезопасности(
		Новый Структура(
			"РазрешитьRemote1C,AllowObjectWrite,ObjectWriteStrictMode,ObjectWriteAllowedMetadata,AllowProcedureExecute",
			РазрешитьRemote1C,
			РазрешитьЗаписьОбъектов,
			СтрогийРежимЗаписи,
			РазрешенныеМетаданныеЗаписи, РазрешитьВыполнениеПроцедур));
	URC_Настройки.СохранитьХранимыеПроцедуры(ТаблицаПроцедур);
	Возврат НСтр("ru = 'Настройки сохранены'; en = 'Settings saved'");
КонецФункции

&НаСервере
Функция ПолучитьВозможностиНаСервере(Знач КодУзла)
	Попытка
		Возврат URC_СериализацияXDTO.СериализоватьВJSON(
			URC_Клиент.ПолучитьВозможности(КодУзла));
	Исключение
		ЗаписьЖурналаРегистрации(
			"Remote1C.Settings.Test.Error", УровеньЖурналаРегистрации.Ошибка, , ,
			"Operation=Capabilities; Node=" + КодУзла);
		Возврат ОписаниеОшибки();
	КонецПопытки;
КонецФункции

&НаСервере
Функция ЭкспортироватьНастройкиНаСервере()
	Возврат URC_СериализацияXDTO.СериализоватьВJSON(
		URC_Настройки.ЭкспортироватьСоединенияБезСекретов());
КонецФункции

&НаСервере
Функция ИмпортироватьНастройкиНаСервере(Знач ТекстИмпорта)
	ДанныеИмпорта = URC_СериализацияXDTO.ДесериализоватьИзJSON(ТекстИмпорта);
	URC_Настройки.ИмпортироватьСоединенияБезСекретов(ДанныеИмпорта);
	Возврат НСтр("ru = 'Настройки импортированы; существующие секреты сохранены'; en = 'Settings were imported; existing secrets were preserved'");
КонецФункции

&НаСервере
Функция ПроверитьСоединениеНаСервере(Знач КодУзла)
	Попытка
		Возврат URC_СериализацияXDTO.СериализоватьВJSON(URC_Клиент.Ping(КодУзла));
	Исключение
		ЗаписьЖурналаРегистрации(
			"Remote1C.Settings.Test.Error", УровеньЖурналаРегистрации.Ошибка, , ,
			"Node=" + КодУзла);
		Возврат ОписаниеОшибки();
	КонецПопытки;
КонецФункции

&НаСервере
Процедура УдалитьУзелНаСервере(Знач КодУзла)
	URC_Настройки.УдалитьУзел(КодУзла);
КонецПроцедуры

&НаСервереБезКонтекста
Функция НоваяТаблицаУзлов()
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ConnectionCode");
	Таблица.Колонки.Добавить("Node");
	Таблица.Колонки.Добавить("Наименование");
	Таблица.Колонки.Добавить("БазовыйURL");
	Таблица.Колонки.Добавить("Активен");
	Таблица.Колонки.Добавить("РежимСериализации");
	Таблица.Колонки.Добавить("ТаймаутHTTP");
	Таблица.Колонки.Добавить("Пользователь");
	Таблица.Колонки.Добавить("Секрет");
	Возврат Таблица;
КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеСпискаМетаданных(СписокМетаданных)

	Если ТипЗнч(СписокМетаданных) = Тип("Строка") Тогда
		// 2026.10.11 - Единый формат списка типов в поле настроек.
		СтрокаСписка = СтрЗаменить(СписокМетаданных, Символы.ВК, "");
		Возврат СтрЗаменить(СтрокаСписка, Символы.ПС, "; ");
	КонецЕсли;
	Результат = Новый Массив;
	Если ТипЗнч(СписокМетаданных) = Тип("Массив")
		Или ТипЗнч(СписокМетаданных) = Тип("ФиксированныйМассив") Тогда
		Для Каждого ИмяМетаданных Из СписокМетаданных Цикл
			Результат.Добавить(Строка(ИмяМетаданных));
		КонецЦикла;
	ИначеЕсли ТипЗнч(СписокМетаданных) = Тип("Соответствие") Тогда
		Для Каждого Элемент Из СписокМетаданных Цикл
			Если Элемент.Значение = Истина Тогда
				Результат.Добавить(Строка(Элемент.Ключ));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат СтрСоединить(Результат, "; ");

КонецФункции

#КонецОбласти
