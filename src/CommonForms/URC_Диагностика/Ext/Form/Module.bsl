
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТекстЗапроса = "ВЫБРАТЬ 1 КАК Значение";
	Результат = НСтр("ru = 'Выберите узел или выполните самопроверку XDTO'; en = 'Select a node or run XDTO self-test'");
КонецПроцедуры

// Именованные удалённые процедуры по ТЗ v2.
&НаКлиенте
Процедура ПолучитьПроцедурыОбработка(Команда)
	ПолучитьПроцедурыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПолучитьПроцедурыНаСервере()
	ПубличныеПроцедуры.Очистить();
	Попытка
		Список = URC_Клиент.ПолучитьПроцедуры(ConnectionCode);
		Для Каждого ЗаписьСписка Из Список Цикл
			ЗаполнитьЗначенияСвойств(ПубличныеПроцедуры.Добавить(), ЗаписьСписка);
		КонецЦикла;
		Результат = НСтр("ru = 'Список процедур получен'; en = 'Procedure list received'");
	Исключение
		Результат = ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьPingОбработка(Команда)
	ДанныеВызова = ВыполнитьPingНаСервере(ConnectionCode);
	Результат = ДанныеВызова.Результат;
	ФактическийNode = ДанныеВызова.ServerNode;
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьВозможностиОбработка(Команда)
	ДанныеВызова = ПолучитьВозможностиНаСервере(ConnectionCode);
	Результат = ДанныеВызова.Результат;
	ФактическийNode = ДанныеВызова.ServerNode;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗапросОбработка(Команда)
	ДанныеВызова = ВыполнитьЗапросНаСервере(ConnectionCode, ТекстЗапроса);
	Результат = ДанныеВызова.Результат;
	RequestId = ДанныеВызова.RequestId;
	КоличествоСтрок = ДанныеВызова.КоличествоСтрок;
	ДлительностьМС = ДанныеВызова.ДлительностьМС;
	QueryMs = ДанныеВызова.QueryMs;
	AttributesMs = ДанныеВызова.AttributesMs;
	NormalizeMs = ДанныеВызова.NormalizeMs;
	XDTOMs = ДанныеВызова.XDTOMs;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьXDTOОбработка(Команда)
	Результат = ПроверитьXDTOНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЖурналРегистрацииОбработка(Команда)
	Если Не ФормаЖурналаРегистрацииДоступна() Тогда
		Результат = НСтр(
			"ru = 'В этой конфигурации стандартная форма журнала регистрации недоступна. Откройте журнал из раздела Администрирование и задайте фильтр Remote1C.*'; en = 'The standard event log form is unavailable in this configuration. Open it from Administration and set the Remote1C.* filter'");
		Возврат;
	КонецЕсли;
	ОткрытьФорму("ОбщаяФорма.ЖурналРегистрации", , ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ВыполнитьPingНаСервере(Знач ConnectionCode)
	Попытка
		Ответ = URC_Клиент.Ping(ConnectionCode);
		Возврат Новый Структура(
			"Результат,ServerNode",
			URC_СериализацияXDTO.СериализоватьВJSON(Ответ),
			Ответ.ServerNode);
	Исключение
		ЗаписьЖурналаРегистрации(
			"Remote1C.Diagnostics.Error", УровеньЖурналаРегистрации.Ошибка, , ,
			"Operation=Ping; Node=" + ConnectionCode);
		Возврат Новый Структура("Результат,ServerNode", ОписаниеОшибки(), "");
	КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВозможностиНаСервере(Знач ConnectionCode)
	Попытка
		Ответ = URC_Клиент.ПолучитьВозможности(ConnectionCode);
		Возврат Новый Структура(
			"Результат,ServerNode",
			URC_СериализацияXDTO.СериализоватьВJSON(Ответ),
			Ответ.ServerNode);
	Исключение
		ЗаписьЖурналаРегистрации(
			"Remote1C.Diagnostics.Error", УровеньЖурналаРегистрации.Ошибка, , ,
			"Operation=Capabilities; Node=" + ConnectionCode);
		Возврат Новый Структура("Результат,ServerNode", ОписаниеОшибки(), "");
	КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьЗапросНаСервере(Знач ConnectionCode, Знач ТекстЗапроса)
	Попытка
		Ответ = URC_Клиент.ВыполнитьЗапросРасширенно(ConnectionCode, ТекстЗапроса);
		JSON = URC_СериализацияXDTO.СериализоватьВJSON(Ответ.Данные);
		Возврат Новый Структура(
			"Результат,RequestId,КоличествоСтрок,ДлительностьМС,QueryMs,AttributesMs,NormalizeMs,XDTOMs",
			JSON, Строка(Ответ.RequestId), Ответ.КоличествоСтрок, Ответ.ДлительностьМС,
			Ответ.QueryMs, Ответ.AttributesMs, Ответ.NormalizeMs, Ответ.XDTOMs);
	Исключение
		ЗаписьЖурналаРегистрации(
			"Remote1C.Diagnostics.Error", УровеньЖурналаРегистрации.Ошибка, , ,
			"Operation=Query; Node=" + ConnectionCode);
		Возврат Новый Структура(
			"Результат,RequestId,КоличествоСтрок,ДлительностьМС,QueryMs,AttributesMs,NormalizeMs,XDTOMs",
			ОписаниеОшибки(), "", 0, 0, 0, 0, 0, 0);
	КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьXDTOНаСервере()
	Если URC_СериализацияXDTO.Самопроверка() Тогда
		Возврат НСтр("ru = 'Самопроверка XDTO JSON выполнена успешно'; en = 'XDTO JSON self-test completed successfully'");
	КонецЕсли;
	Возврат НСтр("ru = 'Самопроверка XDTO JSON не пройдена'; en = 'XDTO JSON self-test failed'");
КонецФункции

&НаСервереБезКонтекста
Функция ФормаЖурналаРегистрацииДоступна()
	Возврат Метаданные.ОбщиеФормы.Найти("ЖурналРегистрации") <> Неопределено;
КонецФункции

#КонецОбласти
