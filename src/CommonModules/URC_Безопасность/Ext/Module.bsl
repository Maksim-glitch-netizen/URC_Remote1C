
#Область ПрограммныйИнтерфейс

Функция ПроверитьУдаленныйДоступ() Экспорт

	Настройки = URC_Настройки.ПолучитьНастройкиБезопасности();
	Разрешен = Ложь;
	Если Не Настройки.Свойство("РазрешитьRemote1C", Разрешен) Или Не Разрешен Тогда
		ВызватьИсключение "REMOTE_ACCESS_DISABLED|"
			+ НСтр("ru = 'Удаленный доступ Remote1C выключен'; en = 'Remote1C access is disabled'");
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ПроверитьТранспортныйЗапрос(ТранспортныйЗапрос, RequestId = Неопределено) Экспорт

	Если ТипЗнч(ТранспортныйЗапрос) <> Тип("Структура") Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Корневое значение запроса должно иметь тип Структура'; en = 'Request root must be a Structure'");
	КонецЕсли;

	Если Не ТранспортныйЗапрос.Свойство("RequestId", RequestId) Тогда
		ВызватьИсключение "BAD_REQUEST|RequestId";
	КонецЕсли;

	Если ТипЗнч(RequestId) = Тип("Строка") Тогда
		Попытка
			RequestId = Новый УникальныйИдентификатор(RequestId);
		Исключение
			ВызватьИсключение "BAD_REQUEST|RequestId UUID";
		КонецПопытки;
	ИначеЕсли ТипЗнч(RequestId) <> Тип("УникальныйИдентификатор") Тогда
		ВызватьИсключение "BAD_REQUEST|RequestId UUID";
	КонецЕсли;

	Протокол = Неопределено;
	Если Не ТранспортныйЗапрос.Свойство("Protocol", Протокол)
		Или Не URC_Протокол.ВерсияПротоколаСовместима(Протокол) Тогда
		ВызватьИсключение "PROTOCOL_MISMATCH|"
			+ НСтр("ru = 'Несовместимая версия протокола'; en = 'Protocol version mismatch'");
	КонецЕсли;

	Возврат RequestId;

КонецФункции

Процедура ПроверитьЗаписьОбъекта(ИмяМетаданных) Экспорт

	ПроверитьУдаленныйДоступ();
	Если ТипЗнч(ИмяМетаданных) <> Тип("Строка")
		Или ПустаяСтрока(СокрЛП(ИмяМетаданных)) Тогда
		ВызватьИсключение "REMOTE_OBJECT_INVALID|"
			+ НСтр("ru = 'Не заполнено имя метаданных объекта'; en = 'Object metadata name is missing'");
	КонецЕсли;

	Настройки = URC_Настройки.ПолучитьНастройкиБезопасности();
	РазрешитьЗапись = Ложь;
	Если Не Настройки.Свойство("AllowObjectWrite", РазрешитьЗапись)
		Или Не РазрешитьЗапись Тогда
		ВызватьИсключение "OBJECT_WRITE_DISABLED|"
			+ НСтр("ru = 'Запись объектов Remote1C выключена'; en = 'Remote1C object write is disabled'");
	КонецЕсли;

	СтрогийРежим = Истина;
	Настройки.Свойство("ObjectWriteStrictMode", СтрогийРежим);
	Если Не СтрогийРежим Тогда
		Возврат;
	КонецЕсли;

	РазрешенныеМетаданные = Неопределено;
	Настройки.Свойство("ObjectWriteAllowedMetadata", РазрешенныеМетаданные);
	Если Не МетаданныеРазрешены(ИмяМетаданных, РазрешенныеМетаданные) Тогда
		ВызватьИсключение "OBJECT_WRITE_FORBIDDEN|"
			+ НСтр("ru = 'Тип объекта не разрешен политикой записи Remote1C'; en = 'Object type is not allowed by the Remote1C write policy'")
			+ ": " + ИмяМетаданных;
	КонецЕсли;

КонецПроцедуры

Функция ПроверитьContentTypeJSON(HTTPЗапрос) Экспорт

	ContentType = HTTPЗапрос.Заголовки.Получить("Content-Type");
	Если ContentType = Неопределено
		Или СтрНайти(НРег(Строка(ContentType)), "application/json") = 0 Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Ожидается Content-Type application/json'; en = 'Content-Type application/json is required'");
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Именованные удалённые процедуры по ТЗ v2.
Процедура ПроверитьВыполнениеПроцедур() Экспорт
	Настройки = URC_Настройки.ПолучитьНастройкиБезопасности();
	Если ТипЗнч(Настройки.AllowProcedureExecute) <> Тип("Булево") Или Не Настройки.AllowProcedureExecute Тогда
		ВызватьИсключение "PROCEDURE_EXECUTION_DISABLED|"
			+ НСтр("ru = 'Выполнение процедур запрещено'; en = 'Procedure execution is disabled'");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МетаданныеРазрешены(ИмяМетаданных, РазрешенныеМетаданные)

	Если ТипЗнч(РазрешенныеМетаданные) = Тип("Строка") Тогда
		СтрокаСписка = СтрЗаменить(РазрешенныеМетаданные, Символы.ВК, Символы.ПС);
		СтрокаСписка = СтрЗаменить(СтрокаСписка, ";", Символы.ПС);
		СтрокаСписка = СтрЗаменить(СтрокаСписка, ",", Символы.ПС);
		Для Каждого ЭлементСписка Из СтрРазделить(СтрокаСписка, Символы.ПС) Цикл
			Если СокрЛП(ЭлементСписка) = ИмяМетаданных Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(РазрешенныеМетаданные) = Тип("Массив")
		Или ТипЗнч(РазрешенныеМетаданные) = Тип("ФиксированныйМассив") Тогда
		Для Каждого ЭлементСписка Из РазрешенныеМетаданные Цикл
			Если СокрЛП(Строка(ЭлементСписка)) = ИмяМетаданных Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(РазрешенныеМетаданные) = Тип("Соответствие") Тогда
		Возврат РазрешенныеМетаданные.Получить(ИмяМетаданных) = Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

#КонецОбласти
