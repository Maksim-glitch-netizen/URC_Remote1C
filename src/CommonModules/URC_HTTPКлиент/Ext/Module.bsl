
#Область ПрограммныйИнтерфейс

Функция ОтправитьPOST(Узел, ОтносительныйПуть, ТелоJSON, Настройки = Неопределено) Экспорт
	Возврат ВыполнитьВызов(Узел, "POST", ОтносительныйПуть, ТелоJSON, Настройки);
КонецФункции

Функция ОтправитьGET(Узел, ОтносительныйПуть, Настройки = Неопределено) Экспорт
	Возврат ВыполнитьВызов(Узел, "GET", ОтносительныйПуть, Неопределено, Настройки);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьВызов(Узел, Метод, ОтносительныйПуть, ТелоJSON, Настройки)
	ПараметрыURL = РазобратьБазовыйURL(ЗначениеНастройки(Узел, "БазовыйURL", ""));
	Пользователь = Строка(ЗначениеНастройки(Узел, "Пользователь", ""));
	Секрет = Строка(ЗначениеНастройки(Узел, "Секрет", ""));
	Таймаут = Число(ЗначениеНастройки(Узел, "ТаймаутHTTP", 60));
	Если Таймаут <= 0 Тогда
		Таймаут = 60;
	КонецЕсли;
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Настройки.Свойство("Timeout", Таймаут);
	КонецЕсли;
	ЗащищенноеСоединение = Неопределено;
	Если ПараметрыURL.HTTPS Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	КонецЕсли;
	Соединение = Новый HTTPСоединение(
		ПараметрыURL.Хост, ПараметрыURL.Порт, Пользователь, Секрет, , Таймаут, ЗащищенноеСоединение);
	Путь = ПараметрыURL.Путь + "/hs/remote1c/v1/" + ОтносительныйПуть;
	Путь = СтрЗаменить(Путь, "//", "/");
	ЗапросHTTP = Новый HTTPЗапрос(Путь);
	ЗапросHTTP.Заголовки.Вставить("Accept", "application/json");
	Если Метод = "POST" Тогда
		ЗапросHTTP.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ЗапросHTTP.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		ОтветHTTP = Соединение.ВызватьHTTPМетод(Метод, ЗапросHTTP);
	Исключение
		Описание = ОписаниеОшибки();
		КодОшибки = ?(СтрНайти(НРег(Описание), "timeout") > 0
			Или СтрНайти(НРег(Описание), "таймаут") > 0, "TRANSPORT_TIMEOUT", "CONNECTION_ERROR");
		ВызватьИсключение КодОшибки + "|" + Описание;
	КонецПопытки;
	// Именованные удалённые процедуры по ТЗ v2.
	ЭтоПроцедуры = ОтносительныйПуть = URC_Протокол.ПутьВыполненияПроцедуры()
		Или ОтносительныйПуть = URC_Протокол.ПутьСпискаПроцедур();
	Если ОтветHTTP.КодСостояния = 401 Или (ОтветHTTP.КодСостояния = 403 И Не ЭтоПроцедуры) Тогда
		ВызватьИсключение "HTTP_AUTH_ERROR|HTTP " + Строка(ОтветHTTP.КодСостояния);
	КонецЕсли;
	ТелоОтвета = ОтветHTTP.ПолучитьТелоКакСтроку();
	Если ПустаяСтрока(ТелоОтвета) Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Удаленный узел вернул пустой ответ'; en = 'Remote node returned an empty response'");
	КонецЕсли;
	НачалоXDTO = ТекущаяУниверсальнаяДатаВМиллисекундах();
	// Различаем отказ аутентификации и штатный отказ выполнения процедуры.
	Если ЭтоПроцедуры И ОтветHTTP.КодСостояния = 403 Тогда
		Попытка
			ТранспортныйОтвет = URC_СериализацияXDTO.ДесериализоватьИзJSON(ТелоОтвета);
		Исключение
			ВызватьИсключение "HTTP_AUTH_ERROR|HTTP 403";
		КонецПопытки;
	Иначе
		ТранспортныйОтвет = URC_СериализацияXDTO.ДесериализоватьИзJSON(ТелоОтвета);
	КонецЕсли;
	XDTOMs = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоXDTO;
	Возврат Новый Структура(
		"Response,HTTPStatus,ElapsedMs,XDTOMs", ТранспортныйОтвет, ОтветHTTP.КодСостояния,
		ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало, XDTOMs);
КонецФункции

Функция РазобратьБазовыйURL(БазовыйURL)
	БазовыйURL = СокрЛП(Строка(БазовыйURL));
	HTTPS = Ложь;
	Если СтрНачинаетсяС(НРег(БазовыйURL), "https://") Тогда
		HTTPS = Истина;
		Остаток = Сред(БазовыйURL, 9);
	ИначеЕсли СтрНачинаетсяС(НРег(БазовыйURL), "http://") Тогда
		Остаток = Сред(БазовыйURL, 8);
	Иначе
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Базовый URL должен начинаться с http:// или https://'; en = 'Base URL must start with http:// or https://'");
	КонецЕсли;
	ПозицияПути = СтрНайти(Остаток, "/");
	Если ПозицияПути = 0 Тогда
		Адрес = Остаток;
		Путь = "";
	Иначе
		Адрес = Лев(Остаток, ПозицияПути - 1);
		Путь = Сред(Остаток, ПозицияПути);
		Если Прав(Путь, 1) = "/" Тогда
			Путь = Лев(Путь, СтрДлина(Путь) - 1);
		КонецЕсли;
	КонецЕсли;
	Порт = ?(HTTPS, 443, 80);
	ПозицияПорта = СтрНайти(Адрес, ":");
	Если ПозицияПорта > 0 Тогда
		Попытка
			Порт = Число(Сред(Адрес, ПозицияПорта + 1));
		Исключение
			ВызватьИсключение "BAD_REQUEST|"
				+ НСтр("ru = 'Некорректный порт в базовом URL'; en = 'Invalid port in base URL'");
		КонецПопытки;
		Хост = Лев(Адрес, ПозицияПорта - 1);
	Иначе
		Хост = Адрес;
	КонецЕсли;
	Если ПустаяСтрока(Хост) Тогда
		ВызватьИсключение "BAD_REQUEST|URL host";
	КонецЕсли;
	Если Порт < 1 Или Порт > 65535 Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Порт в базовом URL вне диапазона 1..65535'; en = 'Base URL port is outside 1..65535'");
	КонецЕсли;
	Возврат Новый Структура("Хост,Порт,Путь,HTTPS", Хост, Порт, Путь, HTTPS);
КонецФункции

Функция ЗначениеНастройки(Настройки, Имя, ПоУмолчанию)
	Значение = Неопределено;
	Если ТипЗнч(Настройки) = Тип("Структура") И Настройки.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

#КонецОбласти
