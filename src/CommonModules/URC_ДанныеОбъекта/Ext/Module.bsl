
#Область ПрограммныйИнтерфейс

Функция Получить(УдаленнаяСсылка, Настройки, РежимСериализации, КодТекущегоУзла) Экспорт

	НачалоОперации = ТекущаяУниверсальнаяДатаВМиллисекундах();
	NormalizeMs = 0;

	Если Не URC_ПортативныеТипы.ЭтоУдаленнаяСсылка(УдаленнаяСсылка) Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Reference должен быть RemoteReference'; en = 'Reference must be a RemoteReference'");
	КонецЕсли;

	ЛокальнаяСсылка = URC_ПортативныеТипы.ВосстановитьRemoteReference(УдаленнаяСсылка, КодТекущегоУзла);
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(УдаленнаяСсылка.Metadata);

	Если Не ЭтоПоддерживаемыйТипДанныхОбъекта(ОбъектМетаданных) Тогда
		ВызватьИсключение "OBJECT_DATA_UNSUPPORTED|"
			+ НСтр("ru = 'Тип RemoteReference не поддерживает получение данных объекта'; en = 'RemoteReference type does not support object data retrieval'")
			+ ": " + УдаленнаяСсылка.Metadata;
	КонецЕсли;

	ИменаРеквизитов = Неопределено;
	ЗапросТабличныеЧасти = Неопределено;
	Если Настройки <> Неопределено Тогда
		Если ТипЗнч(Настройки) <> Тип("Структура") И ТипЗнч(Настройки) <> Тип("ФиксированнаяСтруктура") Тогда
			ВызватьИсключение "BAD_REQUEST|"
				+ НСтр("ru = 'Settings должен иметь тип Структура'; en = 'Settings must be a Structure'");
		КонецЕсли;
		Настройки.Свойство("Attributes", ИменаРеквизитов);
		Настройки.Свойство("TabularSections", ЗапросТабличныеЧасти);
	КонецЕсли;

	Попытка
		Объект = ЛокальнаяСсылка.ПолучитьОбъект();
	Исключение
		ВызватьИсключение "OBJECT_DATA_READ_ERROR|"
			+ НСтр("ru = 'Не удалось прочитать объект'; en = 'Failed to read object'")
			+ ": " + ОписаниеОшибки();
	КонецПопытки;
	ВерсияДанных = URC_Реквизиты.ВерсияДанныхОбъекта(Объект);

	ДоступныеРеквизиты = URC_Реквизиты.ПолучитьДоступныеРеквизиты(ОбъектМетаданных);
	ЗапрошенныеРеквизиты = URC_Реквизиты.РазобратьИменаРеквизитов(ИменаРеквизитов, ДоступныеРеквизиты);

	СтруктураРеквизитов = Новый Структура;
	Для Каждого ИмяРеквизита Из ЗапрошенныеРеквизиты Цикл

		Если ИмяРеквизита = "Ссылка" Тогда
			Продолжить;
		КонецЕсли;

		Если URC_Реквизиты.ЭтоРеквизитХранилищеЗначения(
			ОбъектМетаданных, ИмяРеквизита) Тогда
			СтруктураРеквизитов.Вставить(
				ИмяРеквизита,
				URC_ПортативныеТипы.СоздатьRemoteValueStorage(
					УдаленнаяСсылка,
					ИмяРеквизита,
					КодТекущегоУзла,
					ОбъектМетаданных));
			Продолжить;
		КонецЕсли;

		Попытка
			ЗначениеРеквизита = Объект[ИмяРеквизита];
		Исключение
			ВызватьИсключение "OBJECT_DATA_READ_ERROR|"
				+ НСтр("ru = 'Ошибка чтения реквизита'; en = 'Attribute read error'")
				+ " " + ИмяРеквизита + ": " + ОписаниеОшибки();
		КонецПопытки;

		Если РежимСериализации = URC_Протокол.РежимPortable() Тогда
			НачалоНормализации = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ЗначениеРеквизита = URC_ПортативныеТипы.НормализоватьЗначение(ЗначениеРеквизита, КодТекущегоУзла);
			NormalizeMs = NormalizeMs
				+ ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоНормализации;
		КонецЕсли;

		СтруктураРеквизитов.Вставить(ИмяРеквизита, ЗначениеРеквизита);

	КонецЦикла;

	СтруктураТабличныхЧастей = Новый Структура;
	КоличествоСтрокТЧ = 0;

	Если ЗапросТабличныеЧасти <> Ложь Тогда

		ПланЧтенияТЧ = ПостроитьПланТабличныхЧастей(ОбъектМетаданных, ЗапросТабличныеЧасти);

		Для Каждого ЭлементПлана Из ПланЧтенияТЧ Цикл

			ИмяТЧ = ЭлементПлана.Ключ;
			ТаблицаТЧ = ПрочитатьТабличнуюЧасть(
				Объект, ОбъектМетаданных, ИмяТЧ, ЭлементПлана.Значение,
				УдаленнаяСсылка, КодТекущегоУзла, ВерсияДанных);

			Если РежимСериализации = URC_Протокол.РежимPortable() Тогда
				НачалоНормализации = ТекущаяУниверсальнаяДатаВМиллисекундах();
				ТаблицаТЧ = URC_ПортативныеТипы.НормализоватьЗначение(ТаблицаТЧ, КодТекущегоУзла);
				NormalizeMs = NormalizeMs
					+ ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоНормализации;
			КонецЕсли;

			СтруктураТабличныхЧастей.Вставить(ИмяТЧ, ТаблицаТЧ);
			КоличествоСтрокТЧ = КоличествоСтрокТЧ + ТаблицаТЧ.Количество();

		КонецЦикла;

	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Ссылка", УдаленнаяСсылка);
	Результат.Вставить("Реквизиты", СтруктураРеквизитов);
	Результат.Вставить("ТабличныеЧасти", СтруктураТабличныхЧастей);

	TotalMs = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОперации;
	ReadMs = TotalMs - NormalizeMs;

	Возврат Новый Структура(
		"Data,AttributesCount,TabularSectionsCount,TabularRowsCount,ReadMs,NormalizeMs",
		Результат,
		СтруктураРеквизитов.Количество(),
		СтруктураТабличныхЧастей.Количество(),
		КоличествоСтрокТЧ,
		ReadMs,
		NormalizeMs);

КонецФункции

Функция ПолучитьОбъект(УдаленнаяСсылка, КодТекущегоУзла) Экспорт

	НачалоОперации = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если Не URC_ПортативныеТипы.ЭтоУдаленнаяСсылка(УдаленнаяСсылка) Тогда
		ВызватьИсключение "REMOTE_OBJECT_INVALID|Reference должен быть RemoteReference";
	КонецЕсли;

	ЛокальнаяСсылка = URC_ПортативныеТипы.ВосстановитьRemoteReference(
		УдаленнаяСсылка, КодТекущегоУзла);
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(УдаленнаяСсылка.Metadata);
	Если Не ЭтоПоддерживаемыйТипЗаписи(ОбъектМетаданных) Тогда
		ВызватьИсключение "OBJECT_TYPE_NOT_SUPPORTED|"
			+ НСтр("ru = 'Поддерживаются элементы справочников и документы'; en = 'Catalog items and documents are supported'");
	КонецЕсли;

	Попытка
		Объект = ЛокальнаяСсылка.ПолучитьОбъект();
	Исключение
		ВызватьИсключение "OBJECT_NOT_FOUND|"
			+ НСтр("ru = 'Удаленный объект не найден'; en = 'Remote object was not found'");
	КонецПопытки;

	Контейнер = СформироватьКонтейнер(
		Объект, ОбъектМетаданных, УдаленнаяСсылка, Ложь, КодТекущегоУзла);
	Возврат РезультатСнимка(Контейнер, НачалоОперации);

КонецФункции

Функция СоздатьОбъект(ИмяМетаданных, КодТекущегоУзла) Экспорт

	НачалоОперации = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОбъектМетаданных = ПолучитьПоддерживаемыеМетаданные(ИмяМетаданных);
	URC_Безопасность.ПроверитьЗаписьОбъекта(ИмяМетаданных);
	Объект = СоздатьОбъектВПамяти(ОбъектМетаданных);
	Контейнер = СформироватьКонтейнер(
		Объект, ОбъектМетаданных, Неопределено, Истина, КодТекущегоУзла);
	Возврат РезультатСнимка(Контейнер, НачалоОперации);

КонецФункции

Функция РассчитатьИзменения(ДанныеОбъекта) Экспорт

	СлужебныеДанные = ПроверитьКонтейнерОбъекта(ДанныеОбъекта);
	ИсходныеРеквизиты = СлужебныеДанные.OriginalAttributes;
	ИсходныеТабличныеЧасти = СлужебныеДанные.OriginalTableParts;
	ЭтоНовый = СлужебныеДанные.IsNew;
	ИзмененныеРеквизиты = Новый Структура;
	ИзмененныеТабличныеЧасти = Новый Структура;
	ИсходныеИзмененныеРеквизиты = Новый Структура;
	ИсходныеИзмененныеТабличныеЧасти = Новый Структура;

	Для Каждого Реквизит Из ДанныеОбъекта.Реквизиты Цикл
		ИсходноеЗначение = Неопределено;
		ЕстьИсходноеЗначение = ИсходныеРеквизиты.Свойство(Реквизит.Ключ, ИсходноеЗначение);
		Если (ЭтоНовый И ЗначениеЗаполнено(Реквизит.Значение))
			Или Не ЕстьИсходноеЗначение
			Или Не ЗначенияРавны(Реквизит.Значение, ИсходноеЗначение) Тогда
			Если URC_ПортативныеТипы.ЭтоУдаленноеХранилище(ИсходноеЗначение)
				И Не URC_ПортативныеТипы.ЭтоИзменениеХранилища(Реквизит.Значение) Тогда
				ВызватьИсключение "VALUE_STORAGE_CHANGE_REQUIRED|"
					+ НСтр("ru = 'Используйте явную операцию изменения ХранилищеЗначения'; en = 'Use an explicit ValueStorage change operation'");
			КонецЕсли;
			ИзмененныеРеквизиты.Вставить(Реквизит.Ключ, Реквизит.Значение);
			ИсходныеИзмененныеРеквизиты.Вставить(Реквизит.Ключ, ИсходноеЗначение);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ТабличнаяЧасть Из ДанныеОбъекта.ТабличныеЧасти Цикл
		ИсходноеЗначение = Неопределено;
		ЕстьИсходноеЗначение = ИсходныеТабличныеЧасти.Свойство(
			ТабличнаяЧасть.Ключ, ИсходноеЗначение);
		Если ЭтоНовый
			Или Не ЕстьИсходноеЗначение
			Или Не ЗначенияРавны(ТабличнаяЧасть.Значение, ИсходноеЗначение) Тогда
			ИзмененныеТабличныеЧасти.Вставить(
				ТабличнаяЧасть.Ключ, ТабличнаяЧасть.Значение);
			ИсходныеИзмененныеТабличныеЧасти.Вставить(
				ТабличнаяЧасть.Ключ, ИсходноеЗначение);
		КонецЕсли;
	КонецЦикла;

	Изменения = Новый Структура(
		"Attributes,TableParts", ИзмененныеРеквизиты, ИзмененныеТабличныеЧасти);
	ИсходныеДанные = Новый Структура(
		"Attributes,TableParts", ИсходныеИзмененныеРеквизиты, ИсходныеИзмененныеТабличныеЧасти);
	Возврат Новый Структура(
		"ServiceData,Changes,Original,ChangedAttributesCount,ChangedTablePartsCount,NoChanges",
		СлужебныеДанные,
		Изменения,
		ИсходныеДанные,
		ИзмененныеРеквизиты.Количество(),
		ИзмененныеТабличныеЧасти.Количество(),
		ИзмененныеРеквизиты.Количество() = 0 И ИзмененныеТабличныеЧасти.Количество() = 0);

КонецФункции

Функция ЗаписатьОбъект(ТранспортныйЗапрос, КодТекущегоУзла) Экспорт

	НачалоОперации = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ДанныеЗаписи = РазобратьЗапросЗаписи(ТранспортныйЗапрос, КодТекущегоУзла);
	URC_Безопасность.ПроверитьЗаписьОбъекта(ДанныеЗаписи.Metadata);
	ОбъектМетаданных = ПолучитьПоддерживаемыеМетаданные(ДанныеЗаписи.Metadata);

	НачатьТранзакцию();
	Попытка
		Если ДанныеЗаписи.IsNew Тогда
			Объект = СоздатьОбъектВПамяти(ОбъектМетаданных);
		Иначе
			ЛокальнаяСсылка = URC_ПортативныеТипы.ВосстановитьRemoteReference(
				ДанныеЗаписи.Reference, КодТекущегоУзла);
			ЗаблокироватьДанныеДляРедактирования(ЛокальнаяСсылка);
			Попытка
				Объект = ЛокальнаяСсылка.ПолучитьОбъект();
			Исключение
				ВызватьИсключение "OBJECT_NOT_FOUND|Удаленный объект не найден";
			КонецПопытки;
			ПроверитьКонфликты(
				Объект, ОбъектМетаданных, ДанныеЗаписи.Changes,
				ДанныеЗаписи.Original, ДанныеЗаписи.RemoteObjectData, КодТекущегоУзла);
		КонецЕсли;

		ПрименитьРеквизиты(
			Объект, ОбъектМетаданных, ДанныеЗаписи.Changes.Attributes,
			ДанныеЗаписи, КодТекущегоУзла);
		ПрименитьТабличныеЧасти(
			Объект, ОбъектМетаданных, ДанныеЗаписи.Changes.TableParts,
			ДанныеЗаписи, КодТекущегоУзла);
		ВыполнитьШтатнуюЗапись(Объект, ОбъектМетаданных, ДанныеЗаписи.WriteMode);

		ЛокальнаяСсылка = Объект.Ссылка;
		УдаленнаяСсылка = URC_ПортативныеТипы.НормализоватьЗначение(
			ЛокальнаяСсылка, КодТекущегоУзла);
		Контейнер = СформироватьКонтейнер(
			Объект, ОбъектМетаданных, УдаленнаяСсылка, Ложь, КодТекущегоУзла);
		ЗафиксироватьТранзакцию();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ОтменитьТранзакцию();
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;

	ДанныеРезультата = Новый Структура;
	ДанныеРезультата.Вставить("Успех", Истина);
	ДанныеРезультата.Вставить("Ссылка", УдаленнаяСсылка);
	ДанныеРезультата.Вставить("ЭтоНовый", Ложь);
	ДанныеРезультата.Вставить("РежимЗаписи", ДанныеЗаписи.WriteMode);
	ДанныеРезультата.Вставить(
		"ИзмененоРеквизитов", ДанныеЗаписи.Changes.Attributes.Количество());
	ДанныеРезультата.Вставить(
		"ИзмененоТабличныхЧастей", ДанныеЗаписи.Changes.TableParts.Количество());
	МетрикиХранилища = ПодсчитатьИзмененияХранилища(ДанныеЗаписи.Changes);
	ДанныеРезультата.Вставить("ИзмененоХранилищ", МетрикиХранилища.Total);
	ДанныеРезультата.Вставить("ОчищеноХранилищ", МетрикиХранилища.Clear);
	ДанныеРезультата.Вставить("СкопированоХранилищ", МетрикиХранилища.Copy);
	ДанныеРезультата.Вставить(
		"ДлительностьМС", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОперации);
	ДанныеРезультата.Вставить("ObjectData", Контейнер);

	Возврат Новый Структура(
		"Data,ChangedAttributesCount,ChangedTablePartsCount,ChangedValueStoragesCount,ClearedValueStoragesCount,CopiedValueStoragesCount,WriteMs",
		ДанныеРезультата,
		ДанныеЗаписи.Changes.Attributes.Количество(),
		ДанныеЗаписи.Changes.TableParts.Количество(),
		МетрикиХранилища.Total,
		МетрикиХранилища.Clear,
		МетрикиХранилища.Copy,
		ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОперации);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Список сознательно не включает ПланОбмена: узлы плана обмена несут служебные
// технические данные синхронизации и не предназначены для выгрузки полным
// снимком через публичный API Remote1C.
Функция ЭтоПоддерживаемыйТипДанныхОбъекта(ОбъектМетаданных)

	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();

	Возврат СтрНачинаетсяС(ПолноеИмя, "Справочник.")
		Или СтрНачинаетсяС(ПолноеИмя, "Документ.")
		Или СтрНачинаетсяС(ПолноеИмя, "ПланСчетов.")
		Или СтрНачинаетсяС(ПолноеИмя, "ПланВидовХарактеристик.")
		Или СтрНачинаетсяС(ПолноеИмя, "ПланВидовРасчета.")
		Или СтрНачинаетсяС(ПолноеИмя, "БизнесПроцесс.")
		Или СтрНачинаетсяС(ПолноеИмя, "Задача.");

КонецФункции

// Возвращает Соответствие ИмяТЧ → спецификация колонок (Неопределено = все доступные).
Функция ПостроитьПланТабличныхЧастей(ОбъектМетаданных, ЗапросТабличныеЧасти)

	Результат = Новый Соответствие;

	Если ЗапросТабличныеЧасти = Неопределено Тогда
		Для Каждого МетаданныеТЧ Из ОбъектМетаданных.ТабличныеЧасти Цикл
			Результат.Вставить(МетаданныеТЧ.Имя, Неопределено);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(ЗапросТабличныеЧасти) <> Тип("Структура")
		И ТипЗнч(ЗапросТабличныеЧасти) <> Тип("ФиксированнаяСтруктура") Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'TabularSections должен быть Структурой, Ложь или не заполнен'; en = 'TabularSections must be a Structure, False, or omitted'");
	КонецЕсли;

	Для Каждого Элемент Из ЗапросТабличныеЧасти Цикл

		ИмяТЧ = СокрЛП(Элемент.Ключ);
		Если ОбъектМетаданных.ТабличныеЧасти.Найти(ИмяТЧ) = Неопределено Тогда
			ВызватьИсключение "TABULAR_SECTION_NOT_FOUND|"
				+ НСтр("ru = 'Табличная часть не найдена'; en = 'Tabular section not found'")
				+ ": " + ИмяТЧ;
		КонецЕсли;

		Результат.Вставить(ИмяТЧ, Элемент.Значение);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПрочитатьТабличнуюЧасть(
	Объект, ОбъектМетаданных, ИмяТЧ, СпецификацияКолонок,
	УдаленнаяСсылка, КодТекущегоУзла, ВерсияДанных)

	МетаданныеТЧ = ОбъектМетаданных.ТабличныеЧасти.Найти(ИмяТЧ);
	Если МетаданныеТЧ = Неопределено Тогда
		ВызватьИсключение "TABULAR_SECTION_NOT_FOUND|"
			+ НСтр("ru = 'Табличная часть не найдена'; en = 'Tabular section not found'")
			+ ": " + ИмяТЧ;
	КонецЕсли;

	СтрокаКолонок = Неопределено;
	Если СпецификацияКолонок <> Неопределено Тогда
		СтрокаКолонок = СтрСоединить(
			РазобратьИменаКолонокТЧ(СпецификацияКолонок, МетаданныеТЧ, ИмяТЧ), ",");
	КонецЕсли;

	Попытка
		Если СтрокаКолонок = Неопределено Тогда
			Результат = Объект[ИмяТЧ].Выгрузить();
		Иначе
			Результат = Объект[ИмяТЧ].Выгрузить(, СтрокаКолонок);
		КонецЕсли;
	Исключение
		ВызватьИсключение "OBJECT_DATA_READ_ERROR|"
			+ НСтр("ru = 'Ошибка чтения табличной части'; en = 'Tabular section read error'")
			+ " " + ИмяТЧ + ": " + ОписаниеОшибки();
	КонецПопытки;

	ЗаменитьХранилищаТабличнойЧастиДескрипторами(
		Результат, МетаданныеТЧ, УдаленнаяСсылка, КодТекущегоУзла,
		ОбъектМетаданных, ВерсияДанных, Ложь);
	Возврат Результат;

КонецФункции

Функция РазобратьИменаКолонокТЧ(СпецификацияКолонок, МетаданныеТЧ, ИмяТЧ)

	Если ТипЗнч(СпецификацияКолонок) = Тип("Строка") Тогда
		ИсходныеИмена = СтрРазделить(СпецификацияКолонок, ",");
	ИначеЕсли ТипЗнч(СпецификацияКолонок) = Тип("Массив")
		Или ТипЗнч(СпецификацияКолонок) = Тип("ФиксированныйМассив") Тогда
		ИсходныеИмена = СпецификацияКолонок;
	Иначе
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Список колонок табличной части должен быть строкой, массивом или не заполнен'; en = 'Tabular section column list must be a string, array, or omitted'");
	КонецЕсли;

	Результат = Новый Массив;
	УжеДобавлены = Новый Соответствие;

	Для Каждого ИсходноеИмя Из ИсходныеИмена Цикл

		Если ТипЗнч(ИсходноеИмя) <> Тип("Строка") Тогда
			ВызватьИсключение "BAD_REQUEST|"
				+ НСтр("ru = 'Имя колонки табличной части должно быть строкой'; en = 'Tabular section column name must be a string'");
		КонецЕсли;

		ИмяКолонки = СокрЛП(ИсходноеИмя);
		Если ПустаяСтрока(ИмяКолонки)
			Или СтрНайти(ИмяКолонки, ".") > 0
			Или СтрНайти(ИмяКолонки, " ") > 0 Тогда
			ВызватьИсключение "TABULAR_ATTRIBUTE_NOT_FOUND|"
				+ НСтр("ru = 'Недопустимое имя колонки табличной части'; en = 'Invalid tabular section column name'")
				+ ": " + ИмяТЧ + "." + ИмяКолонки;
		КонецЕсли;

		Если МетаданныеТЧ.Реквизиты.Найти(ИмяКолонки) = Неопределено Тогда
			ВызватьИсключение "TABULAR_ATTRIBUTE_NOT_FOUND|"
				+ НСтр("ru = 'Реквизит табличной части не найден'; en = 'Tabular section attribute not found'")
				+ ": " + ИмяТЧ + "." + ИмяКолонки;
		КонецЕсли;

		Если УжеДобавлены.Получить(ИмяКолонки) = Неопределено Тогда
			Результат.Добавить(ИмяКолонки);
			УжеДобавлены.Вставить(ИмяКолонки, Истина);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция РезультатСнимка(Контейнер, НачалоОперации)

	КоличествоСтрок = 0;
	Для Каждого ТабличнаяЧасть Из Контейнер.ТабличныеЧасти Цикл
		КоличествоСтрок = КоличествоСтрок + ТабличнаяЧасть.Значение.Количество();
	КонецЦикла;
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОперации;
	Возврат Новый Структура(
		"Data,AttributesCount,TabularSectionsCount,TabularRowsCount,ReadMs,NormalizeMs",
		Контейнер,
		Контейнер.Реквизиты.Количество(),
		Контейнер.ТабличныеЧасти.Количество(),
		КоличествоСтрок,
		Длительность,
		0);

КонецФункции

Функция СформироватьКонтейнер(Объект, ОбъектМетаданных, Ссылка, ЭтоНовый, КодТекущегоУзла)

	ВерсияДанных = URC_Реквизиты.ВерсияДанныхОбъекта(Объект);
	Реквизиты = Новый Структура;
	ДоступныеРеквизиты = URC_Реквизиты.ПолучитьДоступныеРеквизиты(ОбъектМетаданных);
	Для Каждого Реквизит Из ДоступныеРеквизиты Цикл
		Если Не ЭтоРедактируемыйРеквизит(Реквизит.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Если URC_Реквизиты.ЭтоРеквизитХранилищеЗначения(
			ОбъектМетаданных, Реквизит.Ключ) Тогда
			Если ЭтоНовый Тогда
				Реквизиты.Вставить(Реквизит.Ключ, Неопределено);
			Иначе
				Реквизиты.Вставить(
					Реквизит.Ключ,
					URC_ПортативныеТипы.СоздатьRemoteValueStorage(
						Ссылка,
						Реквизит.Ключ,
						КодТекущегоУзла,
						ОбъектМетаданных));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Попытка
			ЗначениеРеквизита = Объект[Реквизит.Ключ];
		Исключение
			ВызватьИсключение "OBJECT_DATA_READ_ERROR|Ошибка чтения реквизита "
				+ Реквизит.Ключ;
		КонецПопытки;
		Реквизиты.Вставить(
			Реквизит.Ключ,
			URC_ПортативныеТипы.НормализоватьЗначение(ЗначениеРеквизита, КодТекущегоУзла));
	КонецЦикла;

	ТабличныеЧасти = Новый Структура;
	Для Каждого МетаданныеТЧ Из ОбъектМетаданных.ТабличныеЧасти Цикл
		ТаблицаТЧ = Объект[МетаданныеТЧ.Имя].Выгрузить();
		Если ТабличнаяЧастьСодержитХранилище(МетаданныеТЧ) Тогда
			ПроверитьКоллизиюСлужебнойКолонки(МетаданныеТЧ);
			ТаблицаТЧ.Колонки.Добавить("URC__RowId");
			НомерСтроки = 0;
			Для Каждого СтрокаТЧ Из ТаблицаТЧ Цикл
				СтрокаТЧ.URC__RowId = ?(ЭтоНовый, "", Строка(Новый УникальныйИдентификатор));
				НомерСтроки = НомерСтроки + 1;
			КонецЦикла;
			Если ЭтоНовый Тогда
				ОчиститьХранилищаНовойТабличнойЧасти(ТаблицаТЧ, МетаданныеТЧ);
			Иначе
				ЗаменитьХранилищаТабличнойЧастиДескрипторами(
					ТаблицаТЧ, МетаданныеТЧ, Ссылка, КодТекущегоУзла,
					ОбъектМетаданных, ВерсияДанных, Истина);
			КонецЕсли;
		КонецЕсли;
		ТабличныеЧасти.Вставить(
			МетаданныеТЧ.Имя,
			URC_ПортативныеТипы.НормализоватьЗначение(ТаблицаТЧ, КодТекущегоУзла));
	КонецЦикла;

	СлужебныеДанные = Новый Структура;
	СлужебныеДанные.Вставить("URCType", "RemoteObjectData");
	СлужебныеДанные.Вставить("Node", КодТекущегоУзла);
	СлужебныеДанные.Вставить("Metadata", ОбъектМетаданных.ПолноеИмя());
	СлужебныеДанные.Вставить("Reference", Ссылка);
	СлужебныеДанные.Вставить("IsNew", ЭтоНовый);
	СлужебныеДанные.Вставить("DataVersion", ВерсияДанных);
	СлужебныеДанные.Вставить("OriginalAttributes", ГлубокаяКопия(Реквизиты));
	СлужебныеДанные.Вставить("OriginalTableParts", ГлубокаяКопия(ТабличныеЧасти));
	СлужебныеДанные.Вставить("LoadedAt", ТекущаяДатаСеанса());

	Возврат Новый Структура(
		"Реквизиты,ТабличныеЧасти,СлужебныеДанные",
		Реквизиты, ТабличныеЧасти, СлужебныеДанные);

КонецФункции

Функция ПроверитьКонтейнерОбъекта(ДанныеОбъекта)

	Если ТипЗнч(ДанныеОбъекта) <> Тип("Структура") Тогда
		ВызватьИсключение "REMOTE_OBJECT_INVALID|Ожидается структура данных объекта";
	КонецЕсли;
	Если Не ДанныеОбъекта.Свойство("Реквизиты")
		Или ТипЗнч(ДанныеОбъекта.Реквизиты) <> Тип("Структура")
		Или Не ДанныеОбъекта.Свойство("ТабличныеЧасти")
		Или ТипЗнч(ДанныеОбъекта.ТабличныеЧасти) <> Тип("Структура")
		Или Не ДанныеОбъекта.Свойство("СлужебныеДанные")
		Или ТипЗнч(ДанныеОбъекта.СлужебныеДанные) <> Тип("Структура") Тогда
		ВызватьИсключение "REMOTE_OBJECT_INVALID|Повреждена структура данных объекта";
	КонецЕсли;

	СлужебныеДанные = ДанныеОбъекта.СлужебныеДанные;
	URCType = "";
	Node = "";
	мMetadata = "";
	Reference = Неопределено;
	IsNew = Неопределено;
	OriginalAttributes = Неопределено;
	OriginalTableParts = Неопределено;
	DataVersion = Неопределено;
	Если Не СлужебныеДанные.Свойство("URCType", URCType) Или URCType <> "RemoteObjectData"
		Или Не СлужебныеДанные.Свойство("Node", Node) Или ПустаяСтрока(Node)
		Или Не СлужебныеДанные.Свойство("Metadata", мMetadata) Или ПустаяСтрока(мMetadata)
		Или Не СлужебныеДанные.Свойство("Reference", Reference)
		Или Не СлужебныеДанные.Свойство("IsNew", IsNew) Или ТипЗнч(IsNew) <> Тип("Булево")
		Или Не СлужебныеДанные.Свойство("OriginalAttributes", OriginalAttributes)
		Или ТипЗнч(OriginalAttributes) <> Тип("Структура")
		Или Не СлужебныеДанные.Свойство("OriginalTableParts", OriginalTableParts)
		Или ТипЗнч(OriginalTableParts) <> Тип("Структура")
		Или Не СлужебныеДанные.Свойство("DataVersion", DataVersion)
		Или ТипЗнч(DataVersion) <> Тип("Строка") Тогда
		ВызватьИсключение "REMOTE_OBJECT_INVALID|Повреждены служебные данные объекта";
	КонецЕсли;

	Если Не IsNew Тогда
		Если Не URC_ПортативныеТипы.ЭтоУдаленнаяСсылка(Reference) Тогда
			ВызватьИсключение "REMOTE_OBJECT_INVALID|Не заполнена ссылка существующего объекта";
		КонецЕсли;
		УзелСсылки = "";
		Если Не Reference.Свойство("Node", УзелСсылки) Или УзелСсылки <> Node Тогда
			ВызватьИсключение "REFERENCE_NODE_INVALID|Подменен узел исходной ссылки";
		КонецЕсли;
	КонецЕсли;

	Возврат СлужебныеДанные;

КонецФункции

Функция РазобратьЗапросЗаписи(ТранспортныйЗапрос, КодТекущегоУзла)

	Для Каждого ОбязательноеПоле Из СтрРазделить(
		"Metadata,Reference,IsNew,WriteMode,Changes,Original,RemoteObjectData", ",") Цикл
		Если Не ТранспортныйЗапрос.Свойство(ОбязательноеПоле) Тогда
			ВызватьИсключение "REMOTE_OBJECT_INVALID|Не заполнено поле " + ОбязательноеПоле;
		КонецЕсли;
	КонецЦикла;

	Если ТипЗнч(ТранспортныйЗапрос.RemoteObjectData) <> Тип("Структура")
		Или ТипЗнч(ТранспортныйЗапрос.Changes) <> Тип("Структура")
		Или ТипЗнч(ТранспортныйЗапрос.Original) <> Тип("Структура") Тогда
		ВызватьИсключение "REMOTE_OBJECT_INVALID|Некорректный формат запроса записи";
	КонецЕсли;
	Если Не ТранспортныйЗапрос.Changes.Свойство("Attributes")
		Или ТипЗнч(ТранспортныйЗапрос.Changes.Attributes) <> Тип("Структура")
		Или Не ТранспортныйЗапрос.Changes.Свойство("TableParts")
		Или ТипЗнч(ТранспортныйЗапрос.Changes.TableParts) <> Тип("Структура")
		Или Не ТранспортныйЗапрос.Original.Свойство("Attributes")
		Или ТипЗнч(ТранспортныйЗапрос.Original.Attributes) <> Тип("Структура")
		Или Не ТранспортныйЗапрос.Original.Свойство("TableParts")
		Или ТипЗнч(ТранспортныйЗапрос.Original.TableParts) <> Тип("Структура") Тогда
		ВызватьИсключение "REMOTE_OBJECT_INVALID|Некорректный блок Changes/Original";
	КонецЕсли;

	СлужебныеДанные = ТранспортныйЗапрос.RemoteObjectData;
	URCType = "";
	Node = "";
	мMetadata = "";
	IsNew = Неопределено;
	Если Не СлужебныеДанные.Свойство("URCType", URCType) Или URCType <> "RemoteObjectData"
		Или Не СлужебныеДанные.Свойство("Node", Node) Или Node <> КодТекущегоУзла
		Или Не СлужебныеДанные.Свойство("Metadata",мMetadata)
		Или мMetadata <> ТранспортныйЗапрос.Metadata
		Или Не СлужебныеДанные.Свойство("IsNew", IsNew)
		Или IsNew <> ТранспортныйЗапрос.IsNew Тогда
		ВызватьИсключение "REMOTE_OBJECT_INVALID|Служебные данные не соответствуют запросу";
	КонецЕсли;

	Если Не IsNew Тогда
		Если Не URC_ПортативныеТипы.ЭтоУдаленнаяСсылка(ТранспортныйЗапрос.Reference) Тогда
			ВызватьИсключение "REMOTE_OBJECT_INVALID|Reference должен быть RemoteReference";
		КонецЕсли;
		УзелСсылки = "";
		Если Не ТранспортныйЗапрос.Reference.Свойство("Node", УзелСсылки)
			Или УзелСсылки <> КодТекущегоУзла Тогда
			ВызватьИсключение "REFERENCE_NODE_INVALID|Reference принадлежит другому узлу";
		КонецЕсли;
	КонецЕсли;

	РежимЗаписи = НормализоватьРежимЗаписи(ТранспортныйЗапрос.WriteMode);
	Возврат Новый Структура(
		"Metadata,Reference,IsNew,WriteMode,Changes,Original,RemoteObjectData",
		мMetadata,
		ТранспортныйЗапрос.Reference,
		IsNew,
		РежимЗаписи,
		ТранспортныйЗапрос.Changes,
		ТранспортныйЗапрос.Original,
		СлужебныеДанные);

КонецФункции

Функция ПолучитьПоддерживаемыеМетаданные(ИмяМетаданных)

	Если ТипЗнч(ИмяМетаданных) <> Тип("Строка") Тогда
		ВызватьИсключение "OBJECT_TYPE_NOT_SUPPORTED|Некорректное имя метаданных";
	КонецЕсли;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ИмяМетаданных);
	Если Не ЭтоПоддерживаемыйТипЗаписи(ОбъектМетаданных) Тогда
		ВызватьИсключение "OBJECT_TYPE_NOT_SUPPORTED|"
			+ НСтр("ru = 'Поддерживаются элементы справочников и документы'; en = 'Catalog items and documents are supported'")
			+ ": " + ИмяМетаданных;
	КонецЕсли;
	Возврат ОбъектМетаданных;

КонецФункции

Функция ЭтоПоддерживаемыйТипЗаписи(ОбъектМетаданных)

	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	Возврат СтрНачинаетсяС(ПолноеИмя, "Справочник.")
		Или СтрНачинаетсяС(ПолноеИмя, "Документ.");

КонецФункции

Функция СоздатьОбъектВПамяти(ОбъектМетаданных)

	Если СтрНачинаетсяС(ОбъектМетаданных.ПолноеИмя(), "Справочник.") Тогда
		Возврат Справочники[ОбъектМетаданных.Имя].СоздатьЭлемент();
	КонецЕсли;
	Если СтрНачинаетсяС(ОбъектМетаданных.ПолноеИмя(), "Документ.") Тогда
		Возврат Документы[ОбъектМетаданных.Имя].СоздатьДокумент();
	КонецЕсли;
	ВызватьИсключение "OBJECT_TYPE_NOT_SUPPORTED|Неподдерживаемый тип объекта";

КонецФункции

Процедура ПроверитьКонфликты(
	Объект, ОбъектМетаданных, Изменения, ИсходныеДанные, СлужебныеДанные, КодУзла)

	Конфликты = Новый Массив;
	Для Каждого Реквизит Из Изменения.Attributes Цикл
		ПроверитьИмяРеквизитаДляЗаписи(ОбъектМетаданных, Реквизит.Ключ);
		Если URC_Реквизиты.ЭтоРеквизитХранилищеЗначения(
			ОбъектМетаданных, Реквизит.Ключ) Тогда
			ИсходноеЗначение = Неопределено;
			Если Не ИсходныеДанные.Attributes.Свойство(Реквизит.Ключ, ИсходноеЗначение) Тогда
				ВызватьИсключение "REMOTE_OBJECT_INVALID|Нет исходного значения реквизита " + Реквизит.Ключ;
			КонецЕсли;
			ПроверитьВерсиюДанных(Объект, СлужебныеДанные);
			ПроверитьИзменениеХранилища(
				Реквизит.Значение, ИсходноеЗначение, "Attribute",
				Реквизит.Ключ, "", "", СлужебныеДанные, КодУзла);
			Продолжить;
		КонецЕсли;
		ИсходноеЗначение = Неопределено;
		Если Не ИсходныеДанные.Attributes.Свойство(Реквизит.Ключ, ИсходноеЗначение) Тогда
			ВызватьИсключение "REMOTE_OBJECT_INVALID|Нет исходного значения реквизита " + Реквизит.Ключ;
		КонецЕсли;
		ТекущееЗначение = URC_ПортативныеТипы.НормализоватьЗначение(
			Объект[Реквизит.Ключ], КодУзла);
		Если Не ЗначенияРавны(ТекущееЗначение, ИсходноеЗначение) Тогда
			Конфликты.Добавить("Реквизиты." + Реквизит.Ключ);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ТабличнаяЧасть Из Изменения.TableParts Цикл
		МетаданныеТЧ = ОбъектМетаданных.ТабличныеЧасти.Найти(ТабличнаяЧасть.Ключ);
		Если МетаданныеТЧ = Неопределено Тогда
			ВызватьИсключение "TABLE_PART_NOT_FOUND|" + ТабличнаяЧасть.Ключ;
		КонецЕсли;
		Если ТабличнаяЧастьСодержитХранилище(МетаданныеТЧ) Тогда
			ПроверитьВерсиюДанных(Объект, СлужебныеДанные);
			Продолжить;
		КонецЕсли;
		ИсходноеЗначение = Неопределено;
		Если Не ИсходныеДанные.TableParts.Свойство(ТабличнаяЧасть.Ключ, ИсходноеЗначение) Тогда
			ВызватьИсключение "REMOTE_OBJECT_INVALID|Нет исходного значения табличной части "
				+ ТабличнаяЧасть.Ключ;
		КонецЕсли;
		ТекущееЗначение = URC_ПортативныеТипы.НормализоватьЗначение(
			Объект[ТабличнаяЧасть.Ключ].Выгрузить(), КодУзла);
		Если Не ЗначенияРавны(ТекущееЗначение, ИсходноеЗначение) Тогда
			Конфликты.Добавить("ТабличныеЧасти." + ТабличнаяЧасть.Ключ);
		КонецЕсли;
	КонецЦикла;

	Если Конфликты.Количество() > 0 Тогда
		ВызватьИсключение "OBJECT_CONFLICT|"
			+ НСтр("ru = 'Удаленный объект изменен после чтения'; en = 'Remote object was changed after it was read'")
			+ ": " + СтрСоединить(Конфликты, ", ");
	КонецЕсли;

КонецПроцедуры

Процедура ПрименитьРеквизиты(Объект, ОбъектМетаданных, Реквизиты, ДанныеЗаписи, КодУзла)

	Для Каждого Реквизит Из Реквизиты Цикл
		ПроверитьИмяРеквизитаДляЗаписи(ОбъектМетаданных, Реквизит.Ключ);
		Если URC_Реквизиты.ЭтоРеквизитХранилищеЗначения(
			ОбъектМетаданных, Реквизит.Ключ) Тогда
			ИсходноеЗначение = Неопределено;
			ДанныеЗаписи.Original.Attributes.Свойство(Реквизит.Ключ, ИсходноеЗначение);
			Объект[Реквизит.Ключ] = ПолучитьНовоеХранилище(
				Реквизит.Значение, ИсходноеЗначение, "Attribute",
				Реквизит.Ключ, "", "", ДанныеЗаписи.RemoteObjectData, КодУзла);
			Продолжить;
		КонецЕсли;
		Попытка
			Объект[Реквизит.Ключ] = URC_ПортативныеТипы.ВосстановитьЗначениеДляЗаписи(
				Реквизит.Значение, КодУзла);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			Если СтрНайти(ТекстОшибки, "REFERENCE_NODE_INVALID|") > 0 Тогда
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;
			ВызватьИсключение "OBJECT_VALIDATION_ERROR|Ошибка заполнения реквизита "
				+ Реквизит.Ключ + ": " + ТекстОшибки;
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьИмяРеквизитаДляЗаписи(ОбъектМетаданных, ИмяРеквизита)

	ДоступныеРеквизиты = URC_Реквизиты.ПолучитьДоступныеРеквизиты(ОбъектМетаданных);
	Если ДоступныеРеквизиты.Получить(ИмяРеквизита) = Неопределено Тогда
		ВызватьИсключение "ATTRIBUTE_NOT_WRITABLE|Неизвестный реквизит " + ИмяРеквизита;
	КонецЕсли;
	Если Не ЭтоРедактируемыйРеквизит(ИмяРеквизита) Тогда
		ВызватьИсключение "ATTRIBUTE_NOT_WRITABLE|Реквизит недоступен для записи " + ИмяРеквизита;
	КонецЕсли;

КонецПроцедуры

Процедура ПрименитьТабличныеЧасти(
	Объект, ОбъектМетаданных, ТабличныеЧасти, ДанныеЗаписи, КодУзла)

	Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
		МетаданныеТЧ = ОбъектМетаданных.ТабличныеЧасти.Найти(ТабличнаяЧасть.Ключ);
		Если МетаданныеТЧ = Неопределено Тогда
			ВызватьИсключение "TABLE_PART_NOT_FOUND|" + ТабличнаяЧасть.Ключ;
		КонецЕсли;
		Если ТипЗнч(ТабличнаяЧасть.Значение) <> Тип("ТаблицаЗначений") Тогда
			ВызватьИсключение "OBJECT_VALIDATION_ERROR|Табличная часть должна иметь тип ТаблицаЗначений";
		КонецЕсли;
		Если ТабличнаяЧастьСодержитХранилище(МетаданныеТЧ) Тогда
			ИсходнаяТаблица = Неопределено;
			Если Не ДанныеЗаписи.Original.TableParts.Свойство(
				ТабличнаяЧасть.Ключ, ИсходнаяТаблица) Тогда
				ВызватьИсключение "REMOTE_OBJECT_INVALID|Нет исходной табличной части "
					+ ТабличнаяЧасть.Ключ;
			КонецЕсли;
			ТаблицаДляЗагрузки = ПодготовитьТаблицуСХранилищамиДляЗагрузки(
				ТабличнаяЧасть.Значение, ИсходнаяТаблица,
				Объект[ТабличнаяЧасть.Ключ].Выгрузить(), МетаданныеТЧ,
				ДанныеЗаписи.RemoteObjectData, КодУзла, ТабличнаяЧасть.Ключ);
		Иначе
			ТаблицаДляЗагрузки = ПодготовитьТаблицуДляЗагрузки(
				ТабличнаяЧасть.Значение, МетаданныеТЧ, КодУзла, ТабличнаяЧасть.Ключ);
		КонецЕсли;
		Попытка
			Объект[ТабличнаяЧасть.Ключ].Загрузить(ТаблицаДляЗагрузки);
		Исключение
			ВызватьИсключение "OBJECT_VALIDATION_ERROR|Ошибка заполнения табличной части "
				+ ТабличнаяЧасть.Ключ + ": " + ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Функция ПодготовитьТаблицуСХранилищамиДляЗагрузки(
	КлиентскаяТаблица, ИсходнаяТаблица, СервернаяТаблица, МетаданныеТЧ,
	СлужебныеДанные, КодУзла, ИмяТЧ)

	ПроверитьКоллизиюСлужебнойКолонки(МетаданныеТЧ);
	Если КлиентскаяТаблица.Колонки.Найти("URC__RowId") = Неопределено
		Или ИсходнаяТаблица.Колонки.Найти("URC__RowId") = Неопределено Тогда
		ВызватьИсключение "VALUE_STORAGE_ROW_ID_INVALID|Отсутствует URC__RowId";
	КонецЕсли;

	Результат = Новый ТаблицаЗначений;
	Для Каждого РеквизитТЧ Из МетаданныеТЧ.Реквизиты Цикл
		Если КлиентскаяТаблица.Колонки.Найти(РеквизитТЧ.Имя) = Неопределено Тогда
			ВызватьИсключение "TABLE_PART_COLUMN_NOT_FOUND|" + ИмяТЧ + "." + РеквизитТЧ.Имя;
		КонецЕсли;
		Результат.Колонки.Добавить(РеквизитТЧ.Имя);
	КонецЦикла;

	СтрокиПоИдентификаторам = Новый Соответствие;
	Для НомерСтроки = 0 По ИсходнаяТаблица.Количество() - 1 Цикл
		ИдентификаторСтроки = ИсходнаяТаблица[НомерСтроки].URC__RowId;
		Если ТипЗнч(ИдентификаторСтроки) <> Тип("Строка")
			Или ПустаяСтрока(ИдентификаторСтроки)
			Или СтрокиПоИдентификаторам.Получить(ИдентификаторСтроки) <> Неопределено
			Или НомерСтроки >= СервернаяТаблица.Количество() Тогда
			ВызватьИсключение "VALUE_STORAGE_ROW_ID_INVALID|Некорректный исходный URC__RowId";
		КонецЕсли;
		СтрокиПоИдентификаторам.Вставить(
			ИдентификаторСтроки,
			Новый Структура("Original,Server", ИсходнаяТаблица[НомерСтроки], СервернаяТаблица[НомерСтроки]));
	КонецЦикла;

	ИспользованныеИдентификаторы = Новый Соответствие;
	Для Каждого КлиентскаяСтрока Из КлиентскаяТаблица Цикл
		ИдентификаторСтроки = КлиентскаяСтрока.URC__RowId;
		Если ТипЗнч(ИдентификаторСтроки) <> Тип("Строка") Тогда
			ВызватьИсключение "VALUE_STORAGE_ROW_ID_INVALID|URC__RowId должен быть строкой";
		КонецЕсли;
		ЭтоНоваяСтрока = ПустаяСтрока(ИдентификаторСтроки);
		ДанныеИсходнойСтроки = Неопределено;
		Если Не ЭтоНоваяСтрока Тогда
			ДанныеИсходнойСтроки = СтрокиПоИдентификаторам.Получить(ИдентификаторСтроки);
			Если ДанныеИсходнойСтроки = Неопределено
				Или ИспользованныеИдентификаторы.Получить(ИдентификаторСтроки) <> Неопределено Тогда
				ВызватьИсключение "VALUE_STORAGE_ROW_ID_INVALID|Неизвестный или повторный URC__RowId";
			КонецЕсли;
			ИспользованныеИдентификаторы.Вставить(ИдентификаторСтроки, Истина);
		КонецЕсли;

		НоваяСтрока = Результат.Добавить();
		Для Каждого РеквизитТЧ Из МетаданныеТЧ.Реквизиты Цикл
			КлиентскоеЗначение = КлиентскаяСтрока[РеквизитТЧ.Имя];
			Если РеквизитТЧ.Тип.СодержитТип(Тип("ХранилищеЗначения")) Тогда
				Если ЭтоНоваяСтрока Тогда
					Если КлиентскоеЗначение = Неопределено Тогда
						НоваяСтрока[РеквизитТЧ.Имя] = Неопределено;
					Иначе
						НоваяСтрока[РеквизитТЧ.Имя] = ПолучитьНовоеХранилище(
							КлиентскоеЗначение, Неопределено, "TablePart", "",
							ИмяТЧ, РеквизитТЧ.Имя, СлужебныеДанные, КодУзла);
					КонецЕсли;
				Иначе
					ИсходныйДескриптор = ДанныеИсходнойСтроки.Original[РеквизитТЧ.Имя];
					Если ЗначенияРавны(КлиентскоеЗначение, ИсходныйДескриптор) Тогда
						// Сохраняем ХранилищеЗначения как есть, не вызывая Получить().
						НоваяСтрока[РеквизитТЧ.Имя] = ДанныеИсходнойСтроки.Server[РеквизитТЧ.Имя];
					Иначе
						НоваяСтрока[РеквизитТЧ.Имя] = ПолучитьНовоеХранилище(
							КлиентскоеЗначение, ИсходныйДескриптор, "TablePart", "",
							ИмяТЧ, РеквизитТЧ.Имя, СлужебныеДанные, КодУзла);
					КонецЕсли;
				КонецЕсли;
			Иначе
				НоваяСтрока[РеквизитТЧ.Имя] = URC_ПортативныеТипы.ВосстановитьЗначениеДляЗаписи(
					КлиентскоеЗначение, КодУзла);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ЗаменитьХранилищаТабличнойЧастиДескрипторами(
	ТаблицаТЧ, МетаданныеТЧ, УдаленнаяСсылка, КодУзла,
	ОбъектМетаданных, ВерсияДанных, ДобавлятьИдентификаторСтроки)

	НомерСтроки = 0;
	Для Каждого СтрокаТЧ Из ТаблицаТЧ Цикл
		ИдентификаторСтроки = Неопределено;
		Если ДобавлятьИдентификаторСтроки Тогда
			ИдентификаторСтроки = СтрокаТЧ.URC__RowId;
		КонецЕсли;
		Для Каждого РеквизитТЧ Из МетаданныеТЧ.Реквизиты Цикл
			Если РеквизитТЧ.Тип.СодержитТип(Тип("ХранилищеЗначения"))
				И ТаблицаТЧ.Колонки.Найти(РеквизитТЧ.Имя) <> Неопределено Тогда
				СтрокаТЧ[РеквизитТЧ.Имя] = URC_ПортативныеТипы.СоздатьRemoteValueStorage(
					УдаленнаяСсылка, "", КодУзла, ОбъектМетаданных,
					"TablePart", МетаданныеТЧ.Имя, РеквизитТЧ.Имя,
					НомерСтроки, ИдентификаторСтроки, ВерсияДанных);
			КонецЕсли;
		КонецЦикла;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

КонецПроцедуры

Процедура ОчиститьХранилищаНовойТабличнойЧасти(ТаблицаТЧ, МетаданныеТЧ)

	Для Каждого СтрокаТЧ Из ТаблицаТЧ Цикл
		Для Каждого РеквизитТЧ Из МетаданныеТЧ.Реквизиты Цикл
			Если РеквизитТЧ.Тип.СодержитТип(Тип("ХранилищеЗначения")) Тогда
				СтрокаТЧ[РеквизитТЧ.Имя] = Неопределено;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ТабличнаяЧастьСодержитХранилище(МетаданныеТЧ)

	Для Каждого РеквизитТЧ Из МетаданныеТЧ.Реквизиты Цикл
		Если РеквизитТЧ.Тип.СодержитТип(Тип("ХранилищеЗначения")) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура ПроверитьКоллизиюСлужебнойКолонки(МетаданныеТЧ)

	Если МетаданныеТЧ.Реквизиты.Найти("URC__RowId") <> Неопределено Тогда
		ВызватьИсключение "REMOTE_OBJECT_SERVICE_COLUMN_CONFLICT|"
			+ МетаданныеТЧ.Имя + ".URC__RowId";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьВерсиюДанных(Объект, СлужебныеДанные)

	ИсходнаяВерсия = "";
	Если Не СлужебныеДанные.Свойство("DataVersion", ИсходнаяВерсия)
		Или ТипЗнч(ИсходнаяВерсия) <> Тип("Строка")
		Или ИсходнаяВерсия <> URC_Реквизиты.ВерсияДанныхОбъекта(Объект) Тогда
		ВызватьИсключение "OBJECT_CONFLICT|Объект изменен после получения снимка";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьИзменениеХранилища(
	Изменение, ИсходныйДескриптор, Расположение,
	ИмяРеквизита, ИмяТЧ, ИмяКолонки, СлужебныеДанные, КодУзла)

	Если Не URC_ПортативныеТипы.ЭтоИзменениеХранилища(Изменение) Тогда
		ВызватьИсключение "VALUE_STORAGE_CHANGE_REQUIRED|Требуется RemoteValueStorageChange";
	КонецЕсли;
	Действие = "";
	Node = "";
	ConnectionCode = "";
	Если Не Изменение.Свойство("Action", Действие)
		Или (Действие <> "Set" И Действие <> "Clear" И Действие <> "Copy")
		Или Не Изменение.Свойство("Node", Node)
		Или Node <> КодУзла
		Или Не Изменение.Свойство("ConnectionCode", ConnectionCode)
		Или ТипЗнч(ConnectionCode) <> Тип("Строка")
		Или ПустаяСтрока(ConnectionCode) Тогда
		ВызватьИсключение "VALUE_STORAGE_CHANGE_INVALID|Некорректная операция изменения";
	КонецЕсли;

	Основание = Неопределено;
	Изменение.Свойство("Base", Основание);
	Если ИсходныйДескриптор = Неопределено Тогда
		Если Основание <> Неопределено Тогда
			ВызватьИсключение "VALUE_STORAGE_TARGET_MISMATCH|Для нового хранилища Base не допускается";
		КонецЕсли;
	Иначе
		Если Не URC_ПортативныеТипы.ЭтоУдаленноеХранилище(Основание)
			Или Не АдресаХранилищаРавны(Основание, ИсходныйДескриптор) Тогда
			ВызватьИсключение "VALUE_STORAGE_TARGET_MISMATCH|Base не соответствует целевому хранилищу";
		КонецЕсли;
		ПроверитьДескрипторЦелевогоОбъекта(ИсходныйДескриптор, СлужебныеДанные, КодУзла);
	КонецЕсли;

	Если Расположение = "Attribute" Тогда
		ОжидаемоеИмя = ИмяРеквизита;
		ФактическоеИмя = "";
		Если ИсходныйДескриптор <> Неопределено Тогда
			ИсходныйДескриптор.Свойство("Attribute", ФактическоеИмя);
		КонецЕсли;
		Если ИсходныйДескриптор <> Неопределено И ФактическоеИмя <> ОжидаемоеИмя Тогда
			ВызватьИсключение "VALUE_STORAGE_TARGET_MISMATCH|Подменен целевой реквизит";
		КонецЕсли;
	ИначеЕсли ИсходныйДескриптор <> Неопределено Тогда
		ФактическаяТЧ = "";
		ФактическаяКолонка = "";
		ИсходныйДескриптор.Свойство("TablePart", ФактическаяТЧ);
		ИсходныйДескриптор.Свойство("Column", ФактическаяКолонка);
		Если ФактическаяТЧ <> ИмяТЧ Или ФактическаяКолонка <> ИмяКолонки Тогда
			ВызватьИсключение "VALUE_STORAGE_TARGET_MISMATCH|Подменена целевая ячейка";
		КонецЕсли;
	КонецЕсли;

	Если Действие = "Set" И Не Изменение.Свойство("Value") Тогда
		ВызватьИсключение "VALUE_STORAGE_CHANGE_INVALID|Для Set не заполнено Value";
	КонецЕсли;
	Если Действие = "Clear" И ИсходныйДескриптор = Неопределено Тогда
		ВызватьИсключение "VALUE_STORAGE_CHANGE_INVALID|Clear неприменим к новому хранилищу";
	КонецЕсли;
	Источник = Неопределено;
	ЕстьИсточник = Изменение.Свойство("Source", Источник);
	Если Действие = "Copy" Или ЕстьИсточник Тогда
		Если Действие <> "Copy"
			Или Не URC_ПортативныеТипы.ЭтоУдаленноеХранилище(Источник) Тогда
			ВызватьИсключение "VALUE_STORAGE_CHANGE_INVALID|Некорректный Source";
		КонецЕсли;
		NodeИсточника = "";
		ConnectionCodeИсточника = "";
		Источник.Свойство("Node", NodeИсточника);
		Источник.Свойство("ConnectionCode", ConnectionCodeИсточника);
		Если NodeИсточника <> КодУзла
			Или ConnectionCodeИсточника <> ConnectionCode Тогда
			ВызватьИсключение "VALUE_STORAGE_CHANGE_INVALID|Source принадлежит другому узлу";
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьДескрипторЦелевогоОбъекта(Дескриптор, СлужебныеДанные, КодУзла)

	Metadata = "";
	Node = "";
	Reference = Неопределено;
	Если Не Дескриптор.Свойство("Metadata", Metadata)
		Или Metadata <> СлужебныеДанные.Metadata
		Или Не Дескриптор.Свойство("Node", Node)
		Или Node <> КодУзла
		Или Не Дескриптор.Свойство("Reference", Reference)
		Или Не ЗначенияРавны(Reference, СлужебныеДанные.Reference) Тогда
		ВызватьИсключение "VALUE_STORAGE_TARGET_MISMATCH|Дескриптор относится к другому объекту";
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьНовоеХранилище(
	Изменение, ИсходныйДескриптор, Расположение,
	ИмяРеквизита, ИмяТЧ, ИмяКолонки, СлужебныеДанные, КодУзла)

	ПроверитьИзменениеХранилища(
		Изменение, ИсходныйДескриптор, Расположение,
		ИмяРеквизита, ИмяТЧ, ИмяКолонки, СлужебныеДанные, КодУзла);
	Если Изменение.Action = "Clear" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Изменение.Action = "Copy" Тогда
		АдресИсточника = URC_Реквизиты.ПолучитьАдресХранилища(
			Изменение.Source, КодУзла, Истина);
		Возврат АдресИсточника.Storage;
	КонецЕсли;
	Содержимое = URC_ПортативныеТипы.ВосстановитьСодержимоеХранилища(
		Изменение.Value, КодУзла);
	Возврат Новый ХранилищеЗначения(Содержимое);

КонецФункции

Функция АдресаХранилищаРавны(Адрес1, Адрес2)

	Для Каждого ИмяПоля Из СтрРазделить(
		"Node,Metadata,Location,Attribute,TablePart,Column,RowNumber,RowId,DataVersion", ",") Цикл
		Значение1 = Неопределено;
		Значение2 = Неопределено;
		Есть1 = Адрес1.Свойство(ИмяПоля, Значение1);
		Есть2 = Адрес2.Свойство(ИмяПоля, Значение2);
		Если Есть1 <> Есть2 Или (Есть1 И Значение1 <> Значение2) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Ссылка1 = Неопределено;
	Ссылка2 = Неопределено;
	Возврат Адрес1.Свойство("Reference", Ссылка1)
		И Адрес2.Свойство("Reference", Ссылка2)
		И ЗначенияРавны(Ссылка1, Ссылка2);

КонецФункции

Функция ПодсчитатьИзмененияХранилища(Изменения)

	Результат = Новый Структура("Total,Clear,Copy", 0, 0, 0);
	Для Каждого Реквизит Из Изменения.Attributes Цикл
		УчестьИзменениеХранилища(Результат, Реквизит.Значение);
	КонецЦикла;
	Для Каждого ТабличнаяЧасть Из Изменения.TableParts Цикл
		Для Каждого СтрокаТЧ Из ТабличнаяЧасть.Значение Цикл
			Для Каждого Колонка Из ТабличнаяЧасть.Значение.Колонки Цикл
				УчестьИзменениеХранилища(Результат, СтрокаТЧ[Колонка.Имя]);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура УчестьИзменениеХранилища(Результат, Значение)

	Если Не URC_ПортативныеТипы.ЭтоИзменениеХранилища(Значение) Тогда
		Возврат;
	КонецЕсли;
	Результат.Total = Результат.Total + 1;
	Если Значение.Action = "Clear" Тогда
		Результат.Clear = Результат.Clear + 1;
	ИначеЕсли Значение.Action = "Copy" Тогда
		Результат.Copy = Результат.Copy + 1;
	КонецЕсли;

КонецПроцедуры

Функция ПодготовитьТаблицуДляЗагрузки(ИсходнаяТаблица, МетаданныеТЧ, КодУзла, ИмяТЧ)

	Результат = Новый ТаблицаЗначений;
	ИменаКолонокДляЗагрузки = Новый Массив;
	Для Каждого Колонка Из ИсходнаяТаблица.Колонки Цикл
		// Номер строки назначается платформой по порядку строк табличной части.
		Если Колонка.Имя = "НомерСтроки" Тогда
			Продолжить;
		КонецЕсли;
		Если МетаданныеТЧ.Реквизиты.Найти(Колонка.Имя) = Неопределено Тогда
			ВызватьИсключение "TABLE_PART_COLUMN_NOT_FOUND|" + ИмяТЧ + "." + Колонка.Имя;
		КонецЕсли;
		Результат.Колонки.Добавить(Колонка.Имя);
		ИменаКолонокДляЗагрузки.Добавить(Колонка.Имя);
	КонецЦикла;

	Для Каждого ИсходнаяСтрока Из ИсходнаяТаблица Цикл
		НоваяСтрока = Результат.Добавить();
		Для Каждого ИмяКолонки Из ИменаКолонокДляЗагрузки Цикл
			НоваяСтрока[ИмяКолонки] = URC_ПортативныеТипы.ВосстановитьЗначениеДляЗаписи(
				ИсходнаяСтрока[ИмяКолонки], КодУзла);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ВыполнитьШтатнуюЗапись(Объект, ОбъектМетаданных, РежимЗаписи)

	Попытка
		Если СтрНачинаетсяС(ОбъектМетаданных.ПолноеИмя(), "Документ.") Тогда
			Если РежимЗаписи = URC_Протокол.РежимЗаписиОбъекта() Тогда
				Объект.Записать(РежимЗаписиДокумента.Запись);
			ИначеЕсли РежимЗаписи = URC_Протокол.РежимПроведенияОбъекта() Тогда
				Объект.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
		Иначе
			Если РежимЗаписи <> URC_Протокол.РежимЗаписиОбъекта() Тогда
				ВызватьИсключение "WRITE_MODE_NOT_SUPPORTED|Режим применим только к документам";
			КонецЕсли;
			Объект.Записать();
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Если СтрНайти(ТекстОшибки, "WRITE_MODE_NOT_SUPPORTED|") > 0 Тогда
			ВызватьИсключение ТекстОшибки;
		КонецЕсли;
		ВызватьИсключение "OBJECT_WRITE_ERROR|" + ТекстОшибки;
	КонецПопытки;

КонецПроцедуры

Функция НормализоватьРежимЗаписи(РежимЗаписи)

	Режим = НРег(СокрЛП(Строка(РежимЗаписи)));
	Если Режим = "запись" Или Режим = "write" Тогда
		Возврат URC_Протокол.РежимЗаписиОбъекта();
	КонецЕсли;
	Если Режим = "проведение" Или Режим = "post" Тогда
		Возврат URC_Протокол.РежимПроведенияОбъекта();
	КонецЕсли;
	Если Режим = "отменапроведения" Или Режим = "unpost" Тогда
		Возврат URC_Протокол.РежимОтменыПроведенияОбъекта();
	КонецЕсли;
	ВызватьИсключение "WRITE_MODE_NOT_SUPPORTED|Неизвестный режим записи";

КонецФункции

Функция ЭтоРедактируемыйРеквизит(ИмяРеквизита)

	Нередактируемые = ",Ссылка,ВерсияДанных,ПометкаУдаления,Проведен,ЭтоГруппа,Предопределенный,ИмяПредопределенныхДанных,";
	Возврат СтрНайти(Нередактируемые, "," + ИмяРеквизита + ",") = 0;

КонецФункции

Функция ЗначенияРавны(Значение1, Значение2)

	Попытка
		Возврат URC_СериализацияXDTO.СериализоватьВJSON(Значение1)
			= URC_СериализацияXDTO.СериализоватьВJSON(Значение2);
	Исключение
		ВызватьИсключение "REMOTE_OBJECT_INVALID|Не удалось сравнить снимок объекта";
	КонецПопытки;

КонецФункции

Функция ГлубокаяКопия(Значение)

	Возврат URC_СериализацияXDTO.ДесериализоватьИзJSON(
		URC_СериализацияXDTO.СериализоватьВJSON(Значение));

КонецФункции

#КонецОбласти
