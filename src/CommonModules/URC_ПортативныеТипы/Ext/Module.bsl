
#Область ПрограммныйИнтерфейс

Функция ЭтоУдаленнаяСсылка(Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	URCType = Неопределено;
	Возврат Значение.Свойство("URCType", URCType) И URCType = "RemoteReference";

КонецФункции

Функция ЭтоУдаленноеПеречисление(Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	URCType = Неопределено;
	Возврат Значение.Свойство("URCType", URCType) И URCType = "RemoteEnum";

КонецФункции

Функция ЭтоУдаленноеХранилище(Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	URCType = Неопределено;
	Если Не Значение.Свойство("URCType", URCType)
		Или URCType <> "RemoteValueStorage" Тогда
		Возврат Ложь;
	КонецЕсли;

	ЭтоХранилище = Истина;
	Если Значение.Свойство("ЭтоХранилище", ЭтоХранилище)
		И ТипЗнч(ЭтоХранилище) <> Тип("Булево") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ЭтоХранилище;

КонецФункции

Функция ЭтоRemoteBinaryData(Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	URCType = Неопределено;
	Возврат Значение.Свойство("URCType", URCType) И URCType = "RemoteBinaryData";

КонецФункции

Функция ЭтоИзменениеХранилища(Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	URCType = Неопределено;
	Возврат Значение.Свойство("URCType", URCType)
		И URCType = "RemoteValueStorageChange";

КонецФункции

Функция СоздатьRemoteValueStorage(
	УдаленнаяСсылка,
	ИмяРеквизита,
	КодУзла,
	ОбъектМетаданных,
	Расположение = "Attribute",
	ИмяТабличнойЧасти = "",
	ИмяКолонки = "",
	НомерСтроки = Неопределено,
	ИдентификаторСтроки = Неопределено,
	ВерсияДанных = "") Экспорт

	Результат = Новый Структура;
	Результат.Вставить("URCType", "RemoteValueStorage");
	Результат.Вставить("ЭтоХранилище", Истина);
	Результат.Вставить("Node", КодУзла);
	Результат.Вставить("Metadata", ОбъектМетаданных.ПолноеИмя());
	Результат.Вставить("Reference", УдаленнаяСсылка);
	Результат.Вставить("Location", Расположение);
	Если Расположение = "Attribute" Тогда
		Результат.Вставить("Attribute", ИмяРеквизита);
	ИначеЕсли Расположение = "TablePart" Тогда
		Результат.Вставить("TablePart", ИмяТабличнойЧасти);
		Результат.Вставить("Column", ИмяКолонки);
		Результат.Вставить("RowNumber", НомерСтроки);
		Если ИдентификаторСтроки <> Неопределено Тогда
			Результат.Вставить("RowId", ИдентификаторСтроки);
		КонецЕсли;
	Иначе
		ВызватьИсключение "VALUE_STORAGE_INVALID|Неизвестное расположение ХранилищеЗначения";
	КонецЕсли;
	Если Не ПустаяСтрока(ВерсияДанных) Тогда
		Результат.Вставить("DataVersion", ВерсияДанных);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция СоздатьRemoteValueStorageChange(
	Действие,
	Основание = Неопределено,
	НовоеЗначение = Неопределено,
	Источник = Неопределено) Экспорт

	Если Действие <> "Set" И Действие <> "Clear" И Действие <> "Copy" Тогда
		ВызватьИсключение "VALUE_STORAGE_CHANGE_INVALID|Неизвестное действие с ХранилищеЗначения";
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("URCType", "RemoteValueStorageChange");
	Результат.Вставить("Action", Действие);
	Если Основание <> Неопределено Тогда
		Результат.Вставить("Base", Основание);
	КонецЕсли;
	Если Действие = "Set" Тогда
		Результат.Вставить("Value", НовоеЗначение);
	ИначеЕсли Действие = "Copy" Тогда
		Результат.Вставить("Source", Источник);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция НормализоватьСодержимоеХранилища(Значение, КодУзла) Экспорт

	Возврат НормализоватьЗначение(Значение, КодУзла, Истина);

КонецФункции

Функция ПодготовитьИзмененияХранилища(Значение, КодУзла, ConnectionCode) Экспорт

	Если ЭтоИзменениеХранилища(Значение) Тогда
		Действие = "";
		Если Не Значение.Свойство("Action", Действие)
			Или (Действие <> "Set" И Действие <> "Clear" И Действие <> "Copy") Тогда
			ВызватьИсключение "VALUE_STORAGE_CHANGE_INVALID|Некорректное действие с ХранилищеЗначения";
		КонецЕсли;

		Результат = Новый Структура;
		Результат.Вставить("URCType", "RemoteValueStorageChange");
		Результат.Вставить("Action", Действие);
		Результат.Вставить("Node", КодУзла);
		Результат.Вставить("ConnectionCode", ConnectionCode);

		Основание = Неопределено;
		Если Значение.Свойство("Base", Основание) Тогда
			Если Не ЭтоУдаленноеХранилище(Основание) Тогда
				ВызватьИсключение "VALUE_STORAGE_CHANGE_INVALID|Base должен быть RemoteValueStorage";
			КонецЕсли;
			Результат.Вставить("Base", Основание);
		КонецЕсли;

		Если Действие = "Set" Тогда
			НовоеЗначение = Неопределено;
			Если Не Значение.Свойство("Value", НовоеЗначение) Тогда
				ВызватьИсключение "VALUE_STORAGE_CHANGE_INVALID|Для Set не заполнено Value";
			КонецЕсли;
			Результат.Вставить(
				"Value", НормализоватьСодержимоеХранилища(НовоеЗначение, КодУзла));
		ИначеЕсли Действие = "Clear" Тогда
			Если Основание = Неопределено Тогда
				ВызватьИсключение "VALUE_STORAGE_CHANGE_INVALID|Для Clear не заполнено Base";
			КонецЕсли;
		Иначе
			Источник = Неопределено;
			Если Не Значение.Свойство("Source", Источник)
				Или Не ЭтоУдаленноеХранилище(Источник) Тогда
				ВызватьИсключение "VALUE_STORAGE_CHANGE_INVALID|Для Copy не заполнен Source";
			КонецЕсли;
			Результат.Вставить("Source", Источник);
		КонецЕсли;

		Возврат Результат;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого Элемент Из Значение Цикл
			Результат.Вставить(
				Элемент.Ключ,
				ПодготовитьИзмененияХранилища(Элемент.Значение, КодУзла, ConnectionCode));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Если ТипЗначения = Тип("Массив")
		Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(
				ПодготовитьИзмененияХранилища(Элемент, КодУзла, ConnectionCode));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Результат = Новый ТаблицаЗначений;
		Для Каждого Колонка Из Значение.Колонки Цикл
			Результат.Колонки.Добавить(Колонка.Имя, , Колонка.Заголовок);
		КонецЦикла;
		Для Каждого ИсходнаяСтрока Из Значение Цикл
			НоваяСтрока = Результат.Добавить();
			Для Каждого Колонка Из Значение.Колонки Цикл
				НоваяСтрока[Колонка.Имя] = ПодготовитьИзмененияХранилища(
					ИсходнаяСтрока[Колонка.Имя], КодУзла, ConnectionCode);
			КонецЦикла;
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция ВосстановитьСодержимоеХранилища(Значение, КодТекущегоУзла) Экспорт

	Если ЭтоRemoteBinaryData(Значение) Тогда
		Возврат ВосстановитьRemoteBinaryData(Значение);
	КонецЕсли;
	Если ЭтоУдаленнаяСсылка(Значение) Тогда
		Возврат ВосстановитьRemoteReference(Значение, КодТекущегоУзла);
	КонецЕсли;
	Если ЭтоУдаленноеПеречисление(Значение) Тогда
		Возврат ВосстановитьRemoteEnum(Значение, КодТекущегоУзла);
	КонецЕсли;
	Если ЭтоУдаленноеХранилище(Значение) Или ЭтоИзменениеХранилища(Значение) Тогда
		ВызватьИсключение "VALUE_STORAGE_CONTENT_UNSUPPORTED|Вложенное ХранилищеЗначения не поддерживается";
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Дата")
		Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("УникальныйИдентификатор")
		Или ТипЗначения = Тип("Неопределено")
		Или ТипЗначения = Тип("Null") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого Элемент Из Значение Цикл
			Результат.Вставить(
				Элемент.Ключ,
				ВосстановитьСодержимоеХранилища(Элемент.Значение, КодТекущегоУзла));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Если ТипЗначения = Тип("Массив")
		Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(
				ВосстановитьСодержимоеХранилища(Элемент, КодТекущегоУзла));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Результат = Новый ТаблицаЗначений;
		Для Каждого Колонка Из Значение.Колонки Цикл
			Результат.Колонки.Добавить(Колонка.Имя, , Колонка.Заголовок);
		КонецЦикла;
		Для Каждого ИсходнаяСтрока Из Значение Цикл
			НоваяСтрока = Результат.Добавить();
			Для Каждого Колонка Из Значение.Колонки Цикл
				НоваяСтрока[Колонка.Имя] = ВосстановитьСодержимоеХранилища(
					ИсходнаяСтрока[Колонка.Имя], КодТекущегоУзла);
			КонецЦикла;
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	ВызватьИсключение "VALUE_STORAGE_CONTENT_UNSUPPORTED|Неподдерживаемый тип содержимого ХранилищеЗначения";

КонецФункции

Функция ВосстановитьRemoteBinaryData(Значение) Экспорт

	Если ЭтоRemoteBinaryData(Значение) Тогда
		Кодировка = "";
		Размер = -1;
		Данные = Неопределено;
		Если Не Значение.Свойство("Encoding", Кодировка)
			Или НРег(Кодировка) <> "base64"
			Или Не Значение.Свойство("Size", Размер)
			Или ТипЗнч(Размер) <> Тип("Число")
			Или Размер < 0
			Или Не Значение.Свойство("Data", Данные)
			Или ТипЗнч(Данные) <> Тип("Строка") Тогда
			ВызватьИсключение "VALUE_STORAGE_CONTENT_UNSUPPORTED|Некорректный RemoteBinaryData";
		КонецЕсли;

		Попытка
			Результат = ПолучитьДвоичныеДанныеИзBase64Строки(Данные);
		Исключение
			ВызватьИсключение "VALUE_STORAGE_CONTENT_UNSUPPORTED|Ошибка декодирования RemoteBinaryData";
		КонецПопытки;
		Если Результат.Размер() <> Размер Тогда
			ВызватьИсключение "VALUE_STORAGE_CONTENT_UNSUPPORTED|Размер RemoteBinaryData не совпадает с данными";
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого Элемент Из Значение Цикл
			Результат.Вставить(Элемент.Ключ, ВосстановитьRemoteBinaryData(Элемент.Значение));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("Массив")
		Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ВосстановитьRemoteBinaryData(Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Результат = Новый ТаблицаЗначений;
		Для Каждого Колонка Из Значение.Колонки Цикл
			Результат.Колонки.Добавить(Колонка.Имя, , Колонка.Заголовок);
		КонецЦикла;
		Для Каждого ИсходнаяСтрока Из Значение Цикл
			НоваяСтрока = Результат.Добавить();
			Для Каждого Колонка Из Значение.Колонки Цикл
				НоваяСтрока[Колонка.Имя] = ВосстановитьRemoteBinaryData(
					ИсходнаяСтрока[Колонка.Имя]);
			КонецЦикла;
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция НормализоватьЗначение(Значение, КодУзла, ЭтоСодержимоеХранилища = Ложь) Экспорт

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Дата")
		Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("УникальныйИдентификатор")
		Или ТипЗначения = Тип("Неопределено")
		Или ТипЗначения = Тип("Null") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ЭтоСодержимоеХранилища
		И (ЭтоУдаленноеХранилище(Значение) Или ЭтоИзменениеХранилища(Значение)) Тогда
		ВызватьИсключение "VALUE_STORAGE_CONTENT_UNSUPPORTED|"
			+ НСтр("ru = 'Вложенное ХранилищеЗначения не поддерживается'; en = 'Nested ValueStorage is not supported'");
	КонецЕсли;

	Если ЭтоУдаленнаяСсылка(Значение)
		Или ЭтоУдаленноеПеречисление(Значение)
		Или ЭтоRemoteBinaryData(Значение)
		Или ЭтоУдаленноеХранилище(Значение)
		Или ЭтоИзменениеХранилища(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Если ЭтоСодержимоеХранилища И ТипЗначения = Тип("ХранилищеЗначения") Тогда
		ВызватьИсключение "VALUE_STORAGE_CONTENT_UNSUPPORTED|"
			+ НСтр("ru = 'Вложенное ХранилищеЗначения не поддерживается'; en = 'Nested ValueStorage is not supported'");
	КонецЕсли;

	Если ЭтоСодержимоеХранилища И ТипЗначения = Тип("ДвоичныеДанные") Тогда
		Возврат СоздатьRemoteBinaryData(Значение);
	КонецЕсли;

	Если ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого Элемент Из Значение Цикл
			Результат.Вставить(
				Элемент.Ключ,
				НормализоватьЗначение(Элемент.Значение, КодУзла, ЭтоСодержимоеХранилища));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("Массив")
		Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(
				НормализоватьЗначение(Элемент, КодУзла, ЭтоСодержимоеХранилища));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Возврат НормализоватьТаблицуЗначений(
			Значение, КодУзла, ЭтоСодержимоеХранилища);
	КонецЕсли;

	// Вложенный РезультатЗапроса (поле-табличная часть в ВыполнитьЗапрос) структурно
	// преобразуется в ТаблицаЗначений и нормализуется на любой глубине.
	Если ТипЗначения = Тип("РезультатЗапроса") Тогда
		Возврат НормализоватьТаблицуЗначений(
			Значение.Выгрузить(), КодУзла, ЭтоСодержимоеХранилища);
	КонецЕсли;

	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
	Если ОбъектМетаданных <> Неопределено Тогда
		ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		Если СтрНачинаетсяС(ПолноеИмя, "Перечисление.") Тогда
			Возврат СоздатьRemoteEnum(Значение, КодУзла, ОбъектМетаданных);
		КонецЕсли;

		Если ЭтоПоддерживаемоеПолноеИмяСсылки(ПолноеИмя) Тогда
			Возврат СоздатьRemoteReference(Значение, КодУзла, ОбъектМетаданных);
		КонецЕсли;
	КонецЕсли;

	Если ЭтоСодержимоеХранилища Тогда
		ВызватьИсключение "VALUE_STORAGE_CONTENT_UNSUPPORTED|"
			+ НСтр("ru = 'Неподдерживаемый тип содержимого ХранилищеЗначения'; en = 'Unsupported ValueStorage content type'")
			+ ": " + Строка(ТипЗначения);
	Иначе
		ВызватьИсключение "UNSUPPORTED_RESULT_TYPE|"
			+ НСтр("ru = 'Неподдерживаемый тип результата'; en = 'Unsupported result type'")
			+ ": " + Строка(ТипЗначения);
	КонецЕсли;

КонецФункции

// Только структурная нормализация (РезультатЗапроса → ТаблицаЗначений)
// без Portable-преобразования значений. Используется в режиме native-xdto, где ссылки
// и перечисления должны остаться нативными, но вложенный РезультатЗапроса всё равно
// не может быть передан клиенту как есть и структурно преобразуется в ТаблицаЗначений.
Функция СтруктурнаяНормализация(Значение) Экспорт

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("РезультатЗапроса") Тогда
		Возврат СтруктурноНормализоватьТаблицуЗначений(Значение.Выгрузить());
	КонецЕсли;

	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Возврат СтруктурноНормализоватьТаблицуЗначений(Значение);
	КонецЕсли;

	Если ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого Элемент Из Значение Цикл
			Результат.Вставить(Элемент.Ключ, СтруктурнаяНормализация(Элемент.Значение));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(СтруктурнаяНормализация(Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Скаляры, ссылки, перечисления и любые другие типы в native-xdto передаются как есть.
	Возврат Значение;

КонецФункции

Функция ПодготовитьПараметры(
	Параметры,
	КодЦелевогоУзла,
	ConnectionCode = Неопределено) Экспорт

	Если Параметры = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Параметры) <> Тип("Структура")
		И ТипЗнч(Параметры) <> Тип("ФиксированнаяСтруктура") Тогда
		ВызватьИсключение "UNSUPPORTED_PARAMETER_TYPE|"
			+ НСтр("ru = 'Parameters должен иметь тип Структура'; en = 'Parameters must be a Structure'");
	КонецЕсли;
	Если ConnectionCode <> Неопределено Тогда
		ПроверитьКонтекстСоединения(
			Параметры, ConnectionCode, КодЦелевогоУзла);
	КонецЕсли;

	Результат = Новый Структура;
	Для Каждого Параметр Из Параметры Цикл
		Результат.Вставить(
			Параметр.Ключ, ПодготовитьПараметр(Параметр.Значение, КодЦелевогоУзла));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПривязатьКонтекстСоединения(
	Значение,
	ConnectionCode,
	ОжидаемыйNode) Экспорт

	ПроверитьКодСоединенияИУзел(ConnectionCode, ОжидаемыйNode);
	Возврат ОбработатьКонтекстСоединения(
		Значение, СокрЛП(ConnectionCode), СокрЛП(ОжидаемыйNode), Истина);

КонецФункции

Процедура ПроверитьКонтекстСоединения(
	Значение,
	ConnectionCode,
	ОжидаемыйNode) Экспорт

	ПроверитьКодСоединенияИУзел(ConnectionCode, ОжидаемыйNode);
	ОбработатьКонтекстСоединения(
		Значение, СокрЛП(ConnectionCode), СокрЛП(ОжидаемыйNode), Ложь);

КонецПроцедуры

Функция ОбработатьКонтекстСоединения(
	Значение,
	ConnectionCode,
	ОжидаемыйNode,
	Привязывать)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Если ЭтоRemoteBinaryData(Значение) Тогда
			Возврат Значение;
		КонецЕсли;

		URCType = "";
		ЭтоКонтекстныйТип = Значение.Свойство("URCType", URCType)
			И СтрНайти(
				",RemoteReference,RemoteEnum,RemoteValueStorage,RemoteValueStorageChange,RemoteObjectData,",
				"," + Строка(URCType) + ",") > 0;
		Если ЭтоКонтекстныйТип Тогда
			Если URCType = "RemoteValueStorageChange" И Привязывать Тогда
				NodeИзменения = "";
				Если Значение.Свойство("Node", NodeИзменения) Тогда
					Если ТипЗнч(NodeИзменения) <> Тип("Строка")
						Или (Не ПустаяСтрока(NodeИзменения)
						И СокрЛП(NodeИзменения) <> ОжидаемыйNode) Тогда
						ВызватьИсключение "REFERENCE_NODE_INVALID|Изменение относится к другому узлу";
					КонецЕсли;
				КонецЕсли;
			Иначе
				ПроверитьNodeКонтекстногоЗначения(Значение, ОжидаемыйNode);
			КонецЕсли;
			КодВЗначении = "";
			ЕстьКод = Значение.Свойство("ConnectionCode", КодВЗначении)
				И ТипЗнч(КодВЗначении) = Тип("Строка")
				И Не ПустаяСтрока(СокрЛП(КодВЗначении));
			Если ЕстьКод И СокрЛП(КодВЗначении) <> ConnectionCode Тогда
				ВызватьИсключение "REMOTE_CONNECTION_MISMATCH|"
					+ НСтр("ru = 'Значение относится к другому соединению'; en = 'Value belongs to another connection'");
			КонецЕсли;
			Если Не ЕстьКод И Не Привязывать Тогда
				ВызватьИсключение "REMOTE_CONNECTION_REQUIRED|"
					+ НСтр("ru = 'В удаленном значении отсутствует ConnectionCode'; en = 'Remote value has no ConnectionCode'");
			КонецЕсли;
		КонецЕсли;

		Результат = Новый Структура;
		Для Каждого Элемент Из Значение Цикл
			Если Элемент.Ключ = "ConnectionCode" И ЭтоКонтекстныйТип Тогда
				Продолжить;
			КонецЕсли;
			Если Элемент.Ключ = "Node" И URCType = "RemoteValueStorageChange" И Привязывать Тогда
				Продолжить;
			КонецЕсли;
			Результат.Вставить(
				Элемент.Ключ,
				ОбработатьКонтекстСоединения(
					Элемент.Значение, ConnectionCode, ОжидаемыйNode, Привязывать));
		КонецЦикла;
		Если ЭтоКонтекстныйТип Тогда
			Если URCType = "RemoteValueStorageChange" И Привязывать Тогда
				Результат.Вставить("Node", ОжидаемыйNode);
			КонецЕсли;
			Результат.Вставить("ConnectionCode", ConnectionCode);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("Массив")
		Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ОбработатьКонтекстСоединения(
				Элемент, ConnectionCode, ОжидаемыйNode, Привязывать));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Результат = Новый ТаблицаЗначений;
		Для Каждого Колонка Из Значение.Колонки Цикл
			Результат.Колонки.Добавить(Колонка.Имя, , Колонка.Заголовок);
		КонецЦикла;
		Для Каждого ИсходнаяСтрока Из Значение Цикл
			НоваяСтрока = Результат.Добавить();
			Для Каждого Колонка Из Значение.Колонки Цикл
				НоваяСтрока[Колонка.Имя] = ОбработатьКонтекстСоединения(
					ИсходнаяСтрока[Колонка.Имя],
					ConnectionCode,
					ОжидаемыйNode,
					Привязывать);
			КонецЦикла;
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Процедура ПроверитьКодСоединенияИУзел(ConnectionCode, ОжидаемыйNode)

	Если ТипЗнч(ConnectionCode) <> Тип("Строка")
		Или ПустаяСтрока(СокрЛП(ConnectionCode)) Тогда
		ВызватьИсключение "REMOTE_CONNECTION_REQUIRED|"
			+ НСтр("ru = 'Не заполнен ConnectionCode'; en = 'ConnectionCode is required'");
	КонецЕсли;
	Если ТипЗнч(ОжидаемыйNode) <> Тип("Строка")
		Или ПустаяСтрока(СокрЛП(ОжидаемыйNode)) Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Не заполнен ожидаемый Node'; en = 'Expected Node is required'");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьNodeКонтекстногоЗначения(Значение, ОжидаемыйNode)

	Node = "";
	Если Не Значение.Свойство("Node", Node)
		Или ТипЗнч(Node) <> Тип("Строка")
		Или ПустаяСтрока(СокрЛП(Node)) Тогда
		ВызватьИсключение "BAD_REQUEST|Удаленное значение не содержит Node";
	КонецЕсли;
	Если СокрЛП(Node) <> ОжидаемыйNode Тогда
		ВызватьИсключение "REMOTE_CONNECTION_MISMATCH|"
			+ НСтр("ru = 'Удаленное значение относится к другому Node'; en = 'Remote value belongs to another Node'");
	КонецЕсли;

КонецПроцедуры

Функция НормализоватьТаблицуЗначений(
	ИсходнаяТаблица,
	КодУзла,
	ЭтоСодержимоеХранилища)

	Результат = Новый ТаблицаЗначений;
	Для Каждого Колонка Из ИсходнаяТаблица.Колонки Цикл
		Результат.Колонки.Добавить(Колонка.Имя, , Колонка.Заголовок);
	КонецЦикла;

	Для Каждого ИсходнаяСтрока Из ИсходнаяТаблица Цикл
		НоваяСтрока = Результат.Добавить();
		Для Каждого Колонка Из ИсходнаяТаблица.Колонки Цикл
			НоваяСтрока[Колонка.Имя] = НормализоватьЗначение(
				ИсходнаяСтрока[Колонка.Имя], КодУзла, ЭтоСодержимоеХранилища);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Структурный аналог НормализоватьТаблицуЗначений для СтруктурнаяНормализация,
// пересобирает ТаблицаЗначений с теми же колонками, рекурсивно преобразуя только вложенный РезультатЗапроса.
Функция СтруктурноНормализоватьТаблицуЗначений(ИсходнаяТаблица)

	Результат = Новый ТаблицаЗначений;
	Для Каждого Колонка Из ИсходнаяТаблица.Колонки Цикл
		Результат.Колонки.Добавить(Колонка.Имя, , Колонка.Заголовок);
	КонецЦикла;

	Для Каждого ИсходнаяСтрока Из ИсходнаяТаблица Цикл
		НоваяСтрока = Результат.Добавить();
		Для Каждого Колонка Из ИсходнаяТаблица.Колонки Цикл
			НоваяСтрока[Колонка.Имя] = СтруктурнаяНормализация(ИсходнаяСтрока[Колонка.Имя]);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СоздатьRemoteReference(Ссылка, КодУзла, ОбъектМетаданных)

	Результат = Новый Структура;
	Результат.Вставить("URCType", "RemoteReference");
	Результат.Вставить("Node", КодУзла);
	Результат.Вставить("Metadata", ОбъектМетаданных.ПолноеИмя());
	Результат.Вставить("UUID", Ссылка.УникальныйИдентификатор());
	Результат.Вставить("Presentation", Строка(Ссылка));
	Результат.Вставить("Empty", Ссылка.Пустая());
	Возврат Результат;

КонецФункции

Функция СоздатьRemoteEnum(Значение, КодУзла, ОбъектМетаданных)

	Результат = Новый Структура;
	Результат.Вставить("URCType", "RemoteEnum");
	Результат.Вставить("Node", КодУзла);
	Результат.Вставить("Metadata", ОбъектМетаданных.ПолноеИмя());
	Результат.Вставить("ValueName", XMLСтрока(Значение));
	Результат.Вставить("Presentation", Строка(Значение));
	Возврат Результат;

КонецФункции

Функция СоздатьRemoteBinaryData(Значение)

	СтрокаBase64 = ПолучитьBase64СтрокуИзДвоичныхДанных(Значение);
	СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ВК, "");
	СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ПС, "");

	Результат = Новый Структура;
	Результат.Вставить("URCType", "RemoteBinaryData");
	Результат.Вставить("Encoding", "base64");
	Результат.Вставить("Size", Значение.Размер());
	Результат.Вставить("Data", СтрокаBase64);
	Возврат Результат;

КонецФункции

Функция ВосстановитьRemoteReference(УдаленнаяСсылка, КодТекущегоУзла, ПроверятьСуществование = Истина) Экспорт

	Если Не ЭтоУдаленнаяСсылка(УдаленнаяСсылка) Тогда
		ВызватьИсключение "BAD_REQUEST|Ожидается RemoteReference";
	КонецЕсли;

	Node = Неопределено;
	MetadataName = Неопределено;
	UUID = Неопределено;
	ПустаяСсылка = Ложь;
	Если Не УдаленнаяСсылка.Свойство("Node", Node)
		Или Не УдаленнаяСсылка.Свойство("Metadata", MetadataName)
		Или Не УдаленнаяСсылка.Свойство("UUID", UUID) Тогда
		ВызватьИсключение "BAD_REQUEST|RemoteReference не содержит Node, Metadata или UUID";
	КонецЕсли;
	УдаленнаяСсылка.Свойство("Empty", ПустаяСсылка);
	Если ТипЗнч(ПустаяСсылка) <> Тип("Булево") Тогда
		ВызватьИсключение "BAD_REQUEST|Некорректный признак Empty у RemoteReference";
	КонецЕсли;

	Если Node <> КодТекущегоУзла Тогда
		ВызватьИсключение "REMOTE_REFERENCE_WRONG_NODE|RemoteReference принадлежит другому узлу";
	КонецЕсли;

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(MetadataName);
	Если ОбъектМетаданных = Неопределено Или Не ЭтоПоддерживаемоеПолноеИмяСсылки(MetadataName) Тогда
		ВызватьИсключение "REMOTE_REFERENCE_TYPE_NOT_FOUND|Не найден поддерживаемый объект метаданных " + MetadataName;
	КонецЕсли;

	Если ТипЗнч(UUID) = Тип("Строка") Тогда
		Попытка
			UUID = Новый УникальныйИдентификатор(UUID);
		Исключение
			ВызватьИсключение "BAD_REQUEST|Некорректный UUID RemoteReference";
		КонецПопытки;
	ИначеЕсли ТипЗнч(UUID) <> Тип("УникальныйИдентификатор") Тогда
		ВызватьИсключение "BAD_REQUEST|Некорректный UUID RemoteReference";
	КонецЕсли;

	Ссылка = ПолучитьСсылкуПоПолномуИмени(MetadataName, UUID);
	Если ПроверятьСуществование И Не ПустаяСсылка Тогда
		Попытка
			Ссылка.ПолучитьОбъект();
		Исключение
			ВызватьИсключение "REMOTE_REFERENCE_NOT_FOUND|Объект RemoteReference не найден";
		КонецПопытки;
	КонецЕсли;

	Возврат Ссылка;

КонецФункции

Функция ВосстановитьПараметр(Значение, КодТекущегоУзла) Экспорт

	Если ЭтоУдаленнаяСсылка(Значение) Тогда
		Возврат ВосстановитьRemoteReference(Значение, КодТекущегоУзла);
	КонецЕсли;
	Если ЭтоУдаленноеПеречисление(Значение) Тогда
		ВызватьИсключение "UNSUPPORTED_PARAMETER_TYPE|"
			+ НСтр("ru = 'RemoteEnum не поддерживается как параметр P0'; en = 'RemoteEnum is not supported as a P0 parameter'");
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Дата")
		Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("УникальныйИдентификатор")
		Или ТипЗначения = Тип("Неопределено")
		Или ТипЗначения = Тип("Null") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗначения = Тип("Структура")
		Или ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого Элемент Из Значение Цикл
			Результат.Вставить(Элемент.Ключ, ВосстановитьПараметр(Элемент.Значение, КодТекущегоУзла));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Массив")
		Или ТипЗнч(Значение) = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ВосстановитьПараметр(Элемент, КодТекущегоУзла));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	ВызватьИсключение "UNSUPPORTED_PARAMETER_TYPE|"
		+ НСтр("ru = 'Неподдерживаемый тип параметра'; en = 'Unsupported parameter type'")
		+ ": " + Строка(ТипЗначения);

КонецФункции

Функция ВосстановитьЗначениеДляЗаписи(Значение, КодТекущегоУзла) Экспорт

	Если ЭтоУдаленнаяСсылка(Значение) Тогда
		УзелСсылки = "";
		Если Не Значение.Свойство("Node", УзелСсылки)
			Или УзелСсылки <> КодТекущегоУзла Тогда
			ВызватьИсключение "REFERENCE_NODE_INVALID|"
				+ НСтр("ru = 'RemoteReference принадлежит другому узлу'; en = 'RemoteReference belongs to another node'");
		КонецЕсли;
		Возврат ВосстановитьRemoteReference(Значение, КодТекущегоУзла);
	КонецЕсли;

	Если ЭтоУдаленноеПеречисление(Значение) Тогда
		Возврат ВосстановитьRemoteEnum(Значение, КодТекущегоУзла);
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Дата")
		Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("УникальныйИдентификатор")
		Или ТипЗначения = Тип("Неопределено")
		Или ТипЗначения = Тип("Null") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого Элемент Из Значение Цикл
			Результат.Вставить(
				Элемент.Ключ,
				ВосстановитьЗначениеДляЗаписи(Элемент.Значение, КодТекущегоУзла));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("Массив")
		Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ВосстановитьЗначениеДляЗаписи(Элемент, КодТекущегоУзла));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Результат = Новый ТаблицаЗначений;
		Для Каждого Колонка Из Значение.Колонки Цикл
			Результат.Колонки.Добавить(Колонка.Имя, , Колонка.Заголовок);
		КонецЦикла;
		Для Каждого ИсходнаяСтрока Из Значение Цикл
			НоваяСтрока = Результат.Добавить();
			Для Каждого Колонка Из Значение.Колонки Цикл
				НоваяСтрока[Колонка.Имя] = ВосстановитьЗначениеДляЗаписи(
					ИсходнаяСтрока[Колонка.Имя], КодТекущегоУзла);
			КонецЦикла;
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	ВызватьИсключение "OBJECT_VALIDATION_ERROR|"
		+ НСтр("ru = 'Неподдерживаемый Portable-тип для записи'; en = 'Unsupported Portable type for write'")
		+ ": " + Строка(ТипЗначения);

КонецФункции

Функция ВосстановитьRemoteEnum(УдаленноеПеречисление, КодТекущегоУзла) Экспорт

	Если Не ЭтоУдаленноеПеречисление(УдаленноеПеречисление) Тогда
		ВызватьИсключение "OBJECT_VALIDATION_ERROR|Ожидается RemoteEnum";
	КонецЕсли;

	Узел = "";
	ИмяМетаданных = "";
	ИмяЗначения = "";
	Если Не УдаленноеПеречисление.Свойство("Node", Узел)
		Или Не УдаленноеПеречисление.Свойство("Metadata", ИмяМетаданных)
		Или Не УдаленноеПеречисление.Свойство("ValueName", ИмяЗначения) Тогда
		ВызватьИсключение "OBJECT_VALIDATION_ERROR|RemoteEnum не содержит Node, Metadata или ValueName";
	КонецЕсли;

	Если Узел <> КодТекущегоУзла Тогда
		ВызватьИсключение "REFERENCE_NODE_INVALID|RemoteEnum принадлежит другому узлу";
	КонецЕсли;

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ИмяМетаданных);
	Если ОбъектМетаданных = Неопределено
		Или Не СтрНачинаетсяС(ИмяМетаданных, "Перечисление.") Тогда
		ВызватьИсключение "OBJECT_VALIDATION_ERROR|Не найдено перечисление " + ИмяМетаданных;
	КонецЕсли;

	Если ПустаяСтрока(ИмяЗначения) Тогда
		Возврат Перечисления[ОбъектМетаданных.Имя].ПустаяСсылка();
	КонецЕсли;

	ИндексЗначения = 0;
	Для Каждого ЗначениеМетаданных Из ОбъектМетаданных.ЗначенияПеречисления Цикл
		Если ЗначениеМетаданных.Имя = ИмяЗначения Тогда
			Возврат Перечисления[ОбъектМетаданных.Имя].Получить(ИндексЗначения);
		КонецЕсли;
		ИндексЗначения = ИндексЗначения + 1;
	КонецЦикла;

	ВызватьИсключение "OBJECT_VALIDATION_ERROR|Не найдено значение перечисления "
		+ ИмяМетаданных + "." + ИмяЗначения;

КонецФункции

// Portable-контракт процедур без изменения семантики Query/Object/ValueStorage.
// Направление: Parameters (клиент), Restore (сервер), Result (сервер), ClientResult (клиент).
Функция ПреобразоватьЗначениеПроцедуры(Значение, КодУзла, Направление) Экспорт
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Маркер = "";
		Если Значение.Свойство("URCType", Маркер) Тогда
			Если Маркер = "RemoteValueStorage" Или Маркер = "RemoteObjectData" Тогда
				ВызватьИсключение "UNSUPPORTED_PARAMETER_TYPE|" + НСтр("ru = 'Хранилища и объекты не поддерживаются процедурой'; en = 'Value storages and objects are not supported by procedures'");
			КонецЕсли;
			// Фиксированные структуры проходят те же существующие проверки remote-типов.
			Если ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
				Копия = Новый Структура;
				Для Каждого Элемент Из Значение Цикл
					Копия.Вставить(Элемент.Ключ, Элемент.Значение);
				КонецЦикла;
				Возврат ПреобразоватьЗначениеПроцедуры(Копия, КодУзла, Направление);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если ЭтоУдаленнаяСсылка(Значение) Или ЭтоУдаленноеПеречисление(Значение) Тогда
		ПроверитьNodeКонтекстногоЗначения(Значение, КодУзла);
		Если Направление = "Restore" Тогда
			Если ЭтоУдаленнаяСсылка(Значение) Тогда
				Возврат ВосстановитьRemoteReference(Значение, КодУзла);
			КонецЕсли;
			Возврат ВосстановитьRemoteEnum(Значение, КодУзла);
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	Если ЭтоRemoteBinaryData(Значение) Тогда
		Двоичные = ВосстановитьRemoteBinaryData(Значение);
		Если Направление = "Restore" Или Направление = "ClientResult" Тогда
			Возврат Двоичные;
		КонецЕсли;
		Возврат СоздатьRemoteBinaryData(Двоичные);
	КонецЕсли;
	Если ТипЗначения = Тип("ДвоичныеДанные") Тогда
		Если Направление = "Restore" Или Направление = "ClientResult" Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат СоздатьRemoteBinaryData(Значение);
	КонецЕсли;
	Если ТипЗначения = Тип("ХранилищеЗначения") Или ТипЗначения = Тип("РезультатЗапроса") Тогда
		ВызватьИсключение "UNSUPPORTED_PARAMETER_TYPE|" + НСтр("ru = 'Тип не поддерживается процедурой'; en = 'Type is not supported by procedures'");
	КонецЕсли;
	Если ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого Элемент Из Значение Цикл
			Результат.Вставить(Элемент.Ключ,
				ПреобразоватьЗначениеПроцедуры(Элемент.Значение, КодУзла, Направление));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Если ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ПреобразоватьЗначениеПроцедуры(Элемент, КодУзла, Направление));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Если ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Результат = Новый ТаблицаЗначений;
		Для Каждого Колонка Из Значение.Колонки Цикл
			Результат.Колонки.Добавить(Колонка.Имя, , Колонка.Заголовок);
		КонецЦикла;
		Для Каждого ИсходнаяСтрока Из Значение Цикл
			НоваяСтрока = Результат.Добавить();
			Для Каждого Колонка Из Значение.Колонки Цикл
				НоваяСтрока[Колонка.Имя] = ПреобразоватьЗначениеПроцедуры(
					ИсходнаяСтрока[Колонка.Имя], КодУзла, Направление);
			КонецЦикла;
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Если Направление = "Result" Тогда
		Возврат НормализоватьЗначение(Значение, КодУзла);
	КонецЕсли;
	// Скалярные значения проверяются существующим allowlist portable-слоя.
	Возврат ПодготовитьПараметр(Значение, КодУзла);
КонецФункции


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодготовитьПараметр(Значение, КодЦелевогоУзла)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Дата")
		Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("УникальныйИдентификатор")
		Или ТипЗначения = Тип("Неопределено")
		Или ТипЗначения = Тип("Null") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ЭтоУдаленнаяСсылка(Значение) Тогда
		УзелСсылки = "";
		Если Не Значение.Свойство("Node", УзелСсылки)
			Или УзелСсылки <> КодЦелевогоУзла Тогда
			ВызватьИсключение "REMOTE_REFERENCE_WRONG_NODE|"
				+ НСтр("ru = 'RemoteReference принадлежит другому узлу'; en = 'RemoteReference belongs to another node'");
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;

	Если ЭтоУдаленноеПеречисление(Значение) Тогда
		ВызватьИсключение "UNSUPPORTED_PARAMETER_TYPE|"
			+ НСтр("ru = 'RemoteEnum не поддерживается как параметр P0'; en = 'RemoteEnum is not supported as a P0 parameter'");
	КонецЕсли;

	Если ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого Элемент Из Значение Цикл
			Результат.Вставить(
				Элемент.Ключ, ПодготовитьПараметр(Элемент.Значение, КодЦелевогоУзла));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("Массив")
		Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ПодготовитьПараметр(Элемент, КодЦелевогоУзла));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	ВызватьИсключение "UNSUPPORTED_PARAMETER_TYPE|"
		+ НСтр("ru = 'Неподдерживаемый тип параметра'; en = 'Unsupported parameter type'")
		+ ": " + Строка(ТипЗначения);

КонецФункции

Функция ЭтоПоддерживаемоеПолноеИмяСсылки(ПолноеИмя)

	Возврат СтрНачинаетсяС(ПолноеИмя, "Справочник.")
		Или СтрНачинаетсяС(ПолноеИмя, "Документ.")
		Или СтрНачинаетсяС(ПолноеИмя, "ПланСчетов.")
		Или СтрНачинаетсяС(ПолноеИмя, "ПланВидовХарактеристик.")
		Или СтрНачинаетсяС(ПолноеИмя, "ПланВидовРасчета.")
		Или СтрНачинаетсяС(ПолноеИмя, "ПланОбмена.")
		Или СтрНачинаетсяС(ПолноеИмя, "БизнесПроцесс.")
		Или СтрНачинаетсяС(ПолноеИмя, "Задача.");

КонецФункции

Функция ПолучитьСсылкуПоПолномуИмени(ПолноеИмя, UUID)

	Части = СтрРазделить(ПолноеИмя, ".");
	Если Части.Количество() <> 2 Тогда
		ВызватьИсключение "REMOTE_REFERENCE_TYPE_NOT_FOUND|Некорректное имя метаданных " + ПолноеИмя;
	КонецЕсли;

	Категория = Части[0];
	ИмяОбъекта = Части[1];
	Если Категория = "Справочник" Тогда
		Возврат Справочники[ИмяОбъекта].ПолучитьСсылку(UUID);
	ИначеЕсли Категория = "Документ" Тогда
		Возврат Документы[ИмяОбъекта].ПолучитьСсылку(UUID);
	ИначеЕсли Категория = "ПланСчетов" Тогда
		Возврат ПланыСчетов[ИмяОбъекта].ПолучитьСсылку(UUID);
	ИначеЕсли Категория = "ПланВидовХарактеристик" Тогда
		Возврат ПланыВидовХарактеристик[ИмяОбъекта].ПолучитьСсылку(UUID);
	ИначеЕсли Категория = "ПланВидовРасчета" Тогда
		Возврат ПланыВидовРасчета[ИмяОбъекта].ПолучитьСсылку(UUID);
	ИначеЕсли Категория = "ПланОбмена" Тогда
		Возврат ПланыОбмена[ИмяОбъекта].ПолучитьСсылку(UUID);
	ИначеЕсли Категория = "БизнесПроцесс" Тогда
		Возврат БизнесПроцессы[ИмяОбъекта].ПолучитьСсылку(UUID);
	ИначеЕсли Категория = "Задача" Тогда
		Возврат Задачи[ИмяОбъекта].ПолучитьСсылку(UUID);
	КонецЕсли;

	ВызватьИсключение "REMOTE_REFERENCE_TYPE_NOT_FOUND|Неподдерживаемый объект метаданных " + ПолноеИмя;

КонецФункции

#КонецОбласти
