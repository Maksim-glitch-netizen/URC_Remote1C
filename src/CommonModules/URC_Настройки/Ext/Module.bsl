
#Область ПрограммныйИнтерфейс

Функция ПолучитьВсеСоединения() Экспорт
	Попытка
		Соединения = ЗагрузитьСистемнуюНастройку(URC_Протокол.ИмяНастроекСоединений());
	Исключение
		ВызватьИсключение "SETTINGS_ACCESS_ERROR|"
			+ НСтр("ru = 'Не удалось прочитать настройки соединений'; en = 'Failed to read connection settings'");
	КонецПопытки;
	Если ТипЗнч(Соединения) <> Тип("Соответствие") Тогда
		Соединения = Новый Соответствие;
	КонецЕсли;
	Если МигрироватьНастройкиСоединений(Соединения) Тогда
		Попытка
			СохранитьСистемнуюНастройку(
				URC_Протокол.ИмяНастроекСоединений(), Соединения);
		Исключение
			ВызватьИсключение "SETTINGS_ACCESS_ERROR|"
				+ НСтр("ru = 'Не удалось сохранить миграцию настроек соединений'; en = 'Failed to save connection settings migration'");
		КонецПопытки;
	КонецЕсли;
	Возврат Соединения;
КонецФункции

Функция ПолучитьСоединение(ConnectionCode) Экспорт
	Если ТипЗнч(ConnectionCode) <> Тип("Строка")
		Или ПустаяСтрока(СокрЛП(ConnectionCode)) Тогда
		ВызватьИсключение "CONNECTION_NOT_FOUND|"
			+ НСтр("ru = 'Не заполнен код соединения'; en = 'Connection code is not specified'");
	КонецЕсли;
	ConnectionCode = СокрЛП(ConnectionCode);
	Соединение = ПолучитьВсеСоединения().Получить(ConnectionCode);
	Если ТипЗнч(Соединение) <> Тип("Структура") Тогда
		ВызватьИсключение "CONNECTION_NOT_FOUND|"
			+ НСтр("ru = 'Соединение не найдено'; en = 'Connection was not found'")
			+ ": " + ConnectionCode;
	КонецЕсли;
	Активен = Ложь;
	Если Не Соединение.Свойство("Активен", Активен) Или Не Активен Тогда
		ВызватьИсключение "CONNECTION_DISABLED|"
			+ НСтр("ru = 'Соединение отключено'; en = 'Connection is disabled'")
			+ ": " + ConnectionCode;
	КонецЕсли;
	ПроверитьНастройкиСоединения(ConnectionCode, Соединение);
	Возврат Соединение;
КонецФункции

Процедура СохранитьСоединение(ConnectionCode, Соединение) Экспорт
	Если ТипЗнч(ConnectionCode) <> Тип("Строка")
		Или ПустаяСтрока(СокрЛП(ConnectionCode)) Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Не заполнен код соединения'; en = 'Connection code is not specified'");
	КонецЕсли;
	Если ТипЗнч(Соединение) <> Тип("Структура") Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Настройки соединения должны иметь тип Структура'; en = 'Connection settings must be a Structure'");
	КонецЕсли;
	ConnectionCode = СокрЛП(ConnectionCode);
	Соединение.Вставить("ConnectionCode", ConnectionCode);
	ПроверитьНастройкиСоединения(ConnectionCode, Соединение);
	Соединения = ПолучитьВсеСоединения();
	Соединения.Вставить(ConnectionCode, Соединение);
	СохранитьВсеСоединения(Соединения);
КонецПроцедуры

Процедура СохранитьВсеСоединения(Соединения) Экспорт
	Если ТипЗнч(Соединения) <> Тип("Соответствие") Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Список соединений должен иметь тип Соответствие'; en = 'Connection list must be a Map'");
	КонецЕсли;
	Для Каждого ЭлементСоединения Из Соединения Цикл
		ПроверитьНастройкиСоединения(
			ЭлементСоединения.Ключ, ЭлементСоединения.Значение);
	КонецЦикла;
	Попытка
		СохранитьСистемнуюНастройку(
			URC_Протокол.ИмяНастроекСоединений(), Соединения);
	Исключение
		ВызватьИсключение "SETTINGS_ACCESS_ERROR|"
			+ НСтр("ru = 'Не удалось сохранить настройки соединений'; en = 'Failed to save connection settings'");
	КонецПопытки;
КонецПроцедуры

Процедура УдалитьСоединение(ConnectionCode) Экспорт
	Соединения = ПолучитьВсеСоединения();
	Соединения.Удалить(СокрЛП(ConnectionCode));
	СохранитьВсеСоединения(Соединения);
КонецПроцедуры

// Совместимые имена API 0.3.0. КодУзла теперь трактуется как ConnectionCode.
Функция ПолучитьВсеУзлы() Экспорт
	Возврат ПолучитьВсеСоединения();
КонецФункции

Функция ПолучитьУзел(КодУзла) Экспорт
	Возврат ПолучитьСоединение(КодУзла);
КонецФункции

Процедура СохранитьУзел(КодУзла, Узел) Экспорт
	Если ТипЗнч(Узел) = Тип("Структура") Тогда
		Node = "";
		Если Не Узел.Свойство("Node", Node) Или ПустаяСтрока(СокрЛП(Строка(Node))) Тогда
			Узел.Вставить("Node", СокрЛП(КодУзла));
		КонецЕсли;
	КонецЕсли;
	СохранитьСоединение(КодУзла, Узел);
КонецПроцедуры

Процедура СохранитьВсеУзлы(Узлы) Экспорт
	МигрироватьНастройкиСоединений(Узлы);
	СохранитьВсеСоединения(Узлы);
КонецПроцедуры

Процедура УдалитьУзел(КодУзла) Экспорт
	УдалитьСоединение(КодУзла);
КонецПроцедуры

Функция ПолучитьЛокальныеНастройки() Экспорт
	Попытка
		Настройки = ЗагрузитьСистемнуюНастройку(URC_Протокол.ИмяЛокальныхНастроек());
	Исключение
		ВызватьИсключение "SETTINGS_ACCESS_ERROR|"
			+ НСтр("ru = 'Не удалось прочитать настройки локального узла'; en = 'Failed to read local node settings'");
	КонецПопытки;
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Настройки = Новый Структура("КодУзла", "LOCAL");
	КонецЕсли;
	Возврат Настройки;
КонецФункции

Процедура СохранитьЛокальныеНастройки(Настройки) Экспорт
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		ВызватьИсключение "BAD_REQUEST|" + НСтр("ru = 'Локальные настройки должны иметь тип Структура'; en = 'Local settings must be a Structure'");
	КонецЕсли;
	Попытка
		СохранитьСистемнуюНастройку(URC_Протокол.ИмяЛокальныхНастроек(), Настройки);
	Исключение
		ВызватьИсключение "SETTINGS_ACCESS_ERROR|"
			+ НСтр("ru = 'Не удалось сохранить настройки локального узла'; en = 'Failed to save local node settings'");
	КонецПопытки;
КонецПроцедуры

Функция ПолучитьНастройкиБезопасности() Экспорт
	Попытка
		Настройки = ЗагрузитьСистемнуюНастройку(URC_Протокол.ИмяНастроекБезопасности());
	Исключение
		ВызватьИсключение "SETTINGS_ACCESS_ERROR|"
			+ НСтр("ru = 'Не удалось прочитать настройки безопасности'; en = 'Failed to read security settings'");
	КонецПопытки;
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		РазрешитьRemote1C = Ложь;
		СтарыеНастройки = ПолучитьЛокальныеНастройки();
		СтарыеНастройки.Свойство("РазрешитьRemote1C", РазрешитьRemote1C);
		Настройки = Новый Структура("РазрешитьRemote1C", РазрешитьRemote1C);
	КонецЕсли;
	ДополнитьНастройкиБезопасности(Настройки);
	Возврат Настройки;
КонецФункции

Процедура СохранитьНастройкиБезопасности(Настройки) Экспорт
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Настройки безопасности должны иметь тип Структура'; en = 'Security settings must be a Structure'");
	КонецЕсли;
	ДополнитьНастройкиБезопасности(Настройки);
	Если ТипЗнч(Настройки.РазрешитьRemote1C) <> Тип("Булево")
		// Проверка нового флага безопасности.
		Или ТипЗнч(Настройки.AllowProcedureExecute) <> Тип("Булево")
		Или ТипЗнч(Настройки.AllowObjectWrite) <> Тип("Булево")
		Или ТипЗнч(Настройки.ObjectWriteStrictMode) <> Тип("Булево") Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Флаги безопасности должны иметь тип Булево'; en = 'Security flags must be Boolean'");
	КонецЕсли;
	Попытка
		СохранитьСистемнуюНастройку(URC_Протокол.ИмяНастроекБезопасности(), Настройки);
	Исключение
		ВызватьИсключение "SETTINGS_ACCESS_ERROR|"
			+ НСтр("ru = 'Не удалось сохранить настройки безопасности'; en = 'Failed to save security settings'");
	КонецПопытки;
КонецПроцедуры

