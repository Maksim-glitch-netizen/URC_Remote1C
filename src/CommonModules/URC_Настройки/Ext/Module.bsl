Функция ЭкспортироватьСоединенияБезСекретов() Экспорт
	Результат = Новый Массив;
	Для Каждого ЭлементСоединения Из ПолучитьВсеСоединения() Цикл
		Соединение = ЭлементСоединения.Значение;
		СтрокаЭкспорта = Новый Структура;
		СтрокаЭкспорта.Вставить("ConnectionCode", ЭлементСоединения.Ключ);
		Для Каждого ИмяПоля Из СтрРазделить(
			"Node,Наименование,БазовыйURL,Активен,РежимСериализации,ТаймаутHTTP,Пользователь", ",") Цикл
			ЗначениеПоля = Неопределено;
			Если Соединение.Свойство(ИмяПоля, ЗначениеПоля) Тогда
				СтрокаЭкспорта.Вставить(ИмяПоля, ЗначениеПоля);
			КонецЕсли;
		КонецЦикла;
		Результат.Добавить(СтрокаЭкспорта);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ИмпортироватьСоединенияБезСекретов(ДанныеИмпорта) Экспорт
	Если ТипЗнч(ДанныеИмпорта) <> Тип("Массив")
		И ТипЗнч(ДанныеИмпорта) <> Тип("ФиксированныйМассив") Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Импорт должен содержать массив соединений'; en = 'Import must contain an array of connections'");
	КонецЕсли;
	Соединения = ПолучитьВсеСоединения();
	Для Каждого СтрокаИмпорта Из ДанныеИмпорта Цикл
		Если ТипЗнч(СтрокаИмпорта) <> Тип("Структура") Тогда
			ВызватьИсключение "BAD_REQUEST|"
				+ НСтр("ru = 'Строка импорта должна иметь тип Структура'; en = 'Import row must be a Structure'");
		КонецЕсли;
		ConnectionCode = "";
		Если Не СтрокаИмпорта.Свойство("ConnectionCode", ConnectionCode) Тогда
			СтрокаИмпорта.Свойство("КодУзла", ConnectionCode);
		КонецЕсли;
		Если ТипЗнч(ConnectionCode) <> Тип("Строка")
			Или ПустаяСтрока(СокрЛП(ConnectionCode)) Тогда
			ВызватьИсключение "BAD_REQUEST|"
				+ НСтр("ru = 'В строке импорта не заполнен ConnectionCode'; en = 'ConnectionCode is missing in import row'");
		КонецЕсли;
		ConnectionCode = СокрЛП(ConnectionCode);
		НовоеСоединение = НоваяНастройкаСоединения();
		СуществующееСоединение = Соединения.Получить(ConnectionCode);
		Если ТипЗнч(СуществующееСоединение) = Тип("Структура") Тогда
			СуществующийСекрет = "";
			СуществующееСоединение.Свойство("Секрет", СуществующийСекрет);
			НовоеСоединение.Вставить("Секрет", СуществующийСекрет);
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НовоеСоединение, СтрокаИмпорта);
		НовоеСоединение.Вставить("ConnectionCode", ConnectionCode);
		Node = "";
		Если Не НовоеСоединение.Свойство("Node", Node)
			Или ПустаяСтрока(СокрЛП(Строка(Node))) Тогда
			НовоеСоединение.Вставить("Node", ConnectionCode);
		КонецЕсли;
		Соединения.Вставить(ConnectionCode, НовоеСоединение);
	КонецЦикла;
	СохранитьВсеСоединения(Соединения);
КонецПроцедуры

Функция НоваяНастройкаСоединения() Экспорт
	Возврат Новый Структура(
		"ConnectionCode,Node,Наименование,БазовыйURL,Активен,РежимСериализации,ТаймаутHTTP,Пользователь,Секрет",
		"", "", "", "", Истина, URC_Протокол.РежимPortable(), 60, "", "");
КонецФункции

Функция ЭкспортироватьУзлыБезСекретов() Экспорт
	Возврат ЭкспортироватьСоединенияБезСекретов();
КонецФункции

Процедура ИмпортироватьУзлыБезСекретов(ДанныеИмпорта) Экспорт
	ИмпортироватьСоединенияБезСекретов(ДанныеИмпорта);
КонецПроцедуры

Функция НовыйУзел() Экспорт
	Возврат НоваяНастройкаСоединения();
КонецФункции

// Отдельный реестр в существующем хранилище системных настроек.
// Возвращает пустую типизированную таблицу при отсутствии настройки.
Функция НоваяТаблицаХранимыхПроцедур() Экспорт
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Обработчик", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Разрешена", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));
	Возврат Таблица;
КонецФункции

// Возвращает локальный реестр. Не включается в экспорт соединений.
Функция ПолучитьХранимыеПроцедуры() Экспорт
	Попытка
		Процедуры = ЗагрузитьСистемнуюНастройку(URC_Протокол.ИмяНастроекПроцедур());
	Исключение
		ВызватьИсключение "SETTINGS_ACCESS_ERROR|" + НСтр("ru = 'Не удалось прочитать реестр процедур'; en = 'Failed to read the procedure registry'");
	КонецПопытки;
	Если Процедуры = Неопределено Тогда
		Возврат НоваяТаблицаХранимыхПроцедур();
	КонецЕсли;
	Если ТипЗнч(Процедуры) <> Тип("ТаблицаЗначений") Тогда
		ВызватьИсключение "SETTINGS_ACCESS_ERROR|" + НСтр("ru = 'Реестр процедур повреждён'; en = 'Procedure registry is corrupted'");
	КонецЕсли;
	Для Каждого Колонка Из НоваяТаблицаХранимыхПроцедур().Колонки Цикл
		Если Процедуры.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
			ВызватьИсключение "SETTINGS_ACCESS_ERROR|" + НСтр("ru = 'Неполная структура реестра процедур'; en = 'Incomplete procedure registry structure'");
		КонецЕсли;
	КонецЦикла;
	Возврат Процедуры.Скопировать();
КонецФункции

// Валидирует весь реестр до сохранения; новые строки выключены по умолчанию.
Процедура СохранитьХранимыеПроцедуры(Процедуры) Экспорт
	URC_УдаленныеПроцедуры.ПроверитьРеестр(Процедуры);
	ЧистаяТаблица = НоваяТаблицаХранимыхПроцедур();
	Для Каждого СтрокаРеестра Из Процедуры Цикл
		ЗаполнитьЗначенияСвойств(ЧистаяТаблица.Добавить(), СтрокаРеестра);
	КонецЦикла;
	Попытка
		СохранитьСистемнуюНастройку(URC_Протокол.ИмяНастроекПроцедур(), ЧистаяТаблица);
	Исключение
		ВызватьИсключение "SETTINGS_ACCESS_ERROR|" + НСтр("ru = 'Не удалось сохранить реестр процедур'; en = 'Failed to save the procedure registry'");
	КонецПопытки;
КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗагрузитьСистемнуюНастройку(ИмяНастройки)
	Возврат ХранилищеСистемныхНастроек.ЗагрузитьНастройкуПоУмолчанию(
		КлючСистемнойНастройки(ИмяНастройки));
КонецФункции

Процедура СохранитьСистемнуюНастройку(ИмяНастройки, Настройки)
	ХранилищеСистемныхНастроек.СохранитьНастройкуПоУмолчанию(
		КлючСистемнойНастройки(ИмяНастройки), Настройки);
КонецПроцедуры

Функция КлючСистемнойНастройки(ИмяНастройки)
	Возврат URC_Протокол.КлючНастроек() + "." + ИмяНастройки;
КонецФункции

Процедура ПроверитьНастройкиСоединения(ConnectionCode, Соединение)
	Если ТипЗнч(Соединение) <> Тип("Структура") Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Настройки соединения должны иметь тип Структура'; en = 'Connection settings must be a Structure'");
	КонецЕсли;
	Если ТипЗнч(ConnectionCode) <> Тип("Строка")
		Или ПустаяСтрока(СокрЛП(ConnectionCode)) Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Не заполнен код соединения'; en = 'Connection code is not specified'");
	КонецЕсли;
	КодВНастройке = "";
	Node = "";
	Если Не Соединение.Свойство("ConnectionCode", КодВНастройке)
		Или СокрЛП(Строка(КодВНастройке)) <> СокрЛП(ConnectionCode) Тогда
		ВызватьИсключение "BAD_REQUEST|ConnectionCode настройки не совпадает с ключом";
	КонецЕсли;
	Если Не Соединение.Свойство("Node", Node)
		Или ТипЗнч(Node) <> Тип("Строка")
		Или ПустаяСтрока(СокрЛП(Node)) Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Не заполнен Node соединения'; en = 'Connection Node is not specified'");
	КонецЕсли;
	// 2026.10.11 - Пустой режим соединения использует portable по умолчанию.
	Режим = РежимСериализацииСоединения(Соединение);
	Если Режим <> URC_Протокол.РежимPortable()
		И Режим <> URC_Протокол.РежимNativeXDTO() Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Неизвестный режим сериализации'; en = 'Unknown serialization mode'");
	КонецЕсли;
	Таймаут = 0;
	Если Не Соединение.Свойство("ТаймаутHTTP", Таймаут)
		Или ТипЗнч(Таймаут) <> Тип("Число") Или Таймаут <= 0 Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'HTTP-таймаут должен быть положительным числом'; en = 'HTTP timeout must be a positive number'");
	КонецЕсли;
	Активен = Ложь;
	БазовыйURL = "";
	Соединение.Свойство("Активен", Активен);
	Соединение.Свойство("БазовыйURL", БазовыйURL);
	Если Активен И ПустаяСтрока(СокрЛП(БазовыйURL)) Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Для активного соединения не заполнен базовый URL'; en = 'Base URL is missing for an active connection'");
	КонецЕсли;
КонецПроцедуры

// 2026.10.11 - Нормализация отсутствующего или пустого режима соединения.
Функция РежимСериализацииСоединения(Соединение)

	Режим = "";
	Соединение.Свойство("РежимСериализации", Режим);
	Если ТипЗнч(Режим) = Тип("Строка") И ПустаяСтрока(Режим) Тогда
		Режим = URC_Протокол.РежимPortable();
		Соединение.Вставить("РежимСериализации", Режим);
	КонецЕсли;
	Возврат Режим;

КонецФункции

Функция МигрироватьНастройкиСоединений(Соединения)

	Если ТипЗнч(Соединения) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;
	Изменено = Ложь;
	Для Каждого ЭлементСоединения Из Соединения Цикл
		Если ТипЗнч(ЭлементСоединения.Значение) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		ConnectionCode = СокрЛП(Строка(ЭлементСоединения.Ключ));
		Соединение = ЭлементСоединения.Значение;
		КодВНастройке = "";
		Если Не Соединение.Свойство("ConnectionCode", КодВНастройке)
			Или КодВНастройке <> ConnectionCode Тогда
			Соединение.Вставить("ConnectionCode", ConnectionCode);
			Изменено = Истина;
		КонецЕсли;
		Node = "";
		Если Не Соединение.Свойство("Node", Node)
			Или ТипЗнч(Node) <> Тип("Строка")
			Или ПустаяСтрока(СокрЛП(Node)) Тогда
			Соединение.Вставить("Node", ConnectionCode);
			Изменено = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Изменено;

КонецФункции

Процедура ДополнитьНастройкиБезопасности(Настройки)

	// Именованные удалённые процедуры по ТЗ v2.
	Если Не Настройки.Свойство("AllowProcedureExecute") Тогда
		Настройки.Вставить("AllowProcedureExecute", Ложь);
	КонецЕсли;

	Если Не Настройки.Свойство("РазрешитьRemote1C") Тогда
		Настройки.Вставить("РазрешитьRemote1C", Ложь);
	КонецЕсли;
	Если Не Настройки.Свойство("AllowObjectWrite") Тогда
		Настройки.Вставить("AllowObjectWrite", Ложь);
	КонецЕсли;
	Если Не Настройки.Свойство("ObjectWriteStrictMode") Тогда
		Настройки.Вставить("ObjectWriteStrictMode", Истина);
	КонецЕсли;
	Если Не Настройки.Свойство("ObjectWriteAllowedMetadata") Тогда
		Настройки.Вставить("ObjectWriteAllowedMetadata", Новый Массив);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
