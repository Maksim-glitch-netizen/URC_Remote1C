// Именованные процедуры: локальный allowlist и единственная точка вызова.
#Область ПрограммныйИнтерфейс

// Проверяет публичный идентификатор без изменения регистра и пробелов.
Процедура ПроверитьИмяПроцедуры(Имя) Экспорт
	Если ТипЗнч(Имя) <> Тип("Строка") Или ПустаяСтрока(Имя) Тогда
		ВызватьИсключение "BAD_REQUEST|" + НСтр("ru = 'Не заполнено имя процедуры'; en = 'Procedure name is required'");
	КонецЕсли;
	Допустимые = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-";
	Для Позиция = 1 По СтрДлина(Имя) Цикл
		Если СтрНайти(Допустимые, Сред(Имя, Позиция, 1)) = 0 Тогда
			ВызватьИсключение "BAD_REQUEST|" + НСтр("ru = 'Недопустимое имя процедуры'; en = 'Invalid procedure name'");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Обработчик — только локальная строка Модуль.Функция, без выражений.
Процедура ПроверитьОбработчик(Обработчик) Экспорт
	Если ТипЗнч(Обработчик) <> Тип("Строка") Тогда
		ОшибкаОбработчика();
	КонецЕсли;
	Части = СтрРазделить(Обработчик, ".", Истина);
	Если Части.Количество() <> 2 Тогда
		ОшибкаОбработчика();
	КонецЕсли;
	Для Каждого Часть Из Части Цикл
		Если Не ДопустимыйИдентификатор(Часть) Тогда
			ОшибкаОбработчика();
		КонецЕсли;
	КонецЦикла;
	Модуль = Метаданные.ОбщиеМодули.Найти(Части[0]);
	Если Модуль = Неопределено Тогда
		ОшибкаОбработчика();
	КонецЕсли;
	Если Не Модуль.Сервер Или Модуль.Глобальный Или Модуль.Привилегированный Тогда
		ОшибкаОбработчика();
	КонецЕсли;
КонецПроцедуры

// Валидирует таблицу до первой записи настроек формы.
Процедура ПроверитьРеестр(Процедуры) Экспорт
	Если ТипЗнч(Процедуры) <> Тип("ТаблицаЗначений") Тогда
		ОшибкаРеестра();
	КонецЕсли;
	Для Каждого ИмяКолонки Из СтрРазделить("Имя,Обработчик,Разрешена,Описание", ",") Цикл
		Если Процедуры.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
			ОшибкаРеестра();
		КонецЕсли;
	КонецЦикла;
	Имена = Новый Соответствие;
	Для Каждого ЗаписьРеестра Из Процедуры Цикл
		ПроверитьИмяПроцедуры(ЗаписьРеестра.Имя);
		Ключ = ВРег(ЗаписьРеестра.Имя);
		Если Имена.Получить(Ключ) <> Неопределено Тогда
			ВызватьИсключение "BAD_REQUEST|" + НСтр("ru = 'Имена процедур должны быть уникальны без учёта регистра'; en = 'Procedure names must be unique ignoring case'");
		КонецЕсли;
		Имена.Вставить(Ключ, Истина);
		Если ТипЗнч(ЗаписьРеестра.Разрешена) <> Тип("Булево")
			Или ТипЗнч(ЗаписьРеестра.Описание) <> Тип("Строка") Тогда
			ОшибкаРеестра();
		КонецЕсли;
		ПроверитьОбработчик(ЗаписьРеестра.Обработчик);
	КонецЦикла;
КонецПроцедуры

// Возвращает только публичные поля, даже когда выполнение глобально запрещено.
Функция ПолучитьПубличныйСписок() Экспорт
	URC_Безопасность.ПроверитьУдаленныйДоступ();
	Настройки = URC_Настройки.ПолучитьНастройкиБезопасности();
	Результат = Новый Массив;
	Для Каждого ЗаписьРеестра Из URC_Настройки.ПолучитьХранимыеПроцедуры() Цикл
		ПроверитьИмяПроцедуры(ЗаписьРеестра.Имя);
		Разрешена = ТипЗнч(Настройки.AllowProcedureExecute) = Тип("Булево")
			И Настройки.AllowProcedureExecute
			И ТипЗнч(ЗаписьРеестра.Разрешена) = Тип("Булево") И ЗаписьРеестра.Разрешена;
		Результат.Добавить(Новый Структура("Имя,Разрешена,Описание",
			ЗаписьРеестра.Имя, Разрешена, ЗаписьРеестра.Описание));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Выполняет ровно один зарегистрированный обработчик с одним контейнером параметров.
Функция ВыполнитьПроцедуру(ИмяПроцедуры, Параметры, КодУзла, RequestId) Экспорт
	URC_Безопасность.ПроверитьУдаленныйДоступ();
	URC_Безопасность.ПроверитьВыполнениеПроцедур();
	ПроверитьИмяПроцедуры(ИмяПроцедуры);
	НайденнаяЗапись = Неопределено;
	Для Каждого ЗаписьРеестра Из URC_Настройки.ПолучитьХранимыеПроцедуры() Цикл
		Если ВРег(ЗаписьРеестра.Имя) = ВРег(ИмяПроцедуры) Тогда
			Если НайденнаяЗапись <> Неопределено Тогда
				ОшибкаОбработчика();
			КонецЕсли;
			НайденнаяЗапись = ЗаписьРеестра;
		КонецЕсли;
	КонецЦикла;
	Если НайденнаяЗапись = Неопределено Тогда
		ВызватьИсключение "PROCEDURE_NOT_FOUND|" + НСтр("ru = 'Процедура не зарегистрирована'; en = 'Procedure is not registered'");
	КонецЕсли;
	Если ТипЗнч(НайденнаяЗапись.Разрешена) <> Тип("Булево") Или Не НайденнаяЗапись.Разрешена Тогда
		ВызватьИсключение "PROCEDURE_DISABLED|" + НСтр("ru = 'Процедура выключена'; en = 'Procedure is disabled'");
	КонецЕсли;
	Обработчик = НайденнаяЗапись.Обработчик;
	ПроверитьОбработчик(Обработчик);
	Если Параметры <> Неопределено И ТипЗнч(Параметры) <> Тип("Структура")
		И ТипЗнч(Параметры) <> Тип("ФиксированнаяСтруктура") Тогда
		ВызватьИсключение "UNSUPPORTED_PARAMETER_TYPE|" + НСтр("ru = 'Параметры должны быть структурой'; en = 'Parameters must be a structure'");
	КонецЕсли;
	НативныеПараметры = URC_ПортативныеТипы.ПреобразоватьЗначениеПроцедуры(Параметры, КодУзла, "Restore");
	РезультатВызова = ВызватьОбработчик(Обработчик, НативныеПараметры, RequestId);
	Попытка
		Результат = URC_ПортативныеТипы.ПреобразоватьЗначениеПроцедуры(РезультатВызова, КодУзла, "Result");
	Исключение
		ВызватьИсключение "PROCEDURE_RESULT_UNSUPPORTED|" + НСтр("ru = 'Результат процедуры не поддерживается'; en = 'Procedure result is not supported'");
	КонецПопытки;
	Возврат Новый Структура("Data,Procedure", Результат, НайденнаяЗапись.Имя);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДопустимыйИдентификатор(Имя)
	Если ПустаяСтрока(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Буквы = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя_";
	Если СтрНайти(Буквы, Лев(Имя, 1)) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Допустимые = Буквы + "0123456789";
	Для Позиция = 2 По СтрДлина(Имя) Цикл
		Если СтрНайти(Допустимые, Сред(Имя, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Процедура ОшибкаОбработчика()
	ВызватьИсключение "PROCEDURE_HANDLER_INVALID|" + НСтр("ru = 'Обработчик процедуры недоступен или некорректен'; en = 'Procedure handler is unavailable or invalid'");
КонецПроцедуры

Процедура ОшибкаРеестра()
	ВызватьИсключение "BAD_REQUEST|" + НСтр("ru = 'Некорректный реестр процедур'; en = 'Invalid procedure registry'");
КонецПроцедуры

Функция ВызватьОбработчик(Обработчик, Параметры, RequestId)
	// Повторная проверка непосредственно перед единственным динамическим вызовом.
	ПроверитьОбработчик(Обработчик);
	РезультатВызова = Неопределено;
	ТекстВызова = "РезультатВызова = " + Обработчик + "(Параметры);";
	Попытка
		Выполнить(ТекстВызова);
	Исключение
		Ошибка = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации("Remote1C.ProcedureExecute.Detail", УровеньЖурналаРегистрации.Ошибка, , ,
			"RequestId=" + Строка(RequestId) + "; Handler=" + Обработчик + Символы.ПС
			+ ПодробноеПредставлениеОшибки(Ошибка));
		// Ошибка поиска метода остаётся в строке динамического вызова.
		// Исключение внутри обработчика содержит модуль прикладного кода в цепочке причин.
		ВнутриОбработчика = Ложь;
		Пока Ошибка <> Неопределено Цикл
			ИмяМодуля = Ошибка.ИмяМодуля;
			Если Не ПустаяСтрока(ИмяМодуля)
				И СтрНайти(ИмяМодуля, "URC_УдаленныеПроцедуры") = 0
				И Ошибка.ИсходнаяСтрока <> ТекстВызова Тогда
				ВнутриОбработчика = Истина;
			КонецЕсли;
			Ошибка = Ошибка.Причина;
		КонецЦикла;
		Если ВнутриОбработчика Тогда
			ВызватьИсключение "PROCEDURE_EXECUTION_ERROR|" + НСтр("ru = 'Ошибка выполнения процедуры'; en = 'Procedure execution failed'");
		КонецЕсли;
		ОшибкаОбработчика();
	КонецПопытки;
	Возврат РезультатВызова;
КонецФункции

#КонецОбласти
