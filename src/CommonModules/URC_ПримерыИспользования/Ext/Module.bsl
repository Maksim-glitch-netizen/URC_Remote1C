
// Руководство и примеры дополнены именованными процедурами.
// Remote1C: инструкция и примеры работы с обменом между базами 1С.
//
// Remote1C позволяет одной информационной базе синхронно выполнить запрос в другой базе
// (или получить полный снимок данных объекта) и получить результат обычными транспортируемыми
// структурами 1С. Именованные процедуры вызываются только по локальному реестру сервера;
// передача произвольного BSL по HTTP не поддерживается.
//
// Порядок подключения:
// 1. Установить расширение URC_Remote1C в обе базы (клиентскую и серверную).
// 2. Назначить нужным пользователям роль URC_ОсновнаяРоль.
// 3. В базе-сервере опубликовать HTTP-сервис URC_API на веб-сервере (/hs/remote1c/v1/).
// 4. В базе-сервере под пользователем входящего HTTP-вызова выполнить РазрешитьВходящийRemote1C()
//    из этого модуля (или эквивалентный код): включает приём запросов и задаёт код узла.
// 5. В базе-клиенте под администратором с правом СохранениеДанныхПользователя выполнить
//    НастроитьСоединения(): сохраняет конкретные подключения и ожидаемый стабильный Node.
// 6. Проверить соединение - ПроверитьСоединение() (Ping + Capabilities).
//
// Все настройки хранятся как пользователь-независимые настройки по умолчанию
// в ХранилищеСистемныхНастроек. Remote1C не включает привилегированный режим:
// серверный запрос выполняется
// с правами пользователя входящего HTTP-вызова, поэтому запрошенные данные должны быть ему
// доступны по правам.
//
// Публичный клиентский API - общий модуль URC_Клиент:
//   URC_Клиент.Ping(ConnectionCode)
//   URC_Клиент.ПолучитьВозможности(ConnectionCode)
//   URC_Клиент.ВыполнитьЗапрос(ConnectionCode, ТекстЗапроса, Параметры, Настройки)
//   URC_Клиент.ВыполнитьЗапросРасширенно(ConnectionCode, ТекстЗапроса, Параметры, Настройки)
//   URC_Клиент.НайтиУдаленнуюСсылку(ConnectionCode, ПолноеИмяМетаданных, ИмяРеквизита, Значение, ДополнительныйОтбор)
//   URC_Клиент.ПолучитьРеквизиты(УдаленнаяСсылка, ИменаРеквизитов, Настройки)
//   URC_Клиент.ПолучитьДанныеОбъекта(УдаленнаяСсылка, Настройки)
// Продолжающие методы определяют подключение только из Remote*.ConnectionCode.
//   URC_Клиент.ПолучитьОбъект(УдаленнаяСсылка, Настройки)
//   URC_Клиент.СоздатьОбъект(ConnectionCode, ИмяМетаданных, Настройки)
//   URC_Клиент.Записать(ДанныеОбъекта, РежимЗаписи, Настройки)
//   URC_Клиент.ЭтоУдаленнаяСсылка(Значение)
//   URC_Клиент.ПолучитьПроцедуры(ConnectionCode, Настройки)
//   URC_Клиент.ВыполнитьПроцедуру(ConnectionCode, ИмяПроцедуры, Параметры, Настройки)
//
// Полное руководство: URC_Remote1C_Руководство_технического_специалиста.docx
// в каталоге компонента расширения. Ниже - рабочие примеры для каждого сценария; код рассчитан на прямое
// выполнение в этой базе (после настройки соединения erp_my) либо на адаптацию под конкретную задачу.

#Область Настройка

Процедура НастроитьСоединения() Экспорт

	Соединение = URC_Настройки.НоваяНастройкаСоединения();
	Соединение.Вставить("Node", "ERP_PROD");
	Соединение.Вставить("Наименование", "ERP production / primary URL");
	Соединение.Вставить("БазовыйURL", "https://server.example.com/erp");
	Соединение.Вставить("Активен", Истина);
	Соединение.Вставить("РежимСериализации", "portable");
	Соединение.Вставить("ТаймаутHTTP", 60);
	Соединение.Вставить("Пользователь", "remote_user");
	Соединение.Вставить("Секрет", "password");
	URC_Настройки.СохранитьСоединение("erp_my", Соединение);

	// Второе подключение к тому же Node имеет собственный ConnectionCode.
	РезервноеСоединение = URC_Настройки.НоваяНастройкаСоединения();
	ЗаполнитьЗначенияСвойств(РезервноеСоединение, Соединение);
	РезервноеСоединение.Вставить("БазовыйURL", "https://backup.example.com/erp");
	URC_Настройки.СохранитьСоединение("erp_backup", РезервноеСоединение);

КонецПроцедуры

Процедура РазрешитьВходящийRemote1C() Экспорт

	// Выполнять в базе-сервере под пользователем входящего HTTP-вызова.
	ЛокальныеНастройки = URC_Настройки.ПолучитьЛокальныеНастройки();
	ЛокальныеНастройки.Вставить("КодУзла", "ERP_PROD");
	URC_Настройки.СохранитьЛокальныеНастройки(ЛокальныеНастройки);

	НастройкиБезопасности = URC_Настройки.ПолучитьНастройкиБезопасности();
	НастройкиБезопасности.Вставить("РазрешитьRemote1C", Истина);
	НастройкиБезопасности.Вставить("AllowObjectWrite", Истина);
	НастройкиБезопасности.Вставить("ObjectWriteStrictMode", Истина);
	РазрешенныеМетаданные = Новый Массив;
	РазрешенныеМетаданные.Добавить("Справочник.Номенклатура");
	РазрешенныеМетаданные.Добавить("Документ.РеализацияТоваровУслуг");
	НастройкиБезопасности.Вставить(
		"ObjectWriteAllowedMetadata", РазрешенныеМетаданные);
	URC_Настройки.СохранитьНастройкиБезопасности(НастройкиБезопасности);

КонецПроцедуры

#КонецОбласти

#Область ИменованныеПроцедуры

// Примеры процедур соответствуют разделу 17 технического руководства.
// До клиентских вызовов администратор сервера регистрирует Diagnostics.Echo.v1
// с обработчиком URC_ПримерыИспользования.ЭхоПроцедуры, включает строку реестра
// и AllowProcedureExecute. Также нужны РазрешитьRemote1C и права Use новых HTTP-методов.
// Примеры не включают эти разрешения и не сохраняют реестр автоматически.
// Параметры и результат всегда portable; Timeout не означает отмену обработки на сервере.
// POST не повторяется: после таймаута сначала выясните результат операции по RequestId.

// Пример серверного обработчика: одна экспортная функция с одним параметром.
// Не изменяет данные; отсутствие параметров даёт Неопределено.
Функция ЭхоПроцедуры(Параметры) Экспорт

	Возврат Параметры;

КонецФункции

// Подготовить копию текущего реестра для просмотра администратором.
// Новая строка выключена; существующее одноимённое правило не перезаписывается.
// После проверки таблицу можно сохранить через URC_Настройки.СохранитьХранимыеПроцедуры.
Функция ПодготовитьПримерРеестраПроцедур() Экспорт

	Реестр = URC_Настройки.ПолучитьХранимыеПроцедуры();
	Для Каждого ЗаписьРеестра Из Реестр Цикл
		Если ВРег(ЗаписьРеестра.Имя) = ВРег("Diagnostics.Echo.v1") Тогда
			Возврат Реестр;
		КонецЕсли;
	КонецЦикла;
	ЗаписьРеестра = Реестр.Добавить();
	ЗаписьРеестра.Имя = "Diagnostics.Echo.v1";
	ЗаписьРеестра.Обработчик = "URC_ПримерыИспользования.ЭхоПроцедуры";
	ЗаписьРеестра.Разрешена = Ложь;
	ЗаписьРеестра.Описание = НСтр("ru = 'Диагностическое эхо параметров без изменения данных'; en = 'Diagnostic parameter echo without data changes'");
	Возврат Реестр;

КонецФункции

// Массив структур Имя, Разрешена, Описание; внутренних обработчиков в ответе нет.
// Список доступен и при AllowProcedureExecute=Ложь, если разрешён входящий Remote1C.
Функция ПримерСпискаПроцедур(ConnectionCode) Экспорт

	Возврат URC_Клиент.ПолучитьПроцедуры(ConnectionCode);

КонецФункции

// Echo возвращает Неопределено, когда контейнер параметров не передан.
Функция ПримерПроцедурыБезПараметров(ConnectionCode) Экспорт

	Возврат URC_Клиент.ВыполнитьПроцедуру(ConnectionCode, "Diagnostics.Echo.v1");

КонецФункции

// Структура и вложенный массив проходят рекурсивное portable-преобразование.
Функция ПримерПроцедурыСоСтруктурой(ConnectionCode) Экспорт

	МассивЗначений = Новый Массив;
	МассивЗначений.Добавить(10);
	МассивЗначений.Добавить(Истина);
	Параметры = Новый Структура("Текст,Значения", "Remote1C", МассивЗначений);
	Настройки = Новый Структура("Timeout", 60);
	Возврат URC_Клиент.ВыполнитьПроцедуру(
		ConnectionCode, "Diagnostics.Echo.v1", Параметры, Настройки);

КонецФункции

// Таблица передаётся внутри структуры. Имена колонок и значения сохраняются;
// типизация колонок и фиксированность коллекций не являются контрактом переноса.
Функция ПримерПроцедурыСТаблицей(ConnectionCode) Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Код");
	Таблица.Колонки.Добавить("Количество");
	СтрокаТаблицы = Таблица.Добавить();
	СтрокаТаблицы.Код = "TEST-001";
	СтрокаТаблицы.Количество = 2;
	Параметры = Новый Структура("Строки", Таблица);
	Возврат URC_Клиент.ВыполнитьПроцедуру(ConnectionCode, "Diagnostics.Echo.v1", Параметры);

КонецФункции

// Данные — ДвоичныеДанные. Транспорт использует RemoteBinaryData/Base64;
// Ответ.Данные снова содержит ДвоичныеДанные. Чтение файла выполняет вызывающий код.
Функция ПримерПроцедурыСДвоичнымиДанными(ConnectionCode, Данные) Экспорт

	Параметры = Новый Структура("Данные", Данные);
	Возврат URC_Клиент.ВыполнитьПроцедуру(ConnectionCode, "Diagnostics.Echo.v1", Параметры);

КонецФункции

// RemoteReference и RemoteEnum получают из этой же базы через этот же ConnectionCode.
// Не подменяйте Node/ConnectionCode вручную: клиент проверяет их до POST.
// На сервере обработчик получает нативные значения, на клиенте — переносимые дескрипторы.
Функция ПримерПроцедурыСУдаленнымиЗначениями(ConnectionCode, УдаленнаяСсылка, УдаленноеПеречисление = Неопределено) Экспорт

	Параметры = Новый Структура("Ссылка,Перечисление", УдаленнаяСсылка, УдаленноеПеречисление);
	Возврат URC_Клиент.ВыполнитьПроцедуру(ConnectionCode, "Diagnostics.Echo.v1", Параметры);

КонецФункции

// Прикладной пример: Sales.FillOrder.v1 необходимо отдельно реализовать и зарегистрировать.
// УдаленныйЗаказ должен быть получен через этот же ConnectionCode.
// AllowObjectWrite и список Metadata объектного API не ограничивают код обработчика;
// проверки бизнес-доступа и транзакцию при необходимости реализует сам обработчик.
Функция ПримерВызоваИменованнойПроцедуры(ConnectionCode, УдаленныйЗаказ) Экспорт

	Параметры = Новый Структура("Заказ,ПерезаполнитьЦены", УдаленныйЗаказ, Истина);
	Возврат URC_Клиент.ВыполнитьПроцедуру(ConnectionCode, "Sales.FillOrder.v1", Параметры);

КонецФункции

#КонецОбласти

#Область Диагностика

Функция ПроверитьСоединение() Экспорт

	ОтветPing = URC_Клиент.Ping("erp_my");
	Возможности = URC_Клиент.ПолучитьВозможности("erp_my");

	Возврат Новый Структура(
		"Ping,Capabilities",
		ОтветPing,
		Возможности);

КонецФункции

Функция ПрочитатьУдаленноеХранилище(УдаленноеХранилище) Экспорт

	// ConnectionCode берётся из RemoteValueStorage и должен совпадать
	// с ConnectionCode вложенного RemoteReference.
	Возврат URC_Клиент.ПолучитьЗначениеХранилища(УдаленноеХранилище);

КонецФункции

// Явно заменяет содержимое реквизита ХранилищеЗначения в полученном снимке объекта.
Функция ИзменитьХранилищеРеквизита(ДанныеОбъекта, ИмяРеквизита, НовоеСодержимое) Экспорт

	ИсходныйДескриптор = ДанныеОбъекта.Реквизиты[ИмяРеквизита];
	ДанныеОбъекта.Реквизиты.Вставить(
		ИмяРеквизита,
		URC_Клиент.ИзменитьЗначениеХранилища(ИсходныйДескриптор, НовоеСодержимое));
	Возврат URC_Клиент.Записать(ДанныеОбъекта);

КонецФункции

// Очищает реквизит ХранилищеЗначения явной операцией Clear.
Функция ОчиститьХранилищеРеквизита(ДанныеОбъекта, ИмяРеквизита) Экспорт

	ИсходныйДескриптор = ДанныеОбъекта.Реквизиты[ИмяРеквизита];
	ДанныеОбъекта.Реквизиты.Вставить(
		ИмяРеквизита,
		URC_Клиент.ОчиститьЗначениеХранилища(ИсходныйДескриптор));
	Возврат URC_Клиент.Записать(ДанныеОбъекта);

КонецФункции

// Копирует содержимое между хранилищами на удалённом сервере без передачи содержимого клиенту.
Функция СкопироватьУдаленноеХранилище(
	ДанныеОбъекта, ИмяРеквизитаНазначения, ДескрипторИсточника) Экспорт

	ДескрипторНазначения = ДанныеОбъекта.Реквизиты[ИмяРеквизитаНазначения];
	ДанныеОбъекта.Реквизиты.Вставить(
		ИмяРеквизитаНазначения,
		URC_Клиент.СкопироватьЗначениеХранилища(
			ДескрипторНазначения, ДескрипторИсточника));
	Возврат URC_Клиент.Записать(ДанныеОбъекта);

КонецФункции

// Изменяет выбранную ячейку ХранилищеЗначения в табличной части.
// URC__RowId остаётся в строке и используется сервером для устойчивой адресации.
Функция ИзменитьХранилищеВСтрокеТЧ(ДанныеОбъекта, ИмяТЧ, НомерСтроки, ИмяКолонки, НовоеСодержимое) Экспорт

	ТаблицаТЧ = ДанныеОбъекта.ТабличныеЧасти[ИмяТЧ];
	ИсходныйДескриптор = ТаблицаТЧ[НомерСтроки][ИмяКолонки];
	ТаблицаТЧ[НомерСтроки][ИмяКолонки] = URC_Клиент.ИзменитьЗначениеХранилища(
		ИсходныйДескриптор, НовоеСодержимое);
	Возврат URC_Клиент.Записать(ДанныеОбъекта);

КонецФункции

// Добавляет строку: пустой URC__RowId означает новую строку, а Set задаётся через специальный конструктор.
Процедура ДобавитьСтрокуСХранилищем(ТаблицаТЧ, ИмяКолонки, НовоеСодержимое) Экспорт

	НоваяСтрока = ТаблицаТЧ.Добавить();
	НоваяСтрока.URC__RowId = "";
	НоваяСтрока[ИмяКолонки] = URC_Клиент.НовоеЗначениеХранилища(НовоеСодержимое);

КонецПроцедуры

#КонецОбласти

#Область Запросы

Функция ВыполнитьПростойЗапрос() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Момент", ТекущаяДатаСеанса());

	ТекстЗапроса =
	"ВЫБРАТЬ
	|    &Момент КАК МоментКлиента,
	|    1 КАК Значение";

	Возврат URC_Клиент.ВыполнитьЗапрос(
		"erp_my",
		ТекстЗапроса,
		Параметры);

КонецФункции

Функция ПолучитьНоменклатуруСРеквизитами() Экспорт

	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 10
	|    Номенклатура.Ссылка КАК Ссылка,
	|    Номенклатура.Код КАК Код,
	|    Номенклатура.Наименование КАК Наименование
	|ИЗ
	|    Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|    НЕ Номенклатура.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|    Номенклатура.Код";

	Данные = URC_Клиент.ВыполнитьЗапрос("erp_my", ТекстЗапроса);
	Результат = Новый Массив;
	Для Каждого СтрокаДанных Из Данные Цикл
		Если URC_Клиент.ЭтоУдаленнаяСсылка(СтрокаДанных.Ссылка) Тогда
			Реквизиты = URC_Клиент.ПолучитьРеквизиты(
				СтрокаДанных.Ссылка,
				"Код,Наименование,Артикул");
			Результат.Добавить(Реквизиты);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ВыполнитьЗапросСДиагностикой() Экспорт

	НастройкиВызова = Новый Структура(
		"Timeout,SerializationMode",
		30,
		"portable");

	Возврат URC_Клиент.ВыполнитьЗапросРасширенно(
		"erp_my",
		"ВЫБРАТЬ 1 КАК Значение",
		Неопределено,
		НастройкиВызова);

КонецФункции

// Полная вложенная табличная часть приходит одним запросом, без отдельных HTTP-вызовов
// на каждую строку или табличную часть.
Функция ПолучитьРеализациюСТоварамиОднимЗапросом() Экспорт

	ТекстЗапроса =
	"ВЫБРАТЬ
	|    Реализация.Ссылка КАК Ссылка,
	|    Реализация.Номер КАК Номер,
	|    Реализация.Товары КАК Товары
	|ИЗ
	|    Документ.РеализацияТоваровУслуг КАК Реализация
	|ГДЕ
	|    НЕ Реализация.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|    Реализация.Номер";

	Возврат URC_Клиент.ВыполнитьЗапрос("erp_my", ТекстЗапроса);

КонецФункции

// Товары.(Номенклатура, Количество) в списке полей: во вложенной таблице придут только эти колонки.
Функция ПолучитьРеализациюСВыбраннымиКолонкамиТовара() Экспорт

	ТекстЗапроса =
	"ВЫБРАТЬ
	|    Реализация.Ссылка КАК Ссылка,
	|    Реализация.Товары.(
	|        Номенклатура,
	|        Количество) КАК Товары
	|ИЗ
	|    Документ.РеализацияТоваровУслуг КАК Реализация";

	Возврат URC_Клиент.ВыполнитьЗапрос("erp_my", ТекстЗапроса);

КонецФункции

Функция НайтиРеализациюПоНомеру(НомерДокумента, ДатаДокумента, УдаленнаяОрганизация) Экспорт

	ДополнительныйОтбор = Новый Структура;
	ДополнительныйОтбор.Вставить("Дата", ДатаДокумента);
	ДополнительныйОтбор.Вставить("Организация", УдаленнаяОрганизация);
	ДополнительныйОтбор.Вставить("ПометкаУдаления", Ложь);

	Возврат URC_Клиент.НайтиУдаленнуюСсылку(
		"erp_my",
		"Документ.РеализацияТоваровУслуг",
		"Номер",
		НомерДокумента,
		ДополнительныйОтбор);

КонецФункции

#КонецОбласти

#Область ДанныеОбъекта

// Полное получение данных объекта: все реквизиты и все табличные части за один HTTP-вызов.
Функция ПолучитьПолныеДанныеРеализации(УдаленнаяСсылкаНаДокумент) Экспорт

	Данные = URC_Клиент.ПолучитьДанныеОбъекта(УдаленнаяСсылкаНаДокумент);

	Товары = Новый Массив;
	Для Каждого СтрокаТовара Из Данные.ТабличныеЧасти.Товары Цикл
		Товары.Добавить(
			Новый Структура(
				"Номенклатура,Количество,Цена",
				СтрокаТовара.Номенклатура,
				СтрокаТовара.Количество,
				СтрокаТовара.Цена));
	КонецЦикла;

	Возврат Новый Структура(
		"Номер,Дата,Товары",
		Данные.Реквизиты.Номер,
		Данные.Реквизиты.Дата,
		Товары);

КонецФункции

// Выборочное чтение: только заданные реквизиты и одна табличная часть с заданными колонками.
Функция ПолучитьВыборочныеДанныеРеализации(УдаленнаяСсылкаНаДокумент) Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("Реквизиты", "Номер,Дата,Организация");

	ТабличныеЧасти = Новый Структура;
	ТабличныеЧасти.Вставить("Товары", "Номенклатура,Количество,Цена");
	Настройки.Вставить("ТабличныеЧасти", ТабличныеЧасти);

	Возврат URC_Клиент.ПолучитьДанныеОбъекта(УдаленнаяСсылкаНаДокумент, Настройки);

КонецФункции

// Только шапка объекта, без чтения табличных частей.
Функция ПолучитьТолькоШапкуОбъекта(УдаленнаяСсылка) Экспорт

	Настройки = Новый Структура("ТабличныеЧасти", Ложь);
	Возврат URC_Клиент.ПолучитьДанныеОбъекта(УдаленнаяСсылка, Настройки);

КонецФункции

// Ссылка, полученная во вложенной таблице результата запроса, - обычная RemoteReference:
// её можно передать и в ПолучитьРеквизиты(), и в ПолучитьДанныеОбъекта() того же узла.
Функция ПолучитьДанныеНоменклатурыИзСтрокиТовара(СтрокаТовара) Экспорт

	Если Не URC_Клиент.ЭтоУдаленнаяСсылка(СтрокаТовара.Номенклатура) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат URC_Клиент.ПолучитьДанныеОбъекта(СтрокаТовара.Номенклатура);

КонецФункции

#КонецОбласти

#Область ОбъектноеЧтениеИЗапись

Функция ИзменитьУдаленнуюНоменклатуру(УдаленнаяНоменклатура) Экспорт

	Номенклатура = URC_Клиент.ПолучитьОбъект(УдаленнаяНоменклатура);
	Номенклатура.Реквизиты.Наименование = "Новое наименование";
	Возврат URC_Клиент.Записать(Номенклатура);

КонецФункции

Функция СоздатьУдаленнуюНоменклатуру() Экспорт

	Номенклатура = URC_Клиент.СоздатьОбъект("erp_my", "Справочник.Номенклатура");
	Номенклатура.Реквизиты.Наименование = "Новый товар";
	Возврат URC_Клиент.Записать(Номенклатура);

КонецФункции

Функция ПровестиУдаленныйДокумент(УдаленныйДокумент) Экспорт

	Документ = URC_Клиент.ПолучитьОбъект(УдаленныйДокумент);
	Документ.Реквизиты.Комментарий = "Изменено через Remote1C";
	Возврат URC_Клиент.Записать(Документ, "Проведение");

КонецФункции

#КонецОбласти

#Область ОбработкаОшибок

Функция БезопасноВыполнитьЗапрос(ТекстЗапроса, Параметры = Неопределено) Экспорт

	Попытка
		Возврат URC_Клиент.ВыполнитьЗапрос(
			"erp_my",
			ТекстЗапроса,
			Параметры);
	Исключение
		ЗаписьЖурналаРегистрации(
			"MyIntegration.Remote1C.Error",
			УровеньЖурналаРегистрации.Ошибка,
			Неопределено,
			Неопределено,
			ОписаниеОшибки());
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

#КонецОбласти
