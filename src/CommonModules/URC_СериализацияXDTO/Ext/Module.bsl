
#Область ПрограммныйИнтерфейс

Функция СериализоватьВJSON(Значение) Экспорт

	Попытка
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		СериализаторXDTO.ЗаписатьJSON(Запись, Значение, НазначениеТипаXML.Явное);
		Возврат Запись.Закрыть();
	Исключение
		ВызватьИсключение "XDTO_SERIALIZATION_ERROR|"
			+ НСтр("ru = 'Ошибка сериализации XDTO JSON'; en = 'XDTO JSON serialization error'")
			+ ": " + ОписаниеОшибки();
	КонецПопытки;

КонецФункции

Функция ДесериализоватьИзJSON(СтрокаJSON) Экспорт

	Если ПустаяСтрока(СтрокаJSON) Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Пустое тело HTTP-запроса'; en = 'HTTP request body is empty'");
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(СтрокаJSON);
		Значение = СериализаторXDTO.ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Возврат Значение;
	Исключение
		ВызватьИсключение "XDTO_DESERIALIZATION_ERROR|"
			+ НСтр("ru = 'Ошибка десериализации XDTO JSON'; en = 'XDTO JSON deserialization error'")
			+ ": " + ОписаниеОшибки();
	КонецПопытки;

КонецФункции

Функция Самопроверка() Экспорт

	Тест = Новый Структура(
		"Protocol,RequestId,Value",
		URC_Протокол.ВерсияПротокола(), Новый УникальныйИдентификатор, 1);
	Результат = ДесериализоватьИзJSON(СериализоватьВJSON(Тест));
	Возврат ТипЗнч(Результат) = Тип("Структура")
		И Результат.Protocol = URC_Протокол.ВерсияПротокола();

КонецФункции

#КонецОбласти
