
#Область ПрограммныйИнтерфейс

Функция ВыполнитьЗапрос(ТекстЗапроса, Параметры, РежимСериализации, КодТекущегоУзла) Экспорт

	Если ТипЗнч(ТекстЗапроса) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(ТекстЗапроса)) Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Query должен быть непустой строкой'; en = 'Query must be a non-empty string'");
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;

	Если Параметры <> Неопределено Тогда
		Если ТипЗнч(Параметры) <> Тип("Структура")
			И ТипЗнч(Параметры) <> Тип("ФиксированнаяСтруктура") Тогда
			ВызватьИсключение "BAD_REQUEST|Parameters должен иметь тип Структура";
		КонецЕсли;

		Для Каждого Параметр Из Параметры Цикл
			ЗначениеПараметра = URC_ПортативныеТипы.ВосстановитьПараметр(
				Параметр.Значение, КодТекущегоУзла);
			Запрос.УстановитьПараметр(Параметр.Ключ, ЗначениеПараметра);
		КонецЦикла;
	КонецЕсли;

	НачалоЗапроса = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
	Исключение
		ВызватьИсключение "QUERY_EXECUTION_ERROR|"
			+ НСтр("ru = 'Ошибка выполнения запроса'; en = 'Query execution error'")
			+ ": " + ОписаниеОшибки();
	КонецПопытки;
	QueryMs = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗапроса;

	NormalizeMs = 0;
	Если РежимСериализации = URC_Протокол.РежимPortable() Тогда
		НачалоНормализации = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ТаблицаРезультата = URC_ПортативныеТипы.НормализоватьЗначение(
			ТаблицаРезультата, КодТекущегоУзла);
		NormalizeMs = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоНормализации;
	ИначеЕсли РежимСериализации = URC_Протокол.РежимNativeXDTO() Тогда
		// В native-xdto ссылки/перечисления остаются нативными,
		// но вложенный РезультатЗапроса (полная или Товары.(...) табличная часть в списке полей)
		// всё равно структурно преобразуется в ТаблицаЗначений, иначе штатный XDTO не сериализует его.
		НачалоНормализации = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ТаблицаРезультата = URC_ПортативныеТипы.СтруктурнаяНормализация(ТаблицаРезультата);
		NormalizeMs = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоНормализации;
	Иначе
		ВызватьИсключение "BAD_REQUEST|Неподдерживаемый SerializationMode";
	КонецЕсли;

	Возврат Новый Структура(
		"Data,RowCount,QueryMs,NormalizeMs",
		ТаблицаРезультата,
		ТаблицаРезультата.Количество(),
		QueryMs,
		NormalizeMs);

КонецФункции

#КонецОбласти
