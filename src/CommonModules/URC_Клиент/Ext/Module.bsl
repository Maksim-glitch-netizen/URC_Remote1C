
#Область ПрограммныйИнтерфейс

Функция ВыполнитьЗапрос(ConnectionCode, ТекстЗапроса, Параметры = Неопределено, Настройки = Неопределено) Экспорт

	Возврат ВыполнитьЗапросРасширенно(
		ConnectionCode, ТекстЗапроса, Параметры, Настройки).Данные;

КонецФункции

Функция ВыполнитьЗапросРасширенно(ConnectionCode, ТекстЗапроса, Параметры = Неопределено, Настройки = Неопределено) Экспорт

	НачалоОперации = ТекущаяУниверсальнаяДатаВМиллисекундах();
	RequestId = Новый УникальныйИдентификатор;
	РежимСериализации = URC_Протокол.РежимPortable();
	Попытка
		Узел = ПолучитьУзел(ConnectionCode);
		Node = NodeСоединения(Узел);
		РежимСериализации = РежимСериализацииУзла(Узел, Настройки);
		ПодготовленныеПараметры = URC_ПортативныеТипы.ПодготовитьПараметры(
			Параметры, Node, ConnectionCode);

		ТранспортныйЗапрос = Новый Структура;
		ТранспортныйЗапрос.Вставить("Protocol", URC_Протокол.ВерсияПротокола());
		ТранспортныйЗапрос.Вставить("RequestId", RequestId);
		ТранспортныйЗапрос.Вставить("ConnectionCode", ConnectionCode);
		ТранспортныйЗапрос.Вставить("Query", ТекстЗапроса);
		ТранспортныйЗапрос.Вставить("Parameters", ПодготовленныеПараметры);
		ТранспортныйЗапрос.Вставить(
			"Options", Новый Структура("SerializationMode", РежимСериализации));

		НачалоXDTO = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Тело = URC_СериализацияXDTO.СериализоватьВJSON(ТранспортныйЗапрос);
		XDTOКлиентаМС = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоXDTO;
		РезультатHTTP = URC_HTTPКлиент.ОтправитьPOST(Узел, "query", Тело, Настройки);
		XDTOКлиентаМС = XDTOКлиентаМС + РезультатHTTP.XDTOMs;
		Ответ = ПроверитьОтвет(РезультатHTTP.Response, РезультатHTTP.HTTPStatus, RequestId);
		Execution = ПроверитьИсполнение(Ответ, "RowCount");
		ПроверитьNodeОтвета(Ответ, Execution, Node);
		Ответ.Вставить("Data", URC_ПортативныеТипы.ПривязатьКонтекстСоединения(
			Ответ.Data, ConnectionCode, Node));
		TotalMs = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОперации;
		XDTOMs = XDTOКлиентаМС + ЗначениеСтруктуры(Execution, "XDTOMs", 0);
		Результат = Новый Структура(
			"Данные,RequestId,КоличествоСтрок,ДлительностьМС,РежимСериализации,QueryMs,AttributesMs,NormalizeMs,XDTOMs",
			Ответ.Data,
			Ответ.RequestId,
			Execution.RowCount,
			TotalMs,
			РежимСериализации,
			ЗначениеСтруктуры(Execution, "QueryMs", 0),
			0,
			ЗначениеСтруктуры(Execution, "NormalizeMs", 0),
			XDTOMs);
		ДанныеЛога = НовыеДанныеЛога(
			"Query", ConnectionCode, RequestId, РежимСериализации, Node);
		ДобавитьМетрикиЛога(ДанныеЛога, Execution, XDTOMs, TotalMs);
		ДанныеЛога.Вставить("Статус", "success");
		URC_Логирование.ЗаписатьОперацию(ДанныеЛога);
		Возврат Результат;
	Исключение
		КодОшибки = КодОшибкиИзТекста(ОписаниеОшибки());
		ДанныеЛога = НовыеДанныеЛога("Query", ConnectionCode, RequestId, РежимСериализации);
		ДанныеЛога.Вставить("Статус", "error");
		ДанныеЛога.Вставить("КодОшибки", КодОшибки);
		ДанныеЛога.Вставить("TotalMs", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОперации);
		URC_Логирование.ЗаписатьОперацию(ДанныеЛога);
		ЗаписатьТранспортнуюОшибку(ConnectionCode, RequestId, КодОшибки);
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

// Находит ссылку на объект в удаленной информационной базе по значениям реквизитов.
//
// Параметры:
//  ConnectionCode             - Строка - код узла Remote1C.
//  ПолноеИмяМетаданных - Строка - полное имя объекта метаданных,
//                        например "Справочник.Контрагенты".
//  ИмяРеквизита        - Строка - имя основного реквизита поиска.
//  Значение            - Произвольный - значение основного реквизита.
//  ДополнительныйОтбор - Неопределено
//                      - Структура
//                      - ФиксированнаяСтруктура - дополнительные условия
//                        равенства; ключ содержит имя реквизита,
//                        значение содержит искомое значение.
//
// Возвращаемое значение:
//  Неопределено - объект не найден.
//  Структура - RemoteReference найденного объекта.
//
// Исключения:
//  BAD_REQUEST - некорректные параметры.
//  REMOTE_REFERENCE_NOT_UNIQUE - найдено несколько объектов.
//  REMOTE_REFERENCE_INVALID_RESULT - получен некорректный результат.
//  Также могут быть вызваны штатные исключения транспорта Remote1C.
//
Функция НайтиУдаленнуюСсылку(
	ConnectionCode,
	ПолноеИмяМетаданных,
	ИмяРеквизита,
	Значение,
	ДополнительныйОтбор = Неопределено) Экспорт

	Если ТипЗнч(ConnectionCode) <> Тип("Строка")
		Или ПустаяСтрока(СокрЛП(ConnectionCode)) Тогда
		ВызватьИсключение "BAD_REQUEST|ConnectionCode должен быть непустой строкой";
	КонецЕсли;
	ConnectionCode = СокрЛП(ConnectionCode);

	ПроверитьПолноеИмяМетаданныхДляПоиска(ПолноеИмяМетаданных);
	ПроверитьИмяРеквизитаДляПоиска(ИмяРеквизита);

	ДанныеЗапроса = ПодготовитьЗапросПоискаУдаленнойСсылки(
		ПолноеИмяМетаданных,
		ИмяРеквизита,
		Значение,
		ДополнительныйОтбор);
	Результат = ВыполнитьЗапрос(
		ConnectionCode,
		ДанныеЗапроса.Текст,
		ДанныеЗапроса.Параметры);

	Возврат УдаленнаяСсылкаИзРезультатаПоиска(
		Результат,
		ConnectionCode,
		ПолноеИмяМетаданных);

КонецФункции

Функция ПолучитьРеквизиты(УдаленнаяСсылка, ИменаРеквизитов = Неопределено, Настройки = Неопределено) Экспорт

	Если Не URC_ПортативныеТипы.ЭтоУдаленнаяСсылка(УдаленнаяСсылка) Тогда
		ВызватьИсключение "BAD_REQUEST|Параметр УдаленнаяСсылка должен быть RemoteReference";
	КонецЕсли;
	Контекст = ПолучитьКонтекстУдаленногоЗначения(УдаленнаяСсылка);
	ConnectionCode = Контекст.ConnectionCode;
	Node = Контекст.Node;

	НачалоОперации = ТекущаяУниверсальнаяДатаВМиллисекундах();
	RequestId = Новый УникальныйИдентификатор;
	Попытка
		ПроверитьНастройкиВызова(Настройки);
		Узел = ПолучитьУзел(ConnectionCode);
		ТранспортныйЗапрос = Новый Структура;
		ТранспортныйЗапрос.Вставить("Protocol", URC_Протокол.ВерсияПротокола());
		ТранспортныйЗапрос.Вставить("RequestId", RequestId);
		ТранспортныйЗапрос.Вставить("ConnectionCode", ConnectionCode);
		ТранспортныйЗапрос.Вставить("Reference", УдаленнаяСсылка);
		ТранспортныйЗапрос.Вставить("Attributes", ИменаРеквизитов);

		НачалоXDTO = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Тело = URC_СериализацияXDTO.СериализоватьВJSON(ТранспортныйЗапрос);
		XDTOКлиентаМС = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоXDTO;
		РезультатHTTP = URC_HTTPКлиент.ОтправитьPOST(Узел, "attributes", Тело, Настройки);
		XDTOКлиентаМС = XDTOКлиентаМС + РезультатHTTP.XDTOMs;
		Ответ = ПроверитьОтвет(РезультатHTTP.Response, РезультатHTTP.HTTPStatus, RequestId);
		Execution = ПроверитьИсполнение(Ответ, "AttributeCount");
		ПроверитьNodeОтвета(Ответ, Execution, Node);
		Ответ.Вставить("Data", URC_ПортативныеТипы.ПривязатьКонтекстСоединения(
			Ответ.Data, ConnectionCode, Node));
		TotalMs = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОперации;
		XDTOMs = XDTOКлиентаМС + ЗначениеСтруктуры(Execution, "XDTOMs", 0);
		ДанныеЛога = НовыеДанныеЛога(
			"GetAttributes", ConnectionCode, RequestId, URC_Протокол.РежимPortable(), Node);
		ДобавитьМетрикиЛога(ДанныеЛога, Execution, XDTOMs, TotalMs);
		ДанныеЛога.Вставить("Статус", "success");
		URC_Логирование.ЗаписатьОперацию(ДанныеЛога);
		Возврат Ответ.Data;
	Исключение
		КодОшибки = КодОшибкиИзТекста(ОписаниеОшибки());
		ДанныеЛога = НовыеДанныеЛога(
			"GetAttributes", ConnectionCode, RequestId, URC_Протокол.РежимPortable(), Node);
		ДанныеЛога.Вставить("Статус", "error");
		ДанныеЛога.Вставить("КодОшибки", КодОшибки);
		ДанныеЛога.Вставить("TotalMs", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОперации);
		URC_Логирование.ЗаписатьОперацию(ДанныеЛога);
		ЗаписатьТранспортнуюОшибку(ConnectionCode, RequestId, КодОшибки);
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

Функция ПолучитьДанныеОбъекта(УдаленнаяСсылка, Настройки = Неопределено) Экспорт

	Если Не URC_ПортативныеТипы.ЭтоУдаленнаяСсылка(УдаленнаяСсылка) Тогда
		ВызватьИсключение "BAD_REQUEST|Параметр УдаленнаяСсылка должен быть RemoteReference";
	КонецЕсли;
	Контекст = ПолучитьКонтекстУдаленногоЗначения(УдаленнаяСсылка);
	ConnectionCode = Контекст.ConnectionCode;
	Node = Контекст.Node;

	НачалоОперации = ТекущаяУниверсальнаяДатаВМиллисекундах();
	RequestId = Новый УникальныйИдентификатор;
	РежимСериализации = URC_Протокол.РежимPortable();
	Попытка
		Узел = ПолучитьУзел(ConnectionCode);
		РежимСериализации = РежимСериализацииУзла(Узел, Настройки);

		Реквизиты = Неопределено;
		ТабличныеЧасти = Неопределено;
		Если Настройки <> Неопределено Тогда
			Настройки.Свойство("Реквизиты", Реквизиты);
			Настройки.Свойство("ТабличныеЧасти", ТабличныеЧасти);
		КонецЕсли;
		НастройкиЧтения = Новый Структура("Attributes,TabularSections", Реквизиты, ТабличныеЧасти);

		ТранспортныйЗапрос = Новый Структура;
		ТранспортныйЗапрос.Вставить("Protocol", URC_Протокол.ВерсияПротокола());
		ТранспортныйЗапрос.Вставить("RequestId", RequestId);
		ТранспортныйЗапрос.Вставить("ConnectionCode", ConnectionCode);
		ТранспортныйЗапрос.Вставить("Reference", УдаленнаяСсылка);
		ТранспортныйЗапрос.Вставить("Settings", НастройкиЧтения);
		ТранспортныйЗапрос.Вставить(
			"Options", Новый Структура("SerializationMode", РежимСериализации));

		НачалоXDTO = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Тело = URC_СериализацияXDTO.СериализоватьВJSON(ТранспортныйЗапрос);
		XDTOКлиентаМС = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоXDTO;
		РезультатHTTP = URC_HTTPКлиент.ОтправитьPOST(Узел, "object-data", Тело, Настройки);
		XDTOКлиентаМС = XDTOКлиентаМС + РезультатHTTP.XDTOMs;
		Ответ = ПроверитьОтвет(РезультатHTTP.Response, РезультатHTTP.HTTPStatus, RequestId);
		Execution = ПроверитьИсполнение(Ответ, "AttributesCount");
		ПроверитьNodeОтвета(Ответ, Execution, Node);
		Ответ.Вставить("Data", URC_ПортативныеТипы.ПривязатьКонтекстСоединения(
			Ответ.Data, ConnectionCode, Node));
		TotalMs = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОперации;
		XDTOMs = XDTOКлиентаМС + ЗначениеСтруктуры(Execution, "XDTOMs", 0);

		ДанныеЛога = НовыеДанныеЛога(
			"GetObjectData", ConnectionCode, RequestId, РежимСериализации, Node);
		ДобавитьМетрикиЛогаОбъекта(ДанныеЛога, Execution, XDTOMs, TotalMs);
		ДанныеЛога.Вставить("Статус", "success");
		URC_Логирование.ЗаписатьОперацию(ДанныеЛога);
		Возврат Ответ.Data;
	Исключение
		КодОшибки = КодОшибкиИзТекста(ОписаниеОшибки());
		ДанныеЛога = НовыеДанныеЛога(
			"GetObjectData", ConnectionCode, RequestId, РежимСериализации, Node);
		ДанныеЛога.Вставить("Статус", "error");
		ДанныеЛога.Вставить("КодОшибки", КодОшибки);
		ДанныеЛога.Вставить("TotalMs", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОперации);
		URC_Логирование.ЗаписатьОперацию(ДанныеЛога);
		ЗаписатьТранспортнуюОшибку(ConnectionCode, RequestId, КодОшибки);
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

// Код узла определяется из RemoteReference без дублирующего параметра API.
// Получает удаленный объект для изменения и последующей записи через Записать().
//
// Параметры:
//  УдаленнаяСсылка - Структура - RemoteReference; поле Node определяет узел подключения.
//  Настройки - Структура, ФиксированнаяСтруктура, Неопределено - параметры HTTP-вызова.
//
// Возвращаемое значение:
//  Структура - данные удаленного объекта, включая реквизиты, табличные части и служебные данные.
Функция ПолучитьОбъект(УдаленнаяСсылка, Настройки = Неопределено) Экспорт

	Если Не URC_ПортативныеТипы.ЭтоУдаленнаяСсылка(УдаленнаяСсылка) Тогда
		ВызватьИсключение "REMOTE_OBJECT_INVALID|"
			+ НСтр(
				"ru = 'Параметр УдаленнаяСсылка должен быть RemoteReference'; "
				+ "en = 'RemoteReference parameter must be a RemoteReference'");
	КонецЕсли;
	Контекст = ПолучитьКонтекстУдаленногоЗначения(УдаленнаяСсылка);
	ConnectionCode = Контекст.ConnectionCode;

	ПроверитьВозможностьУзла(ConnectionCode, "ObjectGet", Настройки);
	ТранспортныйЗапрос = Новый Структура;
	ТранспортныйЗапрос.Вставить("Reference", УдаленнаяСсылка);
	ТранспортныйЗапрос.Вставить("Options", Новый Структура);
	Ответ = ВыполнитьОбъектныйPOST(
		ConnectionCode, URC_Протокол.ПутьПолученияОбъекта(), ТранспортныйЗапрос,
		"ObjectGet", "AttributesCount", Настройки);
	Возврат Ответ.Data;

КонецФункции

Функция СоздатьОбъект(ConnectionCode, ИмяМетаданных, Настройки = Неопределено) Экспорт

	Если ТипЗнч(ИмяМетаданных) <> Тип("Строка")
		Или ПустаяСтрока(СокрЛП(ИмяМетаданных)) Тогда
		ВызватьИсключение "OBJECT_TYPE_NOT_SUPPORTED|Не заполнено имя метаданных";
	КонецЕсли;
	ПроверитьВозможностьУзла(ConnectionCode, "ObjectNew", Настройки);
	ТранспортныйЗапрос = Новый Структура;
	ТранспортныйЗапрос.Вставить("Metadata", ИмяМетаданных);
	ТранспортныйЗапрос.Вставить("Options", Новый Структура);
	Ответ = ВыполнитьОбъектныйPOST(
		ConnectionCode, URC_Протокол.ПутьСозданияОбъекта(), ТранспортныйЗапрос,
		"ObjectNew", "AttributesCount", Настройки);
	Возврат Ответ.Data;

КонецФункции

Функция Записать(ДанныеОбъекта, РежимЗаписи = "Запись", Настройки = Неопределено) Экспорт

	ПроверитьНастройкиВызова(Настройки);
	ДанныеИзменений = URC_ДанныеОбъекта.РассчитатьИзменения(ДанныеОбъекта);
	СлужебныеДанные = ДанныеИзменений.ServiceData;
	Контекст = ПолучитьКонтекстУдаленногоЗначения(СлужебныеДанные);
	ConnectionCode = Контекст.ConnectionCode;
	URC_ПортативныеТипы.ПроверитьКонтекстСоединения(
		ДанныеИзменений.Original, ConnectionCode, Контекст.Node);
	ПривязанныеИзменения = URC_ПортативныеТипы.ПривязатьКонтекстСоединения(
		ДанныеИзменений.Changes, ConnectionCode, Контекст.Node);
	ПроверитьВозможностьУзла(ConnectionCode, "ObjectWrite", Настройки);
	ВозможностиХранилища = ОпределитьВозможностиИзмененийХранилища(ДанныеИзменений.Changes);
	Если ВозможностиХранилища.Write Тогда
		ПроверитьВозможностьУзла(ConnectionCode, "ValueStorageWrite", Настройки);
	КонецЕсли;
	Если ВозможностиХранилища.TablePart Тогда
		ПроверитьВозможностьУзла(ConnectionCode, "TablePartValueStorage", Настройки);
	КонецЕсли;
	Если ВозможностиХранилища.Copy Тогда
		ПроверитьВозможностьУзла(ConnectionCode, "ValueStorageServerCopy", Настройки);
	КонецЕсли;

	Если ДанныеИзменений.NoChanges И Не СлужебныеДанные.IsNew
		И ЭтоРежимОбычнойЗаписи(РежимЗаписи) Тогда
		Возврат Новый Структура(
			"Успех,RequestId,Ссылка,ЭтоНовый,РежимЗаписи,ИзмененоРеквизитов,ИзмененоТабличныхЧастей,ДлительностьМС,NoChanges",
			Истина,
			Новый УникальныйИдентификатор,
			СлужебныеДанные.Reference,
			Ложь,
			URC_Протокол.РежимЗаписиОбъекта(),
			0,
			0,
			0,
			Истина);
	КонецЕсли;

	ТранспортныйЗапрос = Новый Структура;
	ТранспортныйЗапрос.Вставить("Metadata", СлужебныеДанные.Metadata);
	ТранспортныйЗапрос.Вставить("Reference", СлужебныеДанные.Reference);
	ТранспортныйЗапрос.Вставить("IsNew", СлужебныеДанные.IsNew);
	ТранспортныйЗапрос.Вставить("WriteMode", РежимЗаписи);
	ПодготовленныеИзменения = URC_ПортативныеТипы.ПодготовитьИзмененияХранилища(
		ПривязанныеИзменения, Контекст.Node, ConnectionCode);
	ТранспортныйЗапрос.Вставить("Changes", ПодготовленныеИзменения);
	ТранспортныйЗапрос.Вставить("Original", ДанныеИзменений.Original);
	ТранспортныйЗапрос.Вставить("RemoteObjectData", СлужебныеДанные);
	Ответ = ВыполнитьОбъектныйPOST(
		ConnectionCode, URC_Протокол.ПутьЗаписиОбъекта(), ТранспортныйЗапрос,
		"ObjectWrite", "ChangedAttributesCount", Настройки);

	НовыйКонтейнер = Неопределено;
	Если Не Ответ.Data.Свойство("ObjectData", НовыйКонтейнер)
		Или ТипЗнч(НовыйКонтейнер) <> Тип("Структура") Тогда
		ВызватьИсключение "BAD_REQUEST|Удаленный узел не вернул обновленный снимок объекта";
	КонецЕсли;
	ДанныеОбъекта.Вставить("Реквизиты", НовыйКонтейнер.Реквизиты);
	ДанныеОбъекта.Вставить("ТабличныеЧасти", НовыйКонтейнер.ТабличныеЧасти);
	ДанныеОбъекта.Вставить("СлужебныеДанные", НовыйКонтейнер.СлужебныеДанные);
	Ответ.Data.Удалить("ObjectData");
	Возврат Ответ.Data;

КонецФункции

