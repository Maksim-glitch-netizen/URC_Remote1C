КонецФункции

// Публичный вызов зарегистрированной процедуры; автоматических повторов нет.
// ConnectionCode — код соединения; ИмяПроцедуры — публичное имя; Параметры — Структура/Неопределено.
// Настройки поддерживают Timeout. Возвращается непосредственно portable-результат обработчика.
Функция ВыполнитьПроцедуру(ConnectionCode, ИмяПроцедуры, Знач Параметры = Неопределено, Настройки = Неопределено) Экспорт
	ПроверитьНастройкиВызова(Настройки);
	URC_УдаленныеПроцедуры.ПроверитьИмяПроцедуры(ИмяПроцедуры);
	Если Параметры <> Неопределено И ТипЗнч(Параметры) <> Тип("Структура")
		И ТипЗнч(Параметры) <> Тип("ФиксированнаяСтруктура") Тогда
		ВызватьИсключение "UNSUPPORTED_PARAMETER_TYPE|" + НСтр("ru = 'Параметры должны быть структурой'; en = 'Parameters must be a structure'");
	КонецЕсли;
	Node = NodeСоединения(ПолучитьУзел(ConnectionCode));
	URC_ПортативныеТипы.ПроверитьКонтекстСоединения(Параметры, ConnectionCode, Node);
	Подготовленные = URC_ПортативныеТипы.ПреобразоватьЗначениеПроцедуры(Параметры, Node, "Parameters");
	ПроверитьВозможностьУзла(ConnectionCode, "ProcedureExecute", Настройки);
	Ответ = ВыполнитьОбъектныйPOST(ConnectionCode, URC_Протокол.ПутьВыполненияПроцедуры(),
		Новый Структура("Procedure,Parameters", ИмяПроцедуры, Подготовленные),
		"ProcedureExecute", "Procedure", Настройки);
	Если ТипЗнч(Ответ.Execution.Procedure) <> Тип("Строка")
		Или ВРег(Ответ.Execution.Procedure) <> ВРег(ИмяПроцедуры) Тогда
		ВызватьИсключение "BAD_REQUEST|" + НСтр("ru = 'В ответе указана другая процедура'; en = 'Response procedure does not match the request'");
	КонецЕсли;
	Возврат URC_ПортативныеТипы.ПреобразоватьЗначениеПроцедуры(Ответ.Data, Node, "ClientResult");
КонецФункции

// Возвращает массив публичных описаний: Имя, Разрешена, Описание. Внутренних обработчиков нет.
Функция ПолучитьПроцедуры(ConnectionCode, Настройки = Неопределено) Экспорт
	ПроверитьНастройкиВызова(Настройки);
	ПроверитьВозможностьУзла(ConnectionCode, "ProcedureExecute", Настройки);
	Ответ = ВыполнитьGET(ConnectionCode, URC_Протокол.ПутьСпискаПроцедур(), Настройки);
	Данные = Неопределено;
	Если Не Ответ.Свойство("Data", Данные) Или ТипЗнч(Данные) <> Тип("Массив") Тогда
		ВызватьИсключение "BAD_REQUEST|" + НСтр("ru = 'Некорректный список процедур'; en = 'Invalid procedure list'");
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого ЗаписьСписка Из Данные Цикл
		Если ТипЗнч(ЗаписьСписка) <> Тип("Структура")
			Или Не ЗаписьСписка.Свойство("Имя") Или Не ЗаписьСписка.Свойство("Разрешена")
			Или Не ЗаписьСписка.Свойство("Описание") Тогда
			ВызватьИсключение "BAD_REQUEST|" + НСтр("ru = 'Некорректная запись списка процедур'; en = 'Invalid procedure list entry'");
		КонецЕсли;
		Результат.Добавить(Новый Структура("Имя,Разрешена,Описание",
			ЗаписьСписка.Имя, ЗаписьСписка.Разрешена, ЗаписьСписка.Описание));
	КонецЦикла;
	Возврат Результат;
КонецФункции


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодготовитьЗапросПоискаУдаленнойСсылки(
	ПолноеИмяМетаданных,
	ИмяРеквизита,
	Значение,
	ДополнительныйОтбор)

	Если ДополнительныйОтбор <> Неопределено
		И ТипЗнч(ДополнительныйОтбор) <> Тип("Структура")
		И ТипЗнч(ДополнительныйОтбор) <> Тип("ФиксированнаяСтруктура") Тогда
		ВызватьИсключение "BAD_REQUEST|ДополнительныйОтбор должен иметь тип Структура";
	КонецЕсли;

	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("P0", Значение);
	ТекстУсловий = "    ИскомыеОбъекты." + ИмяРеквизита + " = &P0";
	ИндексПараметра = 1;

	Если ДополнительныйОтбор <> Неопределено Тогда
		Для Каждого ЭлементОтбора Из ДополнительныйОтбор Цикл
			ПроверитьИмяРеквизитаДляПоиска(ЭлементОтбора.Ключ);
			Если ВРег(ЭлементОтбора.Ключ) = ВРег(ИмяРеквизита) Тогда
				ВызватьИсключение "BAD_REQUEST|"
					+ "Реквизит основного поиска повторно указан в дополнительном отборе: "
					+ ИмяРеквизита;
			КонецЕсли;

			ИмяПараметра = "P" + Строка(ИндексПараметра);
			ТекстУсловий = ТекстУсловий + Символы.ПС
				+ "    И ИскомыеОбъекты." + ЭлементОтбора.Ключ + " = &" + ИмяПараметра;
			ПараметрыЗапроса.Вставить(ИмяПараметра, ЭлементОтбора.Значение);
			ИндексПараметра = ИндексПараметра + 1;
		КонецЦикла;
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 2" + Символы.ПС
		+ "    ИскомыеОбъекты.Ссылка КАК Ссылка" + Символы.ПС
		+ "ИЗ" + Символы.ПС
		+ "    " + ПолноеИмяМетаданных + " КАК ИскомыеОбъекты" + Символы.ПС
		+ "ГДЕ" + Символы.ПС
		+ ТекстУсловий;

	Возврат Новый Структура("Текст,Параметры", ТекстЗапроса, ПараметрыЗапроса);

КонецФункции

Функция УдаленнаяСсылкаИзРезультатаПоиска(Результат, ConnectionCode, ПолноеИмяМетаданных)

	ТекстНекорректногоРезультата = "REMOTE_REFERENCE_INVALID_RESULT|"
		+ "Удаленный запрос вернул некорректное значение ссылки";
	Попытка
		КоличествоРезультатов = Результат.Количество();
	Исключение
		ВызватьИсключение ТекстНекорректногоРезультата;
	КонецПопытки;

	Если КоличествоРезультатов = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если КоличествоРезультатов > 1 Тогда
		ВызватьИсключение "REMOTE_REFERENCE_NOT_UNIQUE|"
			+ "По заданным условиям найдено несколько объектов: " + ПолноеИмяМетаданных;
	КонецЕсли;

	Попытка
		УдаленнаяСсылка = Результат[0].Ссылка;
	Исключение
		ВызватьИсключение ТекстНекорректногоРезультата;
	КонецПопытки;

	Если Не URC_ПортативныеТипы.ЭтоУдаленнаяСсылка(УдаленнаяСсылка) Тогда
		ВызватьИсключение ТекстНекорректногоРезультата;
	КонецЕсли;

	Попытка
		ПолучитьКонтекстУдаленногоЗначения(УдаленнаяСсылка, ConnectionCode);
	Исключение
		ВызватьИсключение ТекстНекорректногоРезультата;
	КонецПопытки;

	Возврат УдаленнаяСсылка;

КонецФункции

Процедура ПроверитьПолноеИмяМетаданныхДляПоиска(ПолноеИмяМетаданных)

	Если ТипЗнч(ПолноеИмяМетаданных) <> Тип("Строка")
		Или ПустаяСтрока(ПолноеИмяМетаданных) Тогда
		ВызватьИсключение "BAD_REQUEST|ПолноеИмяМетаданных должно быть непустой строкой";
	КонецЕсли;

	ЧастиИмени = СтрРазделить(ПолноеИмяМетаданных, ".");
	Если ЧастиИмени.Количество() <> 2
		Или Не ЭтоДопустимоеИмяДляЗапроса(ЧастиИмени[0])
		Или Не ЭтоДопустимоеИмяДляЗапроса(ЧастиИмени[1]) Тогда
		ВызватьИсключение "BAD_REQUEST|Некорректное полное имя метаданных: "
			+ ПолноеИмяМетаданных;
	КонецЕсли;

	ПоддерживаемыеКатегории = СтрРазделить(
		"Справочник,Документ,ПланСчетов,ПланВидовХарактеристик,"
		+ "ПланВидовРасчета,ПланОбмена,БизнесПроцесс,Задача",
		",");
	КатегорияПоддерживается = Ложь;
	Для Каждого Категория Из ПоддерживаемыеКатегории Цикл
		Если ВРег(Категория) = ВРег(ЧастиИмени[0]) Тогда
			КатегорияПоддерживается = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не КатегорияПоддерживается Тогда
		ВызватьИсключение "REMOTE_REFERENCE_TYPE_NOT_SUPPORTED|"
			+ "Неподдерживаемый тип ссылочного объекта: " + ПолноеИмяМетаданных;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьИмяРеквизитаДляПоиска(ИмяРеквизита)

	Если Не ЭтоДопустимоеИмяДляЗапроса(ИмяРеквизита) Тогда
		ВызватьИсключение "BAD_REQUEST|Некорректное имя реквизита поиска: "
			+ Строка(ИмяРеквизита);
	КонецЕсли;

КонецПроцедуры

Функция ЭтоДопустимоеИмяДляЗапроса(Имя)

	Если ТипЗнч(Имя) <> Тип("Строка") Или ПустаяСтрока(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;

	ДопустимыеСимволы = "_0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ";
	ПервыйСимвол = ВРег(Лев(Имя, 1));
	Если СтрНайти("0123456789", ПервыйСимвол) > 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для ИндексСимвола = 1 По СтрДлина(Имя) Цикл
		Символ = ВРег(Сред(Имя, ИндексСимвола, 1));
		Если СтрНайти(ДопустимыеСимволы, Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ПолучитьУзел(ConnectionCode)

	Возврат URC_Настройки.ПолучитьСоединение(ConnectionCode);

КонецФункции

Функция NodeСоединения(Соединение)

	Node = "";
	Если ТипЗнч(Соединение) <> Тип("Структура")
		Или Не Соединение.Свойство("Node", Node)
		Или ТипЗнч(Node) <> Тип("Строка")
		Или ПустаяСтрока(СокрЛП(Node)) Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'В настройке соединения не заполнен Node'; en = 'Connection Node is missing'");
	КонецЕсли;
	Возврат СокрЛП(Node);

КонецФункции

Функция ПолучитьКонтекстУдаленногоЗначения(
	УдаленноеЗначение,
	ОжидаемыйConnectionCode = Неопределено)

	ConnectionCode = "";
	Если ТипЗнч(УдаленноеЗначение) <> Тип("Структура")
		Или Не УдаленноеЗначение.Свойство("ConnectionCode", ConnectionCode)
		Или ТипЗнч(ConnectionCode) <> Тип("Строка")
		Или ПустаяСтрока(СокрЛП(ConnectionCode)) Тогда
		ВызватьИсключение "REMOTE_CONNECTION_REQUIRED|"
			+ НСтр("ru = 'В удаленном значении отсутствует ConnectionCode'; en = 'Remote value has no ConnectionCode'");
	КонецЕсли;
	ConnectionCode = СокрЛП(ConnectionCode);
	Если ОжидаемыйConnectionCode <> Неопределено
		И ConnectionCode <> СокрЛП(ОжидаемыйConnectionCode) Тогда
		ВызватьИсключение "REMOTE_CONNECTION_MISMATCH|"
			+ НСтр("ru = 'Удаленное значение относится к другому соединению'; en = 'Remote value belongs to another connection'");
	КонецЕсли;

	Соединение = ПолучитьУзел(ConnectionCode);
	Node = NodeСоединения(Соединение);
	URC_ПортативныеТипы.ПроверитьКонтекстСоединения(
		УдаленноеЗначение, ConnectionCode, Node);
	Возврат Новый Структура(
		"ConnectionCode,Node,Соединение", ConnectionCode, Node, Соединение);

КонецФункции

Функция РежимСериализацииУзла(Узел, Настройки)

	ПроверитьНастройкиВызова(Настройки);
	Если Настройки <> Неопределено Тогда
		РежимИзНастроек = Неопределено;
		Если Настройки.Свойство("SerializationMode", РежимИзНастроек) Тогда
			Если РежимИзНастроек = "portable" Или РежимИзНастроек = "native-xdto" Тогда
				Возврат РежимИзНастроек;
			КонецЕсли;
			ВызватьИсключение "BAD_REQUEST|Неизвестный SerializationMode";
		КонецЕсли;
	КонецЕсли;

	РежимУзла = URC_Протокол.РежимPortable();
	Узел.Свойство("РежимСериализации", РежимУзла);
	Если РежимУзла = URC_Протокол.РежимNativeXDTO() Тогда
		Возврат URC_Протокол.РежимNativeXDTO();
	КонецЕсли;

	Возврат URC_Протокол.РежимPortable();

КонецФункции

Функция НовыеДанныеЛога(
	Операция,
	ConnectionCode,
	RequestId,
	Режим,
	Node = "")
	ДанныеЛога = Новый Структура;
	ДанныеЛога.Вставить("Операция", Операция);
	ДанныеЛога.Вставить("ConnectionCode", ConnectionCode);
	ДанныеЛога.Вставить("Узел", Node);
	ДанныеЛога.Вставить("RequestId", RequestId);
	ДанныеЛога.Вставить("Направление", "Outgoing");
	ДанныеЛога.Вставить("Режим", Режим);
	Возврат ДанныеЛога;
КонецФункции

Функция ПроверитьОтвет(Ответ, HTTPStatus, RequestId)

	Если ТипЗнч(Ответ) <> Тип("Структура") Тогда
		ВызватьИсключение "BAD_REQUEST|Удаленный узел вернул некорректный ответ";
	КонецЕсли;
	Протокол = "";
	Если Не Ответ.Свойство("Protocol", Протокол)
		Или Не URC_Протокол.ВерсияПротоколаСовместима(Протокол) Тогда
		ВызватьИсключение "PROTOCOL_MISMATCH|"
			+ НСтр("ru = 'Удаленный узел вернул несовместимую версию протокола'; en = 'Remote node returned an incompatible protocol version'");
	КонецЕсли;
	ОтветRequestId = Неопределено;
	Если Не Ответ.Свойство("RequestId", ОтветRequestId)
		Или Строка(ОтветRequestId) <> Строка(RequestId) Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'RequestId ответа не совпадает с запросом'; en = 'Response RequestId does not match request'");
	КонецЕсли;

	Статус = Неопределено;
	Если Ответ.Свойство("Status", Статус) И Статус = "success"
		И HTTPStatus >= 200 И HTTPStatus < 300 Тогда
		Возврат Ответ;
	КонецЕсли;

	КодОшибки = "INTERNAL_ERROR";
	ТекстОшибки = "Ошибка удаленного узла";
	Ошибка = Неопределено;
	Если Ответ.Свойство("Error", Ошибка) И ТипЗнч(Ошибка) = Тип("Структура") Тогда
		Ошибка.Свойство("Code", КодОшибки);
		Ошибка.Свойство("Message", ТекстОшибки);
	КонецЕсли;

	ВызватьИсключение КодОшибки + "|" + ТекстОшибки + "; RequestId=" + Строка(RequestId);

КонецФункции

Функция ПроверитьИсполнение(Ответ, ОбязательноеПоле)
	Execution = Неопределено;
	Если Не Ответ.Свойство("Execution", Execution)
		Или ТипЗнч(Execution) <> Тип("Структура")
		Или Не Execution.Свойство(ОбязательноеПоле) Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Удаленный узел вернул неполный блок Execution'; en = 'Remote node returned an incomplete Execution block'");
	КонецЕсли;
	Если Не Ответ.Свойство("Data") Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Удаленный узел не вернул Data'; en = 'Remote node did not return Data'");
	КонецЕсли;
	Возврат Execution;
КонецФункции

Процедура ПроверитьНастройкиВызова(Настройки)
	Если Настройки <> Неопределено И ТипЗнч(Настройки) <> Тип("Структура")
		И ТипЗнч(Настройки) <> Тип("ФиксированнаяСтруктура") Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Настройки вызова должны иметь тип Структура'; en = 'Call options must be a Structure'");
	КонецЕсли;
	Если Настройки <> Неопределено
		И (Настройки.Свойство("ConnectionCode")
			Или Настройки.Свойство("КодСоединения")
			Или Настройки.Свойство("Node")) Тогда
		ВызватьИсключение "BAD_REQUEST|"
			+ НСтр("ru = 'Контекст соединения нельзя переопределять через Настройки'; en = 'Connection context cannot be overridden through options'");
	КонецЕсли;
КонецПроцедуры

Функция ВыполнитьGET(ConnectionCode, Путь, Настройки)
	RequestId = Новый УникальныйИдентификатор;
	Попытка
		ПроверитьНастройкиВызова(Настройки);
		Узел = ПолучитьУзел(ConnectionCode);
		Node = NodeСоединения(Узел);
		РезультатHTTP = URC_HTTPКлиент.ОтправитьGET(Узел, Путь, Настройки);
		Ответ = РезультатHTTP.Response;
		Протокол = "";
		Если ТипЗнч(Ответ) <> Тип("Структура")
			Или Не Ответ.Свойство("Protocol", Протокол)
			Или Не URC_Протокол.ВерсияПротоколаСовместима(Протокол) Тогда
			ВызватьИсключение "PROTOCOL_MISMATCH|"
				+ НСтр("ru = 'Удаленный узел вернул несовместимую версию протокола'; en = 'Remote node returned an incompatible protocol version'");
		КонецЕсли;
		// GET списка процедур также сохраняет контрактные ошибки HTTP.
		Если Путь = URC_Протокол.ПутьСпискаПроцедур() Тогда
			ИдентификаторОтвета = Неопределено;
			Ответ.Свойство("RequestId", ИдентификаторОтвета);
			ПроверитьОтвет(Ответ, РезультатHTTP.HTTPStatus, ИдентификаторОтвета);
		КонецЕсли;
		ПроверитьNodeОтвета(Ответ, Неопределено, Node);
		Возврат Ответ;
	Исключение
		КодОшибки = КодОшибкиИзТекста(ОписаниеОшибки());
		ЗаписатьТранспортнуюОшибку(ConnectionCode, RequestId, КодОшибки);
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

Функция ВыполнитьОбъектныйPOST(
	ConnectionCode, Путь, ТранспортныйЗапрос, Операция, ОбязательноеПолеExecution, Настройки)

	НачалоОперации = ТекущаяУниверсальнаяДатаВМиллисекундах();
	RequestId = Новый УникальныйИдентификатор;
	ТранспортныйЗапрос.Вставить("Protocol", URC_Протокол.ВерсияПротокола());
	ТранспортныйЗапрос.Вставить("RequestId", RequestId);
	ТранспортныйЗапрос.Вставить("ConnectionCode", ConnectionCode);
	Node = "";
	Попытка
		Узел = ПолучитьУзел(ConnectionCode);
		Node = NodeСоединения(Узел);
		НачалоXDTO = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Тело = URC_СериализацияXDTO.СериализоватьВJSON(ТранспортныйЗапрос);
		XDTOMs = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоXDTO;
		РезультатHTTP = URC_HTTPКлиент.ОтправитьPOST(Узел, Путь, Тело, Настройки);
		XDTOMs = XDTOMs + РезультатHTTP.XDTOMs;
		Ответ = ПроверитьОтвет(РезультатHTTP.Response, РезультатHTTP.HTTPStatus, RequestId);
		Execution = ПроверитьИсполнение(Ответ, ОбязательноеПолеExecution);
		ПроверитьNodeОтвета(Ответ, Execution, Node);
		Ответ.Вставить("Data", URC_ПортативныеТипы.ПривязатьКонтекстСоединения(
			Ответ.Data, ConnectionCode, Node));
		ДанныеЛога = НовыеДанныеЛога(
			Операция, ConnectionCode, RequestId, URC_Протокол.РежимPortable(), Node);
		ДобавитьМетрикиЛогаОбъекта(
			ДанныеЛога, Execution, XDTOMs,
			ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОперации);
		// Журналируем только публичное имя, без параметров и результата.
		Если Операция = "ProcedureExecute" Тогда
			ДанныеЛога.Вставить("Procedure", ТранспортныйЗапрос.Procedure);
		КонецЕсли;
		Если Операция = "ValueStorageGet" Тогда
			ДобавитьДанныеЛогаХранилища(
				ДанныеЛога, ТранспортныйЗапрос.Storage, Execution);
		КонецЕсли;
		ДанныеЛога.Вставить("Статус", "success");
		URC_Логирование.ЗаписатьОперацию(ДанныеЛога);
		Возврат Ответ;
	Исключение
		КодОшибки = КодОшибкиИзТекста(ОписаниеОшибки());
		ДанныеЛога = НовыеДанныеЛога(
			Операция, ConnectionCode, RequestId, URC_Протокол.РежимPortable(), Node);
		ДанныеЛога.Вставить("Статус", "error");
		ДанныеЛога.Вставить("КодОшибки", КодОшибки);
		ДанныеЛога.Вставить("TotalMs", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОперации);
		// Журналируем только публичное имя, без параметров и результата.
		Если Операция = "ProcedureExecute" Тогда
			ДанныеЛога.Вставить("Procedure", ТранспортныйЗапрос.Procedure);
		КонецЕсли;
		Если Операция = "ValueStorageGet" Тогда
			ДобавитьДанныеЛогаХранилища(
				ДанныеЛога, ТранспортныйЗапрос.Storage, Неопределено);
		КонецЕсли;
		URC_Логирование.ЗаписатьОперацию(ДанныеЛога);
		ЗаписатьТранспортнуюОшибку(ConnectionCode, RequestId, КодОшибки);
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

Процедура ПроверитьNodeОтвета(Ответ, Execution, ОжидаемыйNode)

	ФактическийNode = "";
	Если ТипЗнч(Execution) = Тип("Структура") Тогда
		Execution.Свойство("ServerNode", ФактическийNode);
	ИначеЕсли ТипЗнч(Ответ) = Тип("Структура") Тогда
		Ответ.Свойство("ServerNode", ФактическийNode);
	КонецЕсли;
	Если ТипЗнч(ФактическийNode) <> Тип("Строка")
		Или ПустаяСтрока(СокрЛП(ФактическийNode))
		Или СокрЛП(ФактическийNode) <> СокрЛП(ОжидаемыйNode) Тогда
		ВызватьИсключение "CONNECTION_NODE_MISMATCH|"
			+ НСтр("ru = 'Соединение ведет к неожиданному Node'; en = 'Connection points to an unexpected Node'");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьВозможностьУзла(ConnectionCode, ИмяВозможности, Настройки)

	Возможности = ПолучитьВозможности(ConnectionCode, Настройки);
	Поддерживается = Ложь;
	Если Не Возможности.Свойство(ИмяВозможности, Поддерживается)
		Или Не Поддерживается Тогда
		ВызватьИсключение "FEATURE_NOT_SUPPORTED|"
			+ НСтр("ru = 'Удаленный узел не поддерживает операцию'; en = 'Remote node does not support the operation'")
			+ ": " + ИмяВозможности;
	КонецЕсли;

КонецПроцедуры

Функция ОпределитьВозможностиИзмененийХранилища(Изменения)

	Результат = Новый Структура("Write,TablePart,Copy", Ложь, Ложь, Ложь);
	Для Каждого Реквизит Из Изменения.Attributes Цикл
		ДобавитьВозможностиИзмененияХранилища(Результат, Реквизит.Значение);
	КонецЦикла;
	Для Каждого ТабличнаяЧасть Из Изменения.TableParts Цикл
		Для Каждого СтрокаТЧ Из ТабличнаяЧасть.Значение Цикл
			Для Каждого Колонка Из ТабличнаяЧасть.Значение.Колонки Цикл
				ДобавитьВозможностиИзмененияХранилища(Результат, СтрокаТЧ[Колонка.Имя]);
				Если URC_ПортативныеТипы.ЭтоИзменениеХранилища(СтрокаТЧ[Колонка.Имя]) Тогда
					Результат.TablePart = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДобавитьВозможностиИзмененияХранилища(Результат, Значение)

	Если Не URC_ПортативныеТипы.ЭтоИзменениеХранилища(Значение) Тогда
		Возврат;
	КонецЕсли;
	Результат.Write = Истина;
	Действие = "";
	Значение.Свойство("Action", Действие);
	Если Действие = "Copy" Тогда
		Результат.Copy = Истина;
	КонецЕсли;
	Основание = Неопределено;
	Если Значение.Свойство("Base", Основание)
		И URC_ПортативныеТипы.ЭтоУдаленноеХранилище(Основание) Тогда
		Расположение = "Attribute";
		Основание.Свойство("Location", Расположение);
		Если Расположение = "TablePart" Тогда
			Результат.TablePart = Истина;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ЭтоРежимОбычнойЗаписи(РежимЗаписи)

	Режим = НРег(СокрЛП(Строка(РежимЗаписи)));
	Возврат Режим = "запись" Или Режим = "write";

КонецФункции

Процедура ДобавитьМетрикиЛога(ДанныеЛога, Execution, XDTOMs, TotalMs)
	Для Каждого ИмяПоля Из СтрРазделить(
		"QueryMs,AttributesMs,NormalizeMs,RowCount,AttributeCount", ",") Цикл
		ЗначениеПоля = Неопределено;
		Если Execution.Свойство(ИмяПоля, ЗначениеПоля) Тогда
			ДанныеЛога.Вставить(ИмяПоля, ЗначениеПоля);
		КонецЕсли;
	КонецЦикла;
	ДанныеЛога.Вставить("XDTOMs", XDTOMs);
	ДанныеЛога.Вставить("TotalMs", TotalMs);
КонецПроцедуры

Процедура ДобавитьМетрикиЛогаОбъекта(ДанныеЛога, Execution, XDTOMs, TotalMs)
	Для Каждого ИмяПоля Из СтрРазделить(
		"AttributesCount,TabularSectionsCount,TabularRowsCount,ChangedAttributesCount,ChangedTablePartsCount,ChangedValueStoragesCount,ClearedValueStoragesCount,CopiedValueStoragesCount,ReadMs,NormalizeMs,WriteMs", ",") Цикл
		ЗначениеПоля = Неопределено;
		Если Execution.Свойство(ИмяПоля, ЗначениеПоля) Тогда
			ДанныеЛога.Вставить(ИмяПоля, ЗначениеПоля);
		КонецЕсли;
	КонецЦикла;
	ДанныеЛога.Вставить("XDTOMs", XDTOMs);
	ДанныеЛога.Вставить("TotalMs", TotalMs);
КонецПроцедуры

Процедура ДобавитьДанныеЛогаХранилища(
	ДанныеЛога,
	УдаленноеХранилище,
	Execution)

	Для Каждого ИмяПоля Из СтрРазделить(
		"Metadata,Location,Attribute,TablePart,Column,RowNumber", ",") Цикл
		ЗначениеПоля = Неопределено;
		Если УдаленноеХранилище.Свойство(ИмяПоля, ЗначениеПоля) Тогда
			ДанныеЛога.Вставить(ИмяПоля, ЗначениеПоля);
		КонецЕсли;
	КонецЦикла;

	УдаленнаяСсылка = Неопределено;
	UUID = "";
	Если УдаленноеХранилище.Свойство("Reference", УдаленнаяСсылка)
		И URC_ПортативныеТипы.ЭтоУдаленнаяСсылка(УдаленнаяСсылка) Тогда
		УдаленнаяСсылка.Свойство("UUID", UUID);
	КонецЕсли;
	ДанныеЛога.Вставить("UUID", UUID);

	Если ТипЗнч(Execution) = Тип("Структура") Тогда
		Для Каждого ИмяПоля Из СтрРазделить("ContentType,BinarySize", ",") Цикл
			ЗначениеПоля = Неопределено;
			Если Execution.Свойство(ИмяПоля, ЗначениеПоля) Тогда
				ДанныеЛога.Вставить(ИмяПоля, ЗначениеПоля);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьТранспортнуюОшибку(ConnectionCode, RequestId, КодОшибки)
	Если КодОшибки <> "CONNECTION_ERROR" И КодОшибки <> "TRANSPORT_TIMEOUT"
		И КодОшибки <> "HTTP_AUTH_ERROR" Тогда
		Возврат;
	КонецЕсли;
	ДанныеЛога = НовыеДанныеЛога("Transport", ConnectionCode, RequestId, "");
	ДанныеЛога.Вставить("Статус", "error");
	ДанныеЛога.Вставить("КодОшибки", КодОшибки);
	URC_Логирование.ЗаписатьОперацию(ДанныеЛога);
КонецПроцедуры

Функция КодОшибкиИзТекста(ТекстОшибки)
	Для Каждого Код Из СтрРазделить(
		"CONNECTION_NOT_FOUND,CONNECTION_DISABLED,CONNECTION_NODE_MISMATCH,REMOTE_CONNECTION_REQUIRED,REMOTE_CONNECTION_MISMATCH,NODE_NOT_FOUND,NODE_DISABLED,SETTINGS_ACCESS_ERROR,CONNECTION_ERROR,TRANSPORT_TIMEOUT,HTTP_AUTH_ERROR,PROTOCOL_MISMATCH,REMOTE_ACCESS_DISABLED,BAD_REQUEST,XDTO_SERIALIZATION_ERROR,XDTO_DESERIALIZATION_ERROR,UNSUPPORTED_PARAMETER_TYPE,REMOTE_REFERENCE_WRONG_NODE,REMOTE_REFERENCE_TYPE_NOT_FOUND,REMOTE_REFERENCE_NOT_FOUND,QUERY_EXECUTION_ERROR,UNSUPPORTED_RESULT_TYPE,ATTRIBUTE_NOT_FOUND,ATTRIBUTE_READ_ERROR,OBJECT_DATA_READ_ERROR,TABULAR_SECTION_NOT_FOUND,TABULAR_ATTRIBUTE_NOT_FOUND,OBJECT_DATA_UNSUPPORTED,FEATURE_NOT_SUPPORTED,REMOTE_OBJECT_INVALID,REMOTE_OBJECT_SERVICE_COLUMN_CONFLICT,REFERENCE_NODE_MISMATCH,OBJECT_NOT_FOUND,OBJECT_TYPE_NOT_SUPPORTED,OBJECT_WRITE_DISABLED,OBJECT_WRITE_FORBIDDEN,ATTRIBUTE_NOT_WRITABLE,TABLE_PART_NOT_FOUND,TABLE_PART_COLUMN_NOT_FOUND,REFERENCE_NODE_INVALID,OBJECT_CONFLICT,WRITE_MODE_NOT_SUPPORTED,OBJECT_VALIDATION_ERROR,OBJECT_WRITE_ERROR,VALUE_STORAGE_INVALID,VALUE_STORAGE_TYPE_MISMATCH,VALUE_STORAGE_READ_ERROR,VALUE_STORAGE_CONTENT_UNSUPPORTED,VALUE_STORAGE_CHANGE_REQUIRED,VALUE_STORAGE_CHANGE_INVALID,VALUE_STORAGE_TARGET_MISMATCH,VALUE_STORAGE_STALE_DESCRIPTOR,VALUE_STORAGE_ROW_ID_INVALID,VALUE_STORAGE_WRITE_NOT_SUPPORTED,INTERNAL_ERROR", ",") Цикл
		Если СтрНайти(ТекстОшибки, Код + "|") > 0 Тогда
			Возврат Код;
		КонецЕсли;
	КонецЦикла;
	Возврат "INTERNAL_ERROR";
КонецФункции

Функция ЗначениеСтруктуры(СтруктураДанных, Имя, ЗначениеПоУмолчанию)
	Значение = Неопределено;
	Если ТипЗнч(СтруктураДанных) = Тип("Структура")
		И СтруктураДанных.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

#КонецОбласти
