Функция ПолучитьЗначениеХранилища(
	УдаленноеХранилище,
	Настройки = Неопределено) Экспорт

	ПроверитьНастройкиВызова(Настройки);
	Если Не ЭтоУдаленноеХранилище(УдаленноеХранилище) Тогда
		ВызватьИсключение "VALUE_STORAGE_INVALID|"
			+ НСтр("ru = 'Параметр должен быть RemoteValueStorage'; en = 'Parameter must be a RemoteValueStorage'");
	КонецЕсли;

	Контекст = ПолучитьКонтекстУдаленногоЗначения(УдаленноеХранилище);
	ConnectionCode = Контекст.ConnectionCode;

	ПроверитьВозможностьУзла(ConnectionCode, "ValueStorageGet", Настройки);
	ТранспортныйЗапрос = Новый Структура;
	ТранспортныйЗапрос.Вставить("Storage", УдаленноеХранилище);
	Ответ = ВыполнитьОбъектныйPOST(
		ConnectionCode,
		URC_Протокол.ПутьПолученияЗначенияХранилища(),
		ТранспортныйЗапрос,
		"ValueStorageGet",
		"ContentType",
		Настройки);

	Возврат URC_ПортативныеТипы.ВосстановитьRemoteBinaryData(Ответ.Data);

