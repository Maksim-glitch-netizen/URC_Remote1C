
#Область ПрограммныйИнтерфейс

Процедура ЗаписатьОперацию(Данные) Экспорт

	Попытка
		Статус = Строка(ЗначениеСтруктуры(Данные, "Статус", "success"));
		Уровень = ?(Статус = "success",
			УровеньЖурналаРегистрации.Информация,
			УровеньЖурналаРегистрации.Ошибка);
		Операция = Строка(ЗначениеСтруктуры(Данные, "Операция", "Operation"));
		КодОшибки = Строка(ЗначениеСтруктуры(Данные, "КодОшибки", ""));
		ИмяСобытия = ИмяСобытияЖурнала(Операция, Статус, КодОшибки);
		Комментарий = "RequestId=" + Строка(ЗначениеСтруктуры(Данные, "RequestId", ""))
			+ "; Direction=" + Строка(ЗначениеСтруктуры(Данные, "Направление", ""))
			+ "; ConnectionCode=" + Строка(ЗначениеСтруктуры(Данные, "ConnectionCode", ""))
			+ "; Node=" + Строка(ЗначениеСтруктуры(Данные, "Узел", ""))
			+ "; User=" + ИмяПользователя()
			+ "; Operation=" + Операция
			+ "; Mode=" + Строка(ЗначениеСтруктуры(Данные, "Режим", ""))
			+ "; QueryMs=" + Строка(ЗначениеСтруктуры(Данные, "QueryMs", 0))
			+ "; AttributesMs=" + Строка(ЗначениеСтруктуры(Данные, "AttributesMs", 0))
			+ "; ReadMs=" + Строка(ЗначениеСтруктуры(Данные, "ReadMs", 0))
			+ "; NormalizeMs=" + Строка(ЗначениеСтруктуры(Данные, "NormalizeMs", 0))
			+ "; XDTOMs=" + Строка(ЗначениеСтруктуры(Данные, "XDTOMs", 0))
			+ "; TotalMs=" + Строка(ЗначениеСтруктуры(Данные, "TotalMs", 0))
			+ "; RowCount=" + Строка(ЗначениеСтруктуры(Данные, "RowCount", 0))
			+ "; AttributeCount=" + Строка(ЗначениеСтруктуры(Данные, "AttributeCount", 0))
			+ "; AttributesCount=" + Строка(ЗначениеСтруктуры(Данные, "AttributesCount", 0))
			+ "; TabularSectionsCount=" + Строка(ЗначениеСтруктуры(Данные, "TabularSectionsCount", 0))
			+ "; TabularRowsCount=" + Строка(ЗначениеСтруктуры(Данные, "TabularRowsCount", 0))
			+ "; Metadata=" + Строка(ЗначениеСтруктуры(Данные, "Metadata", ""))
			+ "; UUID=" + Строка(ЗначениеСтруктуры(Данные, "UUID", ""))
			+ "; Location=" + Строка(ЗначениеСтруктуры(Данные, "Location", ""))
			+ "; Attribute=" + Строка(ЗначениеСтруктуры(Данные, "Attribute", ""))
			+ "; TablePart=" + Строка(ЗначениеСтруктуры(Данные, "TablePart", ""))
			+ "; Column=" + Строка(ЗначениеСтруктуры(Данные, "Column", ""))
			+ "; RowNumber=" + Строка(ЗначениеСтруктуры(Данные, "RowNumber", ""))
			+ "; ContentType=" + Строка(ЗначениеСтруктуры(Данные, "ContentType", ""))
			+ "; BinarySize=" + Строка(ЗначениеСтруктуры(Данные, "BinarySize", 0))
			+ "; IsNew=" + Строка(ЗначениеСтруктуры(Данные, "IsNew", Ложь))
			+ "; WriteMs=" + Строка(ЗначениеСтруктуры(Данные, "WriteMs", 0))
			+ "; ChangedAttributesCount=" + Строка(ЗначениеСтруктуры(Данные, "ChangedAttributesCount", 0))
			+ "; ChangedTablePartsCount=" + Строка(ЗначениеСтруктуры(Данные, "ChangedTablePartsCount", 0))
			+ "; ChangedValueStoragesCount=" + Строка(ЗначениеСтруктуры(Данные, "ChangedValueStoragesCount", 0))
			+ "; ClearedValueStoragesCount=" + Строка(ЗначениеСтруктуры(Данные, "ClearedValueStoragesCount", 0))
			+ "; CopiedValueStoragesCount=" + Строка(ЗначениеСтруктуры(Данные, "CopiedValueStoragesCount", 0))
			+ "; Status=" + Статус
			+ "; ErrorCode=" + КодОшибки;
		// Публичное имя процедуры, без содержимого вызова.
		Если Операция = "ProcedureExecute" Тогда
			Комментарий = Комментарий + "; Procedure=" + Строка(ЗначениеСтруктуры(Данные, "Procedure", ""));
		КонецЕсли;
		ЗаписьЖурналаРегистрации(ИмяСобытия, Уровень, , , Комментарий);
	Исключение
		ЗаписьЖурналаРегистрации(
			"Remote1C.Logging.Error",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначениеСтруктуры(СтруктураДанных, Имя, ЗначениеПоУмолчанию)

	Значение = Неопределено;
	Если ТипЗнч(СтруктураДанных) = Тип("Структура")
		И СтруктураДанных.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция ИмяСобытияЖурнала(Операция, Статус, КодОшибки)

	// Именованные удалённые процедуры по ТЗ v2.
	Если Операция = "ProcedureExecute" Тогда
		Возврат "Remote1C.ProcedureExecute";
	КонецЕсли;

	Если КодОшибки = "REMOTE_ACCESS_DISABLED" Тогда
		Возврат "Remote1C.Security.Denied";
	КонецЕсли;
	Если КодОшибки = "OBJECT_CONFLICT" Тогда
		Возврат "Remote1C.ObjectConflict";
	КонецЕсли;
	Если Операция = "Transport" Тогда
		Возврат "Remote1C.Transport.Error";
	КонецЕсли;
	Суффикс = ?(Статус = "success", "Success", "Error");
	Если Операция = "Query" Тогда
		Возврат "Remote1C.Query." + Суффикс;
	КонецЕсли;
	Если Операция = "GetAttributes" Или Операция = "Attributes" Тогда
		Возврат "Remote1C.Attributes." + Суффикс;
	КонецЕсли;
	Если Операция = "GetObjectData" Тогда
		Возврат "Remote1C.ObjectData." + Суффикс;
	КонецЕсли;
	Если Операция = "ValueStorageGet" Тогда
		Возврат "Remote1C.ValueStorageGet";
	КонецЕсли;
	Возврат "Remote1C." + Операция + "." + Суффикс;

КонецФункции

#КонецОбласти
