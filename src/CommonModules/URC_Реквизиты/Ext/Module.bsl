
#Область ПрограммныйИнтерфейс

Функция Получить(УдаленнаяСсылка, ИменаРеквизитов, КодТекущегоУзла) Экспорт

	НачалоОперации = ТекущаяУниверсальнаяДатаВМиллисекундах();
	НачалоНормализации = 0;
	NormalizeMs = 0;
	ЛокальнаяСсылка = URC_ПортативныеТипы.ВосстановитьRemoteReference(
		УдаленнаяСсылка, КодТекущегоУзла);
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(УдаленнаяСсылка.Metadata);

	ДоступныеРеквизиты = ПолучитьДоступныеРеквизиты(ОбъектМетаданных);
	ЗапрошенныеРеквизиты = РазобратьИменаРеквизитов(ИменаРеквизитов, ДоступныеРеквизиты);

	Попытка
		Объект = ЛокальнаяСсылка.ПолучитьОбъект();
	Исключение
		ВызватьИсключение "ATTRIBUTE_READ_ERROR|Не удалось прочитать объект: " + ОписаниеОшибки();
	КонецПопытки;

	Результат = Новый Структура;
	Результат.Вставить("Ссылка", УдаленнаяСсылка);
	КоличествоРеквизитов = 0;

	Для Каждого ИмяРеквизита Из ЗапрошенныеРеквизиты Цикл
		Если ИмяРеквизита = "Ссылка" Тогда
			Продолжить;
		КонецЕсли;

		Если ЭтоРеквизитХранилищеЗначения(ОбъектМетаданных, ИмяРеквизита) Тогда
			Результат.Вставить(
				ИмяРеквизита,
				URC_ПортативныеТипы.СоздатьRemoteValueStorage(
					УдаленнаяСсылка,
					ИмяРеквизита,
					КодТекущегоУзла,
					ОбъектМетаданных));
			КоличествоРеквизитов = КоличествоРеквизитов + 1;
			Продолжить;
		КонецЕсли;

		Попытка
			ЗначениеРеквизита = Объект[ИмяРеквизита];
		Исключение
			ВызватьИсключение "ATTRIBUTE_READ_ERROR|Ошибка чтения реквизита "
				+ ИмяРеквизита + ": " + ОписаниеОшибки();
		КонецПопытки;

		НачалоНормализации = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Результат.Вставить(
			ИмяРеквизита,
			URC_ПортативныеТипы.НормализоватьЗначение(ЗначениеРеквизита, КодТекущегоУзла));
		NormalizeMs = NormalizeMs
			+ ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоНормализации;
		КоличествоРеквизитов = КоличествоРеквизитов + 1;
	КонецЦикла;

	AttributesMs = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОперации;
	Возврат Новый Структура(
		"Data,AttributeCount,AttributesMs,NormalizeMs",
		Результат,
		КоличествоРеквизитов,
		AttributesMs,
		NormalizeMs);

КонецФункции

Функция ПолучитьЗначениеХранилища(УдаленноеХранилище, КодТекущегоУзла) Экспорт

	Адрес = ПолучитьАдресХранилища(УдаленноеХранилище, КодТекущегоУзла, Истина);
	Хранилище = Адрес.Storage;
	Если ТипЗнч(Хранилище) <> Тип("ХранилищеЗначения") Тогда
		ВызватьИсключение "VALUE_STORAGE_TYPE_MISMATCH|Значение не является ХранилищеЗначения";
	КонецЕсли;

	Попытка
		Содержимое = Хранилище.Получить();
	Исключение
		ВызватьИсключение "VALUE_STORAGE_READ_ERROR|Ошибка получения содержимого: " + ОписаниеОшибки();
	КонецПопытки;

	НормализованноеСодержимое = URC_ПортативныеТипы.НормализоватьСодержимоеХранилища(
		Содержимое, КодТекущегоУзла);
	ContentType = Строка(ТипЗнч(Содержимое));
	BinarySize = 0;
	Если ТипЗнч(Содержимое) = Тип("ДвоичныеДанные") Тогда
		BinarySize = Содержимое.Размер();
	КонецЕсли;
	UUID = "";
	Адрес.Reference.Свойство("UUID", UUID);

	Возврат Новый Структура(
		"Data,Metadata,UUID,Location,Attribute,TablePart,Column,RowNumber,ContentType,BinarySize",
		НормализованноеСодержимое,
		Адрес.Metadata,
		UUID,
		Адрес.Location,
		Адрес.Attribute,
		Адрес.TablePart,
		Адрес.Column,
		Адрес.RowNumber,
		ContentType,
		BinarySize);

КонецФункции

// Проверяет недоверенный дескриптор и возвращает адрес и исходное ХранилищеЗначения без распаковки.
Функция ПолучитьАдресХранилища(УдаленноеХранилище, КодТекущегоУзла, ПроверятьВерсиюДанных = Ложь) Экспорт

	Если Не URC_ПортативныеТипы.ЭтоУдаленноеХранилище(УдаленноеХранилище) Тогда
		ВызватьИсключение "VALUE_STORAGE_INVALID|Ожидается RemoteValueStorage";
	КонецЕсли;

	Node = СтроковоеПолеХранилища(УдаленноеХранилище, "Node", Истина);
	ИмяМетаданных = СтроковоеПолеХранилища(УдаленноеХранилище, "Metadata", Истина);
	УдаленнаяСсылка = Неопределено;
	Если Не УдаленноеХранилище.Свойство("Reference", УдаленнаяСсылка)
		Или Не URC_ПортативныеТипы.ЭтоУдаленнаяСсылка(УдаленнаяСсылка) Тогда
		ВызватьИсключение "VALUE_STORAGE_INVALID|Поврежден Reference в RemoteValueStorage";
	КонецЕсли;
	Если Node <> КодТекущегоУзла Тогда
		ВызватьИсключение "REMOTE_REFERENCE_WRONG_NODE|RemoteValueStorage принадлежит другому узлу";
	КонецЕсли;

	NodeСсылки = СтроковоеПолеХранилища(УдаленнаяСсылка, "Node", Истина);
	МетаданныеСсылки = СтроковоеПолеХранилища(УдаленнаяСсылка, "Metadata", Истина);
	Если NodeСсылки <> Node Или МетаданныеСсылки <> ИмяМетаданных Тогда
		ВызватьИсключение "VALUE_STORAGE_INVALID|RemoteValueStorage не соответствует RemoteReference";
	КонецЕсли;

	ЛокальнаяСсылка = URC_ПортативныеТипы.ВосстановитьRemoteReference(
		УдаленнаяСсылка, КодТекущегоУзла);
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ИмяМетаданных);
	Если ОбъектМетаданных = Неопределено Тогда
		ВызватьИсключение "REMOTE_REFERENCE_TYPE_NOT_FOUND|Не найдены метаданные " + ИмяМетаданных;
	КонецЕсли;
	Попытка
		Объект = ЛокальнаяСсылка.ПолучитьОбъект();
	Исключение
		ВызватьИсключение "VALUE_STORAGE_READ_ERROR|Ошибка чтения объекта: " + ОписаниеОшибки();
	КонецПопытки;

	Расположение = "Attribute";
	УдаленноеХранилище.Свойство("Location", Расположение);
	Если ТипЗнч(Расположение) <> Тип("Строка") Тогда
		ВызватьИсключение "VALUE_STORAGE_INVALID|Некорректное поле Location";
	КонецЕсли;
	Расположение = СокрЛП(Расположение);
	Если ПустаяСтрока(Расположение) Тогда
		Расположение = "Attribute";
	КонецЕсли;

	ИмяРеквизита = "";
	ИмяТЧ = "";
	ИмяКолонки = "";
	НомерСтроки = Неопределено;
	Если Расположение = "Attribute" Тогда
		ИмяРеквизита = СтроковоеПолеХранилища(УдаленноеХранилище, "Attribute", Истина);
		РеквизитМетаданных = ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита);
		Если РеквизитМетаданных = Неопределено Тогда
			ВызватьИсключение "ATTRIBUTE_NOT_FOUND|Реквизит не найден: " + ИмяРеквизита;
		КонецЕсли;
		Если Не РеквизитМетаданных.Тип.СодержитТип(Тип("ХранилищеЗначения")) Тогда
			ВызватьИсключение "VALUE_STORAGE_TYPE_MISMATCH|Реквизит не имеет тип ХранилищеЗначения";
		КонецЕсли;
		Хранилище = Объект[ИмяРеквизита];
	ИначеЕсли Расположение = "TablePart" Тогда
		ИмяТЧ = СтроковоеПолеХранилища(УдаленноеХранилище, "TablePart", Истина);
		ИмяКолонки = СтроковоеПолеХранилища(УдаленноеХранилище, "Column", Истина);
		Если Не УдаленноеХранилище.Свойство("RowNumber", НомерСтроки)
			Или ТипЗнч(НомерСтроки) <> Тип("Число")
			Или НомерСтроки <> Цел(НомерСтроки)
			Или НомерСтроки < 0 Тогда
			ВызватьИсключение "VALUE_STORAGE_INVALID|Некорректный RowNumber";
		КонецЕсли;
		МетаданныеТЧ = ОбъектМетаданных.ТабличныеЧасти.Найти(ИмяТЧ);
		Если МетаданныеТЧ = Неопределено Тогда
			ВызватьИсключение "TABULAR_SECTION_NOT_FOUND|" + ИмяТЧ;
		КонецЕсли;
		РеквизитТЧ = МетаданныеТЧ.Реквизиты.Найти(ИмяКолонки);
		Если РеквизитТЧ = Неопределено Тогда
			ВызватьИсключение "TABULAR_ATTRIBUTE_NOT_FOUND|" + ИмяТЧ + "." + ИмяКолонки;
		КонецЕсли;
		Если Не РеквизитТЧ.Тип.СодержитТип(Тип("ХранилищеЗначения")) Тогда
			ВызватьИсключение "VALUE_STORAGE_TYPE_MISMATCH|Колонка не имеет тип ХранилищеЗначения";
		КонецЕсли;
		ВерсияДанных = СтроковоеПолеХранилища(УдаленноеХранилище, "DataVersion", Истина);
		Если ПроверятьВерсиюДанных И ВерсияДанных <> ВерсияДанныхОбъекта(Объект) Тогда
			ВызватьИсключение "VALUE_STORAGE_STALE_DESCRIPTOR|Объект изменен после формирования дескриптора";
		КонецЕсли;
		Если НомерСтроки >= Объект[ИмяТЧ].Количество() Тогда
			ВызватьИсключение "VALUE_STORAGE_STALE_DESCRIPTOR|Строка табличной части больше не существует";
		КонецЕсли;
		Хранилище = Объект[ИмяТЧ][НомерСтроки][ИмяКолонки];
	Иначе
		ВызватьИсключение "VALUE_STORAGE_INVALID|Неизвестное расположение хранилища";
	КонецЕсли;

	Возврат Новый Структура(
		"Node,Metadata,Reference,Location,Attribute,TablePart,Column,RowNumber,Object,MetadataObject,Storage",
		Node, ИмяМетаданных, УдаленнаяСсылка, Расположение, ИмяРеквизита,
		ИмяТЧ, ИмяКолонки, НомерСтроки, Объект, ОбъектМетаданных, Хранилище);

КонецФункции

Функция ВерсияДанныхОбъекта(Объект) Экспорт

	Попытка
		Возврат Строка(Объект.ВерсияДанных);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтроковоеПолеХранилища(Данные, ИмяПоля, Обязательное)

	ЗначениеПоля = "";
	Если Не Данные.Свойство(ИмяПоля, ЗначениеПоля)
		Или ТипЗнч(ЗначениеПоля) <> Тип("Строка")
		Или (Обязательное И ПустаяСтрока(СокрЛП(ЗначениеПоля))) Тогда
		ВызватьИсключение "VALUE_STORAGE_INVALID|Некорректное поле " + ИмяПоля;
	КонецЕсли;
	Возврат СокрЛП(ЗначениеПоля);

КонецФункции

// Экспортирована для переиспользования в URC_ДанныеОбъекта.
Функция ПолучитьДоступныеРеквизиты(ОбъектМетаданных) Экспорт

	Результат = Новый Соответствие;
	Для Каждого Реквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
		Если Реквизит.Имя <> "ВерсияДанных" Тогда
			Результат.Вставить(Реквизит.Имя, Истина);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
		Результат.Вставить(Реквизит.Имя, Истина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЭтоРеквизитХранилищеЗначения(ОбъектМетаданных, ИмяРеквизита) Экспорт

	РеквизитМетаданных = ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита);
	Возврат РеквизитМетаданных <> Неопределено
		И РеквизитМетаданных.Тип.СодержитТип(Тип("ХранилищеЗначения"));

КонецФункции

// Экспортирована для переиспользования в URC_ДанныеОбъекта.
Функция РазобратьИменаРеквизитов(ИменаРеквизитов, ДоступныеРеквизиты) Экспорт

	Результат = Новый Массив;
	УжеДобавлены = Новый Соответствие;

	Если ИменаРеквизитов = Неопределено Тогда
		Для Каждого Реквизит Из ДоступныеРеквизиты Цикл
			Если Реквизит.Ключ <> "Ссылка" Тогда
				Результат.Добавить(Реквизит.Ключ);
			КонецЕсли;
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(ИменаРеквизитов) = Тип("Строка") Тогда
		ИсходныеИмена = СтрРазделить(ИменаРеквизитов, ",");
	ИначеЕсли ТипЗнч(ИменаРеквизитов) = Тип("Массив")
		Или ТипЗнч(ИменаРеквизитов) = Тип("ФиксированныйМассив") Тогда
		ИсходныеИмена = ИменаРеквизитов;
	Иначе
		ВызватьИсключение "BAD_REQUEST|Attributes должен быть строкой, массивом или Неопределено";
	КонецЕсли;

	Для Каждого ИсходноеИмя Из ИсходныеИмена Цикл
		Если ТипЗнч(ИсходноеИмя) <> Тип("Строка") Тогда
			ВызватьИсключение "BAD_REQUEST|Имя реквизита должно быть строкой";
		КонецЕсли;

		ИмяРеквизита = СокрЛП(ИсходноеИмя);
		Если ПустаяСтрока(ИмяРеквизита)
			Или СтрНайти(ИмяРеквизита, ".") > 0
			Или СтрНайти(ИмяРеквизита, " ") > 0 Тогда
			ВызватьИсключение "ATTRIBUTE_NOT_FOUND|Недопустимое прямое имя реквизита: " + ИмяРеквизита;
		КонецЕсли;

		Если ДоступныеРеквизиты.Получить(ИмяРеквизита) = Неопределено Тогда
			ВызватьИсключение "ATTRIBUTE_NOT_FOUND|Реквизит не найден: " + ИмяРеквизита;
		КонецЕсли;

		Если УжеДобавлены.Получить(ИмяРеквизита) = Неопределено Тогда
			Результат.Добавить(ИмяРеквизита);
			УжеДобавлены.Вставить(ИмяРеквизита, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
